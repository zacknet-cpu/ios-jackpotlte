 {
+	{
+		int a = s->temp_deci < 0 ? -s->temp_deci : s->temp_deci;
+
+		printf("JACKPOTLTE BATTERY: gauge temperature %s%s%d.%d C, charger watchdog kicks %llu (0228c)\n",
