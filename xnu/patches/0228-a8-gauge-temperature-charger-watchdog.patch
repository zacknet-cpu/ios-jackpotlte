diff --git a/bsd/dev/jackpotlte_pmic.c b/bsd/dev/jackpotlte_pmic.c
index 7d66e22..cb630c8 100644
--- a/bsd/dev/jackpotlte_pmic.c
+++ b/bsd/dev/jackpotlte_pmic.c
@@ -454,6 +454,15 @@ jp_read_reg(vm_offset_t i2c, uint8_t addr8, uint8_t reg, uint8_t *buf,
 	return jp_msg(i2c, addr8, true, buf, count);
 }
 
+/* 0228: one register write: the index, then the value, in one message */
+static bool
+jp_write_reg(vm_offset_t i2c, uint8_t addr8, uint8_t reg, uint8_t value)
+{
+	uint8_t b[2] = { reg, value };
+
+	return jp_msg(i2c, addr8, false, b, 2);
+}
+
 static void
 jp_charger(vm_offset_t chg)
 {
@@ -569,8 +578,35 @@ struct jp_sample {
 	bool external;
 	bool charging;
 	bool full;
+	int temp_deci;          /* 0228: gauge temperature, 0.1 C */
+	bool temp_valid;
 };
 
+/*
+ * 0228 (P18, P31).  The fuel gauge's monitor register MONOUT (0x0a) shows its
+ * temperature unless MONOUT_SEL was changed ("monitor register default setting
+ * is temperature", s2mu004_fuelgauge.c s2mu004_get_temperature, which still
+ * writes MONOUT_SEL 0x0c = 0x10 first; here it is only read): signed 16 bits
+ * of 1/256 C.  It is the gauge chip's own temperature (the vendor's battery
+ * NTC is on the AP's ADC), the closest reading this driver has.
+ *
+ * The charger has a watchdog (CHG_CTRL13 0x1d bit 1 EN_WDT, 80 s in CTRL17):
+ * unless WDT_CLR (CHG_CTRL14 0x1e bit 0) is written in time it suspends
+ * charging (STATUS1 fault 3, WD_SUSPEND), which is what every boot showed
+ * minutes after start (11-26: charging +330 mA, then fault 3).  The vendor
+ * kicks it while charging (s2mu004_wdt_clear).  With boot-arg a8chgwdt=1
+ * this poll (every 30 s) writes WDT_CLR while external power is present and
+ * the gauge temperature is known and below 45.0 C; hotter, or unknown, it
+ * stops kicking and the watchdog's own stop stands.  These are the only
+ * PMIC writes; default 0: nothing is written.
+ */
+#define JT_FG_MONOUT_TEMP_OK(d)	((d) >= -200 && (d) <= 800)
+#define JT_CHG_CTRL14		0x1eu	/* WDT_CLR[0] (charger.h:258-260)  */
+#define JT_CHG_WDT_HOT_DECI	450
+static int jp_wdt_mode = -1;
+static uint64_t jp_wdt_kicks, jp_wdt_skipped_hot;
+static bool jp_wdt_said;
+
 /*
  * Decode matches the vendor's own get_charging_status()
  * (drivers/battery_v2/s2mu004_charger.c:721-757) rather than a guessed
@@ -627,6 +663,17 @@ jp_sample_read(struct jp_sample *s)
 		return false;
 	}
 	rsoc_centi = ((raw & 0x7fffu) * 10000u) / (1u << 14);
+	/* 0228: the gauge's temperature (read only) */
+	s->temp_valid = false;
+	if (jp_read_reg(jp_fg, JT_FG_ADDR, JT_FG_MONOUT, b, 2)) {
+		int t = (int)(int16_t)(uint16_t)((unsigned)b[0] | ((unsigned)b[1] << 8));
+
+		t = ((t * 100) >> 8) / 10;
+		if (JT_FG_MONOUT_TEMP_OK(t)) {
+			s->temp_deci = t;
+			s->temp_valid = true;
+		}
+	}
 
 	/* Reject a floating/absent battery or a gauge that has not sampled yet
 	 * instead of publishing 0 % (the donor does the same 2800..4600 mV
@@ -672,6 +719,35 @@ jp_sample_read(struct jp_sample *s)
 		 * whatever CHGIN says; keep full so a finished charge stays full. */
 		s->charging = false;
 	}
+	/* 0228 (P31): keep the charger's watchdog from suspending charging */
+	if (jp_wdt_mode < 0) {
+		int on = 0;
+
+		(void)PE_parse_boot_argn("a8chgwdt", &on, sizeof(on));
+		jp_wdt_mode = on != 0;
+		printf("JACKPOTLTE BATTERY: charger watchdog %s (a8chgwdt=%d)\n",
+		    jp_wdt_mode ? "kicked every poll below 45.0 C (0228)" : "left alone: charging stops when it runs out",
+		    on);
+	}
+	if (jp_wdt_mode && s->external) {
+		if (s->temp_valid && s->temp_deci < JT_CHG_WDT_HOT_DECI) {
+			uint8_t c14 = 0;
+
+			if (jp_read_reg(jp_chg, JT_CHG_ADDR, JT_CHG_CTRL14, &c14, 1) &&
+			    jp_write_reg(jp_chg, JT_CHG_ADDR, JT_CHG_CTRL14, (uint8_t)(c14 | 0x01u))) {
+				jp_wdt_kicks++;
+				if (!jp_wdt_said) {
+					printf("JACKPOTLTE BATTERY: charger watchdog kicked (CTRL14 %#04x), "
+					    "fault %u, gauge %d.%d C\n", (unsigned)c14, fault,
+					    s->temp_deci / 10, (s->temp_deci < 0 ? -s->temp_deci : s->temp_deci) % 10);
+					jp_wdt_said = true;
+				}
+			}
+		} else if (jp_wdt_skipped_hot++ == 0) {
+			printf("JACKPOTLTE BATTERY: charger watchdog not kicked: gauge temperature %s\n",
+			    s->temp_valid ? "45.0 C or more" : "unknown");
+		}
+	}
 	return true;
 }
 
@@ -709,6 +785,9 @@ jp_chgin_name(unsigned chgin)
 static void
 jp_log_sample(const struct jp_sample *s)
 {
+	printf("JACKPOTLTE BATTERY: gauge temperature %s%d.%d C, charger watchdog kicks %llu (0228)\n",
+	    s->temp_valid ? "" : "unknown, last ", s->temp_deci / 10,
+	    (s->temp_deci < 0 ? -s->temp_deci : s->temp_deci) % 10, jp_wdt_kicks);
 	printf("JACKPOTLTE BATTERY: chgin=%u(%s) st0=%#04x st1=%#04x "
 	    "st3=%#04x bat=%u en_chg=%u topoff=%umA vbat=%umV rsoc=%u%% "
 	    "cur=%dmA ext=%d chg=%d full=%d fault=%u\n",
@@ -729,8 +808,25 @@ jp_log_sample(const struct jp_sample *s)
  * never from an interrupt.  A NACK or timeout keeps the previous sample and is
  * logged once; the polled transfer bounds each byte to milliseconds, so a dead
  * bus costs the poll a bounded delay instead of a hang.  Nothing is written to
- * the charger or the gauge.
+ * the charger or the gauge (0228: except the charger's WDT_CLR with a8chgwdt=1).
  */
+int jackpotlte_battery_temperature(int *deci);  /* 0228: SweetBattery */
+
+/* 0228 (P18): the last sample's gauge temperature in 0.1 C; -1 when none */
+int
+jackpotlte_battery_temperature(int *deci)
+{
+	bool ok;
+
+	lck_mtx_lock(&jp_lock);
+	ok = jp_have && jp_last.temp_valid;
+	if (ok) {
+		*deci = jp_last.temp_deci;
+	}
+	lck_mtx_unlock(&jp_lock);
+	return ok ? 0 : -1;
+}
