 static void
 jp_charger(vm_offset_t chg)
 {
@@ -569,7 +578,56 @@ struct jp_sample {
 	bool external;
 	bool charging;
 	bool full;
+	int temp_deci;          /* 0228: gauge temperature, 0.1 C */
+	bool temp_valid;
+};
+
+/*
+ * 0228 (P18, P31).  The fuel gauge's monitor register MONOUT (0x0a) shows its
+ * temperature unless MONOUT_SEL was changed ("monitor register default setting
+ * is temperature", s2mu004_fuelgauge.c s2mu004_get_temperature, which still
+ * writes MONOUT_SEL 0x0c = 0x10 first; here it is only read): signed 16 bits
+ * of 1/256 C.  It is the gauge chip's own temperature (the vendor's battery
+ * NTC is on the AP's ADC), the closest reading this driver has.
+ *
+ * The charger has a watchdog (CHG_CTRL13 0x1d bit 1 EN_WDT, 80 s in CTRL17):
+ * unless WDT_CLR (CHG_CTRL14 0x1e bit 0) is written in time it suspends
+ * charging (STATUS1 fault 3, WD_SUSPEND), which is what every boot showed
+ * minutes after start (11-26: charging +330 mA, then fault 3).  The vendor
+ * kicks it while charging (s2mu004_wdt_clear).  With boot-arg a8chgwdt=1
+ * this poll (every 30 s) writes WDT_CLR while external power is present and
+ * the gauge temperature is known and below 45.0 C; hotter, or unknown, it
+ * stops kicking and the watchdog's own stop stands.  These are the only
+ * PMIC writes; default 0: nothing is written.
+ */
+#define JT_FG_MONOUT_TEMP_OK(d)	((d) >= -200 && (d) <= 800)
+#define JT_FG_MONOUT_SEL	0x0cu	/* what MONOUT shows (fuelgauge.h:41) */
+#define JT_FG_MONOUT_SEL_TEMP	0x10u	/* temperature (fuelgauge.c:646)   */
+#define JT_CHG_CTRL13		0x1du	/* EN_WDT[1] (charger.h:248-256)   */
+#define JT_CHG_EN_WDT		0x02u
+#define JT_CHG_CTRL14		0x1eu	/* WDT_CLR[0] (charger.h:258-260)  */
+#define JT_CHG_CTRL2		0x12u	/* input limit[6:0]*25+50 mA (charger.c:499-511) */
+#define JT_CHG_CTRL9		0x19u	/* fast charge ([6:0]+1)*25 mA (charger.c:546-561) */
+#define JT_CHG_CTRL17		0x21u	/* WDT_TIME[2:0]: 30+10*n s (charger.h:272-351) */
+/* 0228c: kick only from 10.0 to 41.0 C (the vendor stops below 0 C, cuts the
+ * current below 15 C and starts its swelling mode at 41 C); outside that the
+ * watchdog's own stop stands, and it is not undone later (no auto-restart,
+ * so charging cannot cycle around a limit). */
+#define JT_CHG_WDT_HOT_DECI	410
+#define JT_CHG_WDT_COLD_DECI	100
+static int jp_wdt_mode = -1;
+static uint64_t jp_wdt_kicks;
+/* The kick's state, logged on every change (0228b) */
+enum jp_wdt_state {
+	JP_WDT_NONE, JP_WDT_KICKING, JP_WDT_HOT, JP_WDT_NO_TEMP, JP_WDT_OFF,
+	JP_WDT_ODD_BITS, JP_WDT_IO_FAILED, JP_WDT_COLD,
 };
+static int jp_wdt_c14_last = -1;        /* 0228c: CTRL14 as last read while kicking */
+static bool jp_wdt_regs_said;           /* 0228c: CTRL2/9/17 logged once */
+static int jp_wdt_after_said = -1;      /* 0228c: STATUS1 fault after a kick, last logged */
+static enum jp_wdt_state jp_wdt_state = JP_WDT_NONE;
+static int jp_monout_sel = -1;          /* last MONOUT_SEL read, -1 none */
+static int jp_monout_sel_said = -2;
 
 /*
  * Decode matches the vendor's own get_charging_status()
@@ -627,6 +685,34 @@ jp_sample_read(struct jp_sample *s)
 		return false;
 	}
 	rsoc_centi = ((raw & 0x7fffu) * 10000u) / (1u << 14);
+	/* 0228: the gauge's temperature (read only).  0228b: only while
+	 * MONOUT_SEL (0x0c) reads 0x10: the vendor points MONOUT at the average
+	 * current (0x26) or voltage (0x27) for a moment and back at 0x10; left
+	 * at 0x26, a 330 mA charge would read as -5.2 C and pass the 45.0 C
+	 * gate.  MONOUT_SEL is only read here, never written. */
+	s->temp_valid = false;
+	jp_monout_sel = -1;
+	if (jp_read_reg(jp_fg, JT_FG_ADDR, JT_FG_MONOUT_SEL, b, 1)) {
+		jp_monout_sel = b[0];
+	}
+	if (jp_monout_sel != jp_monout_sel_said) {
+		printf("JACKPOTLTE BATTERY: gauge MONOUT_SEL %s%#04x (%s) (0228b)\n",
+		    jp_monout_sel < 0 ? "unread " : "", jp_monout_sel < 0 ? 0u : (unsigned)jp_monout_sel,
+		    jp_monout_sel == (int)JT_FG_MONOUT_SEL_TEMP ? "temperature" : "not the temperature: none read");
+		jp_monout_sel_said = jp_monout_sel;
+	}
+	if (jp_monout_sel == (int)JT_FG_MONOUT_SEL_TEMP &&
+	    jp_read_reg(jp_fg, JT_FG_ADDR, JT_FG_MONOUT, b, 2)) {
+		unsigned raw16 = (unsigned)b[0] | ((unsigned)b[1] << 8);
+		int t = (int)(int16_t)(uint16_t)raw16;
+
+		t = ((t * 100) >> 8) / 10;
+		/* 0228c: all zeros / all ones are a bus or gauge state, not 0 C */
+		if (raw16 != 0x0000u && raw16 != 0xffffu && JT_FG_MONOUT_TEMP_OK(t)) {
+			s->temp_deci = t;
+			s->temp_valid = true;
+		}
+	}
 
 	/* Reject a floating/absent battery or a gauge that has not sampled yet
 	 * instead of publishing 0 % (the donor does the same 2800..4600 mV
@@ -672,6 +758,109 @@ jp_sample_read(struct jp_sample *s)
 		 * whatever CHGIN says; keep full so a finished charge stays full. */
 		s->charging = false;
 	}
+	/* 0228 (P31): keep the charger's watchdog from suspending charging */
+	if (jp_wdt_mode < 0) {
+		int on = 0;
+
+		(void)PE_parse_boot_argn("a8chgwdt", &on, sizeof(on));
+		jp_wdt_mode = on != 0;
+		printf("JACKPOTLTE BATTERY: charger watchdog %s (a8chgwdt=%d)\n",
+		    jp_wdt_mode ? "kicked every poll at 10.0-41.0 C while EN_WDT is set (0228c)" : "left alone: charging stops when it runs out",
+		    on);
+	}
+	if (jp_wdt_mode && s->external) {
+		/* 0228b: as the vendor's s2mu004_wdt_clear, only while EN_WDT
+		 * (CTRL13 bit 1) is set, and only when CTRL14 reads 0x00 or 0x01
+		 * (bit 0 WDT_CLR is its only documented bit): then exactly 0x01 is
+		 * written, so a misread can never put other bits on the chip.
+		 * 0228c: 10.0-41.0 C only; STATUS1 read again after a kick; the
+		 * charger's limits and watchdog time logged once (all reads). */
+		enum jp_wdt_state st;
+		uint8_t c13 = 0, c14 = 0;
+		bool regs = false;
+		int after = -1;
+
+		if (!jp_wdt_regs_said) {
+			uint8_t c2 = 0, c9 = 0, c17 = 0;
+
+			if (jp_read_reg(jp_chg, JT_CHG_ADDR, JT_CHG_CTRL2, &c2, 1) &&
+			    jp_read_reg(jp_chg, JT_CHG_ADDR, JT_CHG_CTRL9, &c9, 1) &&
+			    jp_read_reg(jp_chg, JT_CHG_ADDR, JT_CHG_CTRL17, &c17, 1)) {
+				printf("JACKPOTLTE BATTERY: charger input limit %u mA (CTRL2 %#04x), "
+				    "fast charge %u mA (CTRL9 %#04x), watchdog %u s (CTRL17 %#04x) (0228c)\n",
+				    (unsigned)(c2 & 0x7fu) * 25u + 50u, (unsigned)c2,
+				    ((unsigned)(c9 & 0x7fu) + 1u) * 25u, (unsigned)c9,
+				    30u + 10u * (unsigned)(c17 & 0x7u), (unsigned)c17);
+			}
+			jp_wdt_regs_said = true;
+		}
+		if (!s->temp_valid) {
+			st = JP_WDT_NO_TEMP;
+		} else if (s->temp_deci >= JT_CHG_WDT_HOT_DECI) {
+			st = JP_WDT_HOT;
+		} else if (s->temp_deci < JT_CHG_WDT_COLD_DECI) {
+			st = JP_WDT_COLD;
+		} else if (!jp_read_reg(jp_chg, JT_CHG_ADDR, JT_CHG_CTRL13, &c13, 1) ||
+		    !jp_read_reg(jp_chg, JT_CHG_ADDR, JT_CHG_CTRL14, &c14, 1)) {
+			st = JP_WDT_IO_FAILED;
+		} else {
+			regs = true;
+			if (!(c13 & JT_CHG_EN_WDT)) {
+				st = JP_WDT_OFF;
+			} else if (c14 & 0xfeu) {
+				st = JP_WDT_ODD_BITS;
+			} else if (jp_write_reg(jp_chg, JT_CHG_ADDR, JT_CHG_CTRL14, 0x01u)) {
+				uint8_t a1 = 0;
+
+				st = JP_WDT_KICKING;
+				jp_wdt_kicks++;
+				if ((fault == JT_FAULT_WD_SUSPEND || fault == JT_FAULT_WD_RST) &&
+				    jp_read_reg(jp_chg, JT_CHG_ADDR, JT_CHG_STATUS1, &a1, 1)) {
+					after = (int)JT_CHG_FAULT(a1);
+				}
+			} else {
+				st = JP_WDT_IO_FAILED;
+			}
+		}
+		if (st != jp_wdt_state) {
+			static const char *const what[] = {
+				"none", "kicking (wrote CTRL14 0x01)", "not kicked: gauge 41.0 C or more",
+				"not kicked: gauge temperature unknown", "not kicked: EN_WDT is off",
+				"not kicked: CTRL14 has other bits set", "not kicked: charger read/write failed",
+				"not kicked: gauge below 10.0 C",
+			};
+			int a = s->temp_deci < 0 ? -s->temp_deci : s->temp_deci;
+
+			if (regs) {
+				printf("JACKPOTLTE BATTERY: charger watchdog %s; CTRL13 %#04x CTRL14 %#04x "
+				    "fault %u gauge %s%d.%d C, kicks %llu (0228c)\n", what[st],
+				    (unsigned)c13, (unsigned)c14, fault, s->temp_deci < 0 ? "-" : "",
+				    a / 10, a % 10, jp_wdt_kicks);
+			} else if (s->temp_valid) {
+				printf("JACKPOTLTE BATTERY: charger watchdog %s; fault %u gauge %s%d.%d C, "
+				    "kicks %llu (0228c)\n", what[st], fault, s->temp_deci < 0 ? "-" : "",
+				    a / 10, a % 10, jp_wdt_kicks);
+			} else {
+				printf("JACKPOTLTE BATTERY: charger watchdog %s; fault %u, kicks %llu (0228c)\n",
+				    what[st], fault, jp_wdt_kicks);
+			}
+			jp_wdt_state = st;
+		}
+		if (st == JP_WDT_KICKING && (int)c14 != jp_wdt_c14_last) {
+			/* whether WDT_CLR clears itself: 0x00 on a later kick = yes */
+			if (jp_wdt_c14_last >= 0) {
+				printf("JACKPOTLTE BATTERY: charger CTRL14 read %#04x before kick %llu (was %#04x) (0228c)\n",
+				    (unsigned)c14, jp_wdt_kicks, (unsigned)jp_wdt_c14_last);
+			}
+			jp_wdt_c14_last = c14;
+		}
+		if (after >= 0 && after != jp_wdt_after_said) {
+			/* a watchdog stop already latched: does a kick alone end it? */
+			printf("JACKPOTLTE BATTERY: charger fault %u before the kick, %d after it (0228c)\n",
+			    fault, after);
+			jp_wdt_after_said = after;
+		}
+	}
 	return true;
 }
 
@@ -709,6 +898,13 @@ jp_chgin_name(unsigned chgin)
 static void
