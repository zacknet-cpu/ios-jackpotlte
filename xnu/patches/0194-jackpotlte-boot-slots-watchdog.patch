+#include <kern/debug.h>
+#include <machine/machine_routines.h>
+#include <libkern/libkern.h>
+#include <stdarg.h>
+#include <string.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t kernel_thread_start_priority(thread_continue_t, void *, integer_t,
+    thread_t *);
+int a8_boot_io(uint64_t off, void *buf, uint32_t len, bool write);    /* a5xelte_emmc.c */
+uint64_t a8_boot_size(void);
+
+void a8b_init(void);
+void a8b_slots(void);
+void a8b_put(const char *args);
+void a8b_data(const char *b64);
+void a8b_end(void);
+int a8b_tryb(void);
+void a8b_tryok(void);
+void a8b_promote(void);
+void a8_slots_panic(const char *fmt, va_list *args);
+
+#define A8B_PAGE_PA     0xed3ff000ull
+#define A8B_FLAG        0x000u
+#define A8B_BOOT        0x100u
+#define A8B_STATE       0x200u
+#define A8B_PANIC       0x400u
+#define A8B_PANIC_MAX   (0x1000u - A8B_PANIC - 16u)
+
+#define TRY_MAGIC       0x52543841u     /* "A8TR", loader.c */
+#define BOOT_MAGIC      0x54423841u     /* "A8BT", loader.c */
+#define STATE_MAGIC     0x534b3841u     /* "A8KS" */
+#define PANIC_MAGIC     0x4e503841u     /* "A8PN" */
+
+#define WHY_DEFAULT     0u
+#define WHY_TRY         1u
+#define WHY_TRY_FAILED  2u
+#define WHY_OTHER_GOOD  3u
+
+#define A8B_WDT_PA      0x10060000ull
