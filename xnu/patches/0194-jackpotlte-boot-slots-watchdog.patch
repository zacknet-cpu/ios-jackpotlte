+/*
+ * Read or write whole sectors of the BOOT partition (a8_slots.c). off and len
+ * are bytes from the start of BOOT, both multiples of 512. Writes are allowed
+ * only here, only inside BOOT, and only while this call runs.
+ */
+int a8_boot_io(uint64_t off, void *buf, uint32_t len, bool write);
+uint64_t a8_boot_size(void);
+
+uint64_t
+a8_boot_size(void)
+{
+	return emmc_ready ? emmc_boot_nsectors * 512u : 0;
+}
+
+int
+a8_boot_io(uint64_t off, void *buf, uint32_t len, bool write)
+{
+	uint64_t size = emmc_boot_nsectors * 512u;
+	uint8_t *p = buf;
+	int error = 0;
+
+	if (!emmc_ready || !emmc_boot_nsectors) {
+		return ENXIO;
+	}
+	if ((off & 511u) || (len & 511u) || off > size || len > size - off) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&a5xelte_emmc_lock);
+	emmc_boot_writing = write;
+	for (uint32_t n = 0; n < len && !error;) {
+		uint32_t lba = (uint32_t)(emmc_boot_first_lba + (off + n) / 512u);
+		uint32_t nsect = MIN((len - n) / 512u, EMMC_MULTI_MAX);
+
+		if (nsect >= 2 && (emmc_multi & (write ? EMMC_MULTI_WRITE : EMMC_MULTI_READ)) &&
+		    !emmc_multi_chunk(lba, nsect, p + n, write)) {
+			n += nsect * 512u;
+			continue;
+		}
+		error = write ? emmc_write_sector(lba, p + n) : emmc_read_sector(lba, p + n);
+		n += 512u;
+	}
+	emmc_boot_writing = false;
+	emmc_stats_tick();
+	lck_mtx_unlock(&a5xelte_emmc_lock);
+	return error;
+}
