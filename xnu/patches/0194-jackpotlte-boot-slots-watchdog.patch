+#define WTDAT           0x4u
+#define WTCNT           0x8u
+#define WTCON_ARMED     0xff39u         /* prescaler 256, /128, on, reset on */
+#define WDT_HZ          793u            /* 26 MHz / 256 / 128 */
+#define A8B_PMU_PA      0x11c80000ull
+#define PMU_RST_STAT    0x404u
+#define PMU_DISABLE_WDT 0x408u
+#define PMU_MASK_WDT    0x40cu
+#define PMU_WDT_BIT     (1u << 24)      /* A53 WDTRESET */
+#define RST_MANUAL      0x00010000u     /* a force restart: a person held the keys */
+#define A8B_WDT_PRI     95              /* MAXPRI_KERNEL */
+
+#define SLOT_HDR        4096u
+#define SLOT_REC(i)     (512u * (1u + (uint32_t)(i)))
+#define SLOT_MAX_C      (16u << 20)
+#define SLOT_MAX_U      (64u << 20)
+#define TRIES_PER_HOUR  4u
+#define PROMOTE_UPTIME  120u
+
+struct a8b_rec {
+	uint64_t off, cap, csize, usize;
+	uint32_t codec, crc_c, crc_u, gen;
+	uint8_t  sha[32];
+	char     name[32];
+	uint32_t good, rsv1, rsv2, crc;
+};
+_Static_assert(sizeof(struct a8b_rec) == 128, "slot record is 128 bytes");
+
+struct a8b_state {
+	uint32_t magic, version;
+	uint32_t seq;                   /* last try number */
+	uint32_t pending, pending_slot; /* a try not judged yet */
+	uint32_t fails;                 /* tries in a row that did not come back */
+	uint32_t wdt_row;               /* watchdog resets in a row */
+	uint32_t ntimes;
+	uint32_t times[8];              /* calendar seconds of the last tries */
+	uint32_t check;
+};
+
+static volatile uint8_t *a8b_page;
+static volatile uint32_t *a8b_wdt;
+static uint32_t a8b_wdt_count;
+static int a8b_sleep_chan;
+static uint32_t a8b_boot[12];
+static bool a8b_boot_valid;
+static bool a8b_panicked;
+
+/* ---- small helpers ---- */
+
+static uint32_t
+a8b_crc32(uint32_t crc, const uint8_t *p, size_t n)
+{
+	crc = ~crc;
+	while (n--) {
+		crc ^= *p++;
+		for (int k = 0; k < 8; k++) {
+			crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+		}
+	}
+	return ~crc;
+}
+
+/* SHA-256 (FIPS 180-4). The kernel's own needs the corecrypto kext. */
+struct a8b_sha {
+	uint32_t h[8];
+	uint64_t len;
+	uint8_t  buf[64];
+	uint32_t n;
+};
+
+static const uint32_t a8b_k[64] = {
+	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+};
+
+#define ROR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
+
+static void
+a8b_sha_block(struct a8b_sha *s, const uint8_t *p)
+{
+	uint32_t w[64], a, b, c, d, e, f, g, h;
+
+	for (int i = 0; i < 16; i++) {
+		w[i] = (uint32_t)p[i * 4] << 24 | (uint32_t)p[i * 4 + 1] << 16 |
+		    (uint32_t)p[i * 4 + 2] << 8 | p[i * 4 + 3];
+	}
+	for (int i = 16; i < 64; i++) {
+		uint32_t s0 = ROR(w[i - 15], 7) ^ ROR(w[i - 15], 18) ^ (w[i - 15] >> 3);
+		uint32_t s1 = ROR(w[i - 2], 17) ^ ROR(w[i - 2], 19) ^ (w[i - 2] >> 10);
+		w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+	}
+	a = s->h[0]; b = s->h[1]; c = s->h[2]; d = s->h[3];
+	e = s->h[4]; f = s->h[5]; g = s->h[6]; h = s->h[7];
+	for (int i = 0; i < 64; i++) {
+		uint32_t t1 = h + (ROR(e, 6) ^ ROR(e, 11) ^ ROR(e, 25)) + ((e & f) ^ (~e & g)) +
+		    a8b_k[i] + w[i];
+		uint32_t t2 = (ROR(a, 2) ^ ROR(a, 13) ^ ROR(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
+		h = g; g = f; f = e; e = d + t1;
+		d = c; c = b; b = a; a = t1 + t2;
+	}
+	s->h[0] += a; s->h[1] += b; s->h[2] += c; s->h[3] += d;
+	s->h[4] += e; s->h[5] += f; s->h[6] += g; s->h[7] += h;
+}
+
+static void
+a8b_sha256(const uint8_t *p, size_t n, uint8_t out[32])
+{
+	static const uint32_t iv[8] = {
+		0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+		0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
+	};
+	struct a8b_sha s;
+	uint64_t bits = (uint64_t)n * 8;
+
+	memcpy(s.h, iv, sizeof(iv));
+	for (; n >= 64; n -= 64, p += 64) {
+		a8b_sha_block(&s, p);
+	}
+	memset(s.buf, 0, sizeof(s.buf));
+	memcpy(s.buf, p, n);
+	s.buf[n] = 0x80;
+	if (n >= 56) {
+		a8b_sha_block(&s, s.buf);
+		memset(s.buf, 0, sizeof(s.buf));
+	}
+	for (int i = 0; i < 8; i++) {
+		s.buf[56 + i] = (uint8_t)(bits >> (56 - 8 * i));
+	}
+	a8b_sha_block(&s, s.buf);
+	for (int i = 0; i < 8; i++) {
+		out[i * 4] = (uint8_t)(s.h[i] >> 24);
+		out[i * 4 + 1] = (uint8_t)(s.h[i] >> 16);
+		out[i * 4 + 2] = (uint8_t)(s.h[i] >> 8);
+		out[i * 4 + 3] = (uint8_t)s.h[i];
+	}
+}
+
+static void
+a8b_hex(const uint8_t *p, size_t n, char *out)
+{
+	static const char digits[] = "0123456789abcdef";
+	for (size_t i = 0; i < n; i++) {
+		out[i * 2] = digits[p[i] >> 4];
+		out[i * 2 + 1] = digits[p[i] & 15];
+	}
+	out[n * 2] = 0;
+}
+
+static uint32_t
+a8b_rd(volatile uint32_t *base, uint32_t off)
+{
+	return base[off / 4];
+}
+
+static void
+a8b_wr(volatile uint32_t *base, uint32_t off, uint32_t v)
+{
+	base[off / 4] = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static volatile uint32_t *
+a8b_words(uint32_t off)
+{
+	return (volatile uint32_t *)(a8b_page + off);
+}
+
+static uint32_t
+a8b_xor(volatile uint32_t *w, int n)
+{
+	uint32_t x = 0;
+	for (int i = 0; i < n; i++) {
+		x ^= w[i];
+	}
+	return x ^ 0xffffffffu;
+}
+
+static uint32_t
+a8b_now(void)
+{
+	clock_sec_t secs = 0;
+	clock_usec_t usecs = 0;
+	clock_get_calendar_microtime(&secs, &usecs);
+	return (uint32_t)secs;
+}
+
+static uint64_t
+a8b_uptime(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_SEC;
+}
+
+static void
+a8b_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&a8b_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- state kept across reboots ---- */
+
+static struct a8b_state a8b_st;
+
+static void
+a8b_state_save(void)
+{
+	volatile uint32_t *w = a8b_words(A8B_STATE);
+	const uint32_t *src = (const uint32_t *)&a8b_st;
+	int n = (int)(sizeof(a8b_st) / 4);
+
+	a8b_st.check = 0;
+	for (int i = 0; i < n - 1; i++) {
+		w[i] = src[i];
+	}
+	w[n - 1] = a8b_xor(w, n - 1);
+	a8b_st.check = w[n - 1];
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+a8b_state_load(void)
+{
+	volatile uint32_t *w = a8b_words(A8B_STATE);
+	uint32_t *dst = (uint32_t *)&a8b_st;
+	int n = (int)(sizeof(a8b_st) / 4);
+
+	for (int i = 0; i < n; i++) {
+		dst[i] = w[i];
+	}
+	if (a8b_st.magic != STATE_MAGIC || a8b_st.version != 1 ||
+	    a8b_st.check != a8b_xor(w, n - 1)) {
+		memset(&a8b_st, 0, sizeof(a8b_st));
+		a8b_st.magic = STATE_MAGIC;
+		a8b_st.version = 1;
+		printf("A8 SLOTS: no saved state (cold start); starting fresh\n");
+	}
+}
+
+/* ---- the container in BOOT ---- */
+
+struct a8b_view {
+	uint64_t rd_off, rd_size;
+	struct a8b_rec rec[2];
+	bool ok[2];                     /* record CRC fine and not empty */
+	bool good[2];
+	int def;                        /* -1: none */
+	uint8_t hdr[512];
+};
+
+static const char *
+a8b_load(struct a8b_view *v)
+{
+	uint8_t *sec = kalloc_data(SLOT_HDR, Z_WAITOK | Z_ZERO);
+	const char *why = NULL;
+	uint32_t ksize, rsize, page, w[5], hcrc;
+
+	memset(v, 0, sizeof(*v));
+	v->def = -1;
+	if (sec == NULL) {
+		return "no memory";
+	}
+	if (a8_boot_size() == 0) {
+		why = "BOOT partition not found (eMMC not up?)";
+		goto out;
+	}
+	if (a8_boot_io(0, sec, 512, false) != 0 || memcmp(sec, "ANDROID!", 8) != 0) {
+		why = "BOOT has no Android boot header";
+		goto out;
+	}
+	memcpy(&ksize, sec + 8, 4);
+	memcpy(&rsize, sec + 16, 4);
+	memcpy(&page, sec + 36, 4);
+	if ((page != 2048 && page != 4096) || rsize < SLOT_HDR) {
+		why = "unexpected boot header (page size or ramdisk size)";
+		goto out;
+	}
+	v->rd_off = (uint64_t)page * (1 + ((uint64_t)ksize + page - 1) / page);
+	v->rd_size = rsize;
+	if (v->rd_off + v->rd_size > a8_boot_size()) {
+		why = "ramdisk runs past the end of BOOT";
+		goto out;
+	}
+	if (a8_boot_io(v->rd_off, sec, SLOT_HDR, false) != 0) {
+		why = "BOOT read failed";
+		goto out;
+	}
+	if (memcmp(sec, "SWEETSLT", 8) != 0) {
+		why = "BOOT holds one kernel, not two slots (flash a 0194+ image)";
+		goto out;
+	}
+	memcpy(w, sec + 8, sizeof(w));
+	memcpy(&hcrc, sec + 24, 4);
+	if (w[0] != 2 || w[1] != SLOT_HDR || w[2] != 2 || a8b_crc32(0, sec, 24) != hcrc) {
+		why = "bad container header";
+		goto out;
+	}
+	memcpy(v->hdr, sec, sizeof(v->hdr));
+	for (int i = 0; i < 2; i++) {
+		memcpy(&v->rec[i], sec + SLOT_REC(i), sizeof(v->rec[i]));
+		v->ok[i] = a8b_crc32(0, (const uint8_t *)&v->rec[i], 124) == v->rec[i].crc &&
+		    v->rec[i].csize != 0;
+		v->good[i] = v->ok[i] && v->rec[i].good == 1;
+		if (v->good[i] && (v->def < 0 || v->rec[i].gen > v->rec[v->def].gen)) {
+			v->def = i;
+		}
+	}
+	if (v->def < 0) {
+		why = "no good slot";
+	}
+out:
+	kfree_data(sec, SLOT_HDR);
+	return why;
+}
+
+/* Where slot i lives: both slots have the default's capacity, slot 0 right
+ * after the header and slot 1 after it (mkslots.py). */
+static bool
+a8b_place(const struct a8b_view *v, int i, uint64_t *off, uint64_t *cap)
+{
+	const struct a8b_rec *d = &v->rec[v->def];
+	*cap = d->cap;
+	*off = i == 0 ? SLOT_HDR : SLOT_HDR + d->cap;
+	if (d->off != (v->def == 0 ? SLOT_HDR : SLOT_HDR + d->cap) ||
+	    (d->cap & 4095u) || d->cap == 0 || *off + *cap > v->rd_size) {
+		return false;
+	}
+	if (v->ok[i] && (v->rec[i].off != *off || v->rec[i].cap != *cap)) {
+		return false;
+	}
+	return true;
+}
+
+static void
+a8b_print_rec(const struct a8b_view *v, int i)
+{
+	const struct a8b_rec *r = &v->rec[i];
+	char sha[17], name[33];
+
+	if (!v->ok[i]) {
+		bool zero = true;
+		for (size_t k = 0; k < sizeof(*r); k++) {
+			if (((const uint8_t *)r)[k] != 0) {
+				zero = false;
+			}
+		}
+		printf("A8 SLOTS: slot %d: %s\n", i, zero ? "empty (cleared)" :
+		    r->csize == 0 && a8b_crc32(0, (const uint8_t *)r, 124) == r->crc ?
+		    "empty" : "NO VALID RECORD");
+		return;
+	}
+	a8b_hex(r->sha, 8, sha);
+	memcpy(name, r->name, 32);
+	name[32] = 0;
+	printf("A8 SLOTS: slot %d: \"%s\" %s gen %u, %llu -> %llu bytes, sha256 %s.., "
+	    "crc %08x/%08x%s\n", i, name, r->good == 1 ? "good" : "untested", r->gen,
+	    r->csize, r->usize, sha, r->crc_c, r->crc_u, i == v->def ? " (default)" : "");
+}
+
+static const char *
+a8b_reason(uint32_t why)
+{
+	switch (why) {
+	case WHY_DEFAULT: return "default";
+	case WHY_TRY: return "try once";
+	case WHY_TRY_FAILED: return "try refused by the loader, default instead";
+	case WHY_OTHER_GOOD: return "default refused by the loader, other good slot";
+	default: return "?";
+	}
+}
+
+void
+a8b_slots(void)
+{
+	struct a8b_view v;
+	const char *why = a8b_load(&v);
+
+	if (a8b_boot_valid) {
+		printf("A8 SLOTS: this boot: slot %u (%s), try %u, loader %u ms, reset cause %08x, "
+		    "default %d\n", a8b_boot[2], a8b_reason(a8b_boot[3]), a8b_boot[4], a8b_boot[6],
+		    a8b_boot[5], (int)a8b_boot[7]);
+	} else {
+		printf("A8 SLOTS: this boot: no loader record (single-kernel image)\n");
+	}
+	printf("A8 SLOTS: tries: last %u, pending %u (slot %u), failed in a row %u, "
+	    "watchdog resets in a row %u, watchdog %s\n", a8b_st.seq, a8b_st.pending,
+	    a8b_st.pending_slot, a8b_st.fails, a8b_st.wdt_row,
+	    a8b_wdt_count ? "petted" : "off");
+	if (why != NULL && v.def < 0 && !v.ok[0] && !v.ok[1]) {
+		printf("A8 SLOTS: %s\n", why);
+		return;
+	}
+	a8b_print_rec(&v, 0);
+	a8b_print_rec(&v, 1);
+	if (why != NULL) {
+		printf("A8 SLOTS: %s\n", why);
+	}
+}
+
+/* ---- bput: write the slot that is not the default ---- */
+
+static struct {
+	uint8_t *buf;
+	uint32_t size, alloc, have;
+	uint8_t  sha[32];
+	bool     bad;
+	uint32_t quad;
+	int      quad_bits;
+} a8b_put_st;
+
+static void
+a8b_put_reset(void)
+{
+	if (a8b_put_st.buf != NULL) {
+		kfree_data(a8b_put_st.buf, a8b_put_st.alloc);
+	}
+	memset(&a8b_put_st, 0, sizeof(a8b_put_st));
+}
+
+static int
+a8b_hexval(char c)
+{
+	if (c >= '0' && c <= '9') {
+		return c - '0';
+	}
+	if (c >= 'a' && c <= 'f') {
+		return c - 'a' + 10;
+	}
+	if (c >= 'A' && c <= 'F') {
+		return c - 'A' + 10;
+	}
+	return -1;
+}
+
+void
+a8b_put(const char *args)
+{
+	uint64_t size = 0;
+	int k = 0;
+
+	a8b_put_reset();
+	while (*args == ' ') {
+		args++;
+	}
+	while (*args >= '0' && *args <= '9' && size <= SLOT_MAX_C + 128u) {
+		size = size * 10 + (uint64_t)(*args++ - '0');
+	}
+	while (*args == ' ') {
+		args++;
+	}
+	for (; k < 64 && a8b_hexval(args[k]) >= 0; k++) {
+		if (k & 1) {
+			a8b_put_st.sha[k / 2] |= (uint8_t)a8b_hexval(args[k]);
+		} else {
+			a8b_put_st.sha[k / 2] = (uint8_t)(a8b_hexval(args[k]) << 4);
+		}
+	}
+	if (k != 64 || size <= 128 || size > SLOT_MAX_C + 128u) {
+		printf("A8B PUT error: bput SIZE SHA256 (decimal size of a slot image, "
+		    "128 to %u bytes; 64 hex digits)\n", SLOT_MAX_C + 128u);
+		a8b_put_reset();
+		return;
+	}
+	/* Room to write whole sectors from the payload's start. */
+	a8b_put_st.alloc = (uint32_t)size + 1024u;
+	a8b_put_st.buf = kalloc_data(a8b_put_st.alloc, Z_WAITOK | Z_ZERO);
+	if (a8b_put_st.buf == NULL) {
+		printf("A8B PUT error: no memory for %llu bytes\n", size);
+		a8b_put_reset();
+		return;
+	}
+	a8b_put_st.size = (uint32_t)size;
+	printf("A8B PUT ready %u bytes\n", a8b_put_st.size);
+}
+
+static int
+a8b_b64(char c)
+{
+	if (c >= 'A' && c <= 'Z') {
+		return c - 'A';
+	}
+	if (c >= 'a' && c <= 'z') {
+		return c - 'a' + 26;
+	}
+	if (c >= '0' && c <= '9') {
+		return c - '0' + 52;
+	}
+	return c == '+' ? 62 : c == '/' ? 63 : -1;
+}
+
+void
+a8b_data(const char *b64)
+{
+	if (a8b_put_st.buf == NULL || a8b_put_st.bad) {
+		return;
+	}
+	for (const char *c = b64; *c; c++) {
+		int v;
+		if (*c == ' ' || *c == '=') {
+			continue;
+		}
+		v = a8b_b64(*c);
+		if (v < 0) {
+			a8b_put_st.bad = true;
+			printf("A8B PUT error: not base64 at '%c'\n", *c);
+			return;
+		}
+		a8b_put_st.quad = (a8b_put_st.quad << 6) | (uint32_t)v;
+		a8b_put_st.quad_bits += 6;
+		if (a8b_put_st.quad_bits >= 8) {
+			a8b_put_st.quad_bits -= 8;
+			if (a8b_put_st.have >= a8b_put_st.size) {
+				a8b_put_st.bad = true;
+				printf("A8B PUT error: more than %u bytes\n", a8b_put_st.size);
+				return;
+			}
+			a8b_put_st.buf[a8b_put_st.have++] = (uint8_t)(a8b_put_st.quad >> a8b_put_st.quad_bits);
+			if ((a8b_put_st.have & 0x7ffffu) == 0) {
+				printf("A8B PUT got %u of %u\n", a8b_put_st.have, a8b_put_st.size);
+			}
+		}
+	}
+}
+
+/* Write one record sector and read it back. */
+static int
+a8b_write_rec(const struct a8b_view *v, int i, const struct a8b_rec *r)
+{
+	uint8_t sec[512], back[512];
+	int error;
+
+	memset(sec, 0, sizeof(sec));
+	if (r != NULL) {
+		memcpy(sec, r, sizeof(*r));
+	}
+	error = a8_boot_io(v->rd_off + SLOT_REC(i), sec, 512, true);
+	if (!error) {
+		error = a8_boot_io(v->rd_off + SLOT_REC(i), back, 512, false);
+	}
+	if (!error && memcmp(sec, back, 512) != 0) {
+		error = EIO;
+	}
+	return error;
+}
+
+void
+a8b_end(void)
+{
+	struct a8b_view v;
+	struct a8b_rec r;
+	uint8_t sha[32], *back = NULL;
+	const uint8_t *data;
+	char hex[65];
+	const char *why;
+	uint64_t off = 0, cap = 0, t0 = a8b_uptime();
+	uint32_t csize, span = 0;
+	int error, target;
+
+	if (a8b_put_st.buf == NULL) {
+		printf("A8B PUT error: bend without bput\n");
+		return;
+	}
+	if (a8b_put_st.bad || a8b_put_st.have != a8b_put_st.size) {
+		printf("A8B PUT error: %u of %u bytes arrived%s; nothing written\n",
+		    a8b_put_st.have, a8b_put_st.size, a8b_put_st.bad ? " (bad data)" : "");
+		goto out;
+	}
+	a8b_sha256(a8b_put_st.buf, a8b_put_st.size, sha);
+	if (memcmp(sha, a8b_put_st.sha, 32) != 0) {
+		a8b_hex(sha, 32, hex);
+		printf("A8B PUT error: sha256 %s is not the one given; nothing written\n", hex);
+		goto out;
+	}
+	memcpy(&r, a8b_put_st.buf, sizeof(r));
+	data = a8b_put_st.buf + 128;
+	csize = a8b_put_st.size - 128u;
+	a8b_sha256(data, csize, sha);
+	if (r.csize != csize || r.codec != 1 || r.usize == 0 || r.usize > SLOT_MAX_U ||
+	    a8b_crc32(0, data, csize) != r.crc_c || memcmp(sha, r.sha, 32) != 0) {
+		printf("A8B PUT error: the slot image's record does not match its data; "
+		    "nothing written\n");
+		goto out;
+	}
+	why = a8b_load(&v);
+	if (v.def < 0) {
+		printf("A8B PUT error: %s; nothing written\n", why ? why : "no default slot");
+		goto out;
+	}
+	target = 1 - v.def;
+	if (!a8b_place(&v, target, &off, &cap)) {
+		printf("A8B PUT error: the slot layout is not the one mkslots.py makes; "
+		    "nothing written\n");
+		goto out;
+	}
+	span = (csize + 511u) & ~511u;
+	if (span > cap) {
+		printf("A8B PUT error: %u bytes do not fit slot %d (%llu); nothing written\n",
+		    csize, target, cap);
+		goto out;
+	}
+	printf("A8B PUT writing slot %d (the default is slot %d): %u bytes at BOOT+%llu\n",
+	    target, v.def, csize, v.rd_off + off);
+	/* 1. The old record goes first: a half-written slot is never described. */
+	error = a8b_write_rec(&v, target, NULL);
+	if (error) {
+		printf("A8B PUT error %d clearing slot %d's record; BOOT read-back failed?\n",
+		    error, target);
+		goto out;
+	}
+	/* 2. The data, padded with zeros to whole sectors, then read back. */
+	error = a8_boot_io(v.rd_off + off, a8b_put_st.buf + 128, span, true);
+	if (error) {
+		printf("A8B PUT error %d writing slot %d's data; its record stays empty\n",
+		    error, target);
+		goto out;
+	}
+	back = kalloc_data(span, Z_WAITOK | Z_ZERO);
+	if (back == NULL) {
+		printf("A8B PUT error: no memory to read back; slot %d's record stays empty\n",
+		    target);
+		goto out;
+	}
+	error = a8_boot_io(v.rd_off + off, back, span, false);
+	a8b_sha256(back, csize, sha);
+	if (error || memcmp(back, a8b_put_st.buf + 128, span) != 0 || memcmp(sha, r.sha, 32) != 0) {
+		printf("A8B PUT error: READ-BACK DIFFERS (error %d) for slot %d; its record "
+		    "stays empty. Stop and call the user.\n", error, target);
+		goto out;
+	}
+	/* 3. The record: untested, generation 0, our place in the container. */
+	r.off = off;
+	r.cap = cap;
+	r.gen = 0;
+	r.good = 0;
+	r.rsv1 = r.rsv2 = 0;
+	r.crc = a8b_crc32(0, (const uint8_t *)&r, 124);
+	error = a8b_write_rec(&v, target, &r);
+	if (error) {
+		printf("A8B PUT error: RECORD READ-BACK FAILED (%d) for slot %d. Stop and call "
+		    "the user.\n", error, target);
+		goto out;
+	}
+	a8b_hex(r.sha, 32, hex);
+	printf("A8B PUT ok slot %d %u bytes (payload %llu) sha256 %s in %llu s\n",
+	    target, csize, r.usize, hex, a8b_uptime() - t0);
+out:
+	if (back != NULL) {
+		kfree_data(back, span);
+	}
+	a8b_put_reset();
+}
+
+/* ---- tries ---- */
+
+static bool
+a8b_this_is_try(void)
+{
+	return a8b_boot_valid && a8b_boot[3] == WHY_TRY && a8b_st.pending != 0 &&
+	       a8b_boot[4] == a8b_st.pending;
+}
+
+/* 0: the request is in RAM, reboot now. */
+int
+a8b_tryb(void)
+{
+	struct a8b_view v;
+	const char *why;
+	uint32_t now = a8b_now(), recent = 0;
+	int target;
+
+	if (a8b_page == NULL) {
+		printf("A8B TRY error: the RAM page is not mapped\n");
+		return -1;
+	}
+	if (a8b_st.fails >= 2) {
+		printf("A8B TRY refused: %u tries in a row did not come back. Stop and call "
+		    "the user (a force restart clears this).\n", a8b_st.fails);
+		return -1;
+	}
+	if (a8b_st.pending != 0) {
+		printf("A8B TRY refused: try %u is not judged yet (tryok or promote on its "
+		    "boot)\n", a8b_st.pending);
+		return -1;
+	}
+	if (now < 1767225600u) {        /* 2026-01-01 */
+		printf("A8B TRY refused: the calendar is not set (send date first)\n");
+		return -1;
+	}
+	for (uint32_t i = 0; i < 8 && i < a8b_st.ntimes; i++) {
+		if (a8b_st.times[i] <= now && now - a8b_st.times[i] < 3600u) {
+			recent++;
+		}
+	}
+	if (recent >= TRIES_PER_HOUR) {
+		printf("A8B TRY refused: %u tries in the last hour (limit %u)\n", recent,
+		    TRIES_PER_HOUR);
+		return -1;
+	}
+	why = a8b_load(&v);
+	if (v.def < 0) {
+		printf("A8B TRY refused: %s\n", why ? why : "no default slot");
+		return -1;
+	}
+	target = 1 - v.def;
+	if (!v.ok[target]) {
+		printf("A8B TRY refused: slot %d is empty (bput first)\n", target);
+		return -1;
+	}
+	a8b_st.seq++;
+	a8b_st.pending = a8b_st.seq;
+	a8b_st.pending_slot = (uint32_t)target;
+	a8b_st.times[a8b_st.ntimes % 8] = now;
+	a8b_st.ntimes++;
+	a8b_state_save();
+
+	volatile uint32_t *f = a8b_words(A8B_FLAG);
+	f[0] = TRY_MAGIC;
+	f[1] = 1;
+	f[2] = (uint32_t)target;
+	f[3] = a8b_st.seq;
+	f[4] = f[0] ^ f[1] ^ f[2] ^ f[3] ^ 0xffffffffu;
+	f[5] = f[6] = f[7] = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("A8B TRY %u: slot %d once, then the default (slot %d) again; rebooting\n",
+	    a8b_st.seq, target, v.def);
+	return 0;
+}
+
+void
+a8b_tryok(void)
+{
+	if (!a8b_this_is_try()) {
+		printf("A8B TRYOK refused: this boot is not a try\n");
+		return;
+	}
+	printf("A8B TRYOK: try %u of slot %u came up and passed\n", a8b_st.pending,
+	    a8b_st.pending_slot);
+	a8b_st.pending = 0;
+	a8b_st.fails = 0;
+	a8b_state_save();
+}
+
+void
+a8b_promote(void)
+{
+	struct a8b_view v;
+	struct a8b_rec r;
+	const char *why;
+	uint64_t up = a8b_uptime();
+	int slot;
+
+	if (!a8b_this_is_try()) {
+		printf("A8B PROMOTE refused: only from the try boot itself\n");
+		return;
+	}
+	if (up < PROMOTE_UPTIME) {
+		printf("A8B PROMOTE refused: up %llu s, need %u s\n", up, PROMOTE_UPTIME);
+		return;
+	}
+	slot = (int)a8b_boot[2];
+	why = a8b_load(&v);
+	if (v.def < 0 || slot == v.def || !v.ok[slot]) {
+		printf("A8B PROMOTE refused: %s\n", why ? why : "slot is already the default or empty");
+		return;
+	}
+	r = v.rec[slot];
+	r.good = 1;
+	r.gen = v.rec[v.def].gen + 1;
+	r.crc = a8b_crc32(0, (const uint8_t *)&r, 124);
+	int error = a8b_write_rec(&v, slot, &r);
+	if (error) {
+		printf("A8B PROMOTE error: RECORD READ-BACK FAILED (%d). Stop and call the user.\n",
+		    error);
+		return;
+	}
+	printf("A8B PROMOTE ok: slot %d is the default now (gen %u); slot %d keeps the old "
+	    "kernel until the next bput\n", slot, r.gen, v.def);
+	a8b_st.pending = 0;
+	a8b_st.fails = 0;
+	a8b_state_save();
+}
+
+/* ---- watchdog ---- */
+
+static void
+a8b_wdt_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		a8b_wr(a8b_wdt, WTCNT, a8b_wdt_count);
+		a8b_sleep_ms(5000);
+	}
+}
+
+static void
+a8b_wdt_start(uint32_t secs, bool arm)
+{
+	volatile uint32_t *pmu = (volatile uint32_t *)ml_io_map(A8B_PMU_PA, 0x1000);
+	thread_t th;
+
+	a8b_wdt = (volatile uint32_t *)ml_io_map(A8B_WDT_PA, 0x1000);
+	if (a8b_wdt == NULL || pmu == NULL) {
+		printf("A8 WDT: map failed\n");
+		return;
+	}
+	if (arm) {
+		uint32_t count = secs * WDT_HZ;
+		if (count > 0xffffu) {
+			count = 0xffffu;
+		}
+		a8b_wr(a8b_wdt, WTDAT, count);
+		a8b_wr(a8b_wdt, WTCNT, count);
+		a8b_wr(a8b_wdt, WTCON, WTCON_ARMED);
+		a8b_wr(pmu, PMU_DISABLE_WDT, a8b_rd(pmu, PMU_DISABLE_WDT) & ~PMU_WDT_BIT);
+		a8b_wr(pmu, PMU_MASK_WDT, a8b_rd(pmu, PMU_MASK_WDT) & ~PMU_WDT_BIT);
+	}
+	a8b_wdt_count = a8b_rd(a8b_wdt, WTDAT);
+	printf("A8 WDT: %s, WTCON %08x WTDAT %08x WTCNT %08x (about %u s), PMU disable %08x "
+	    "mask %08x; petted every 5 s\n", arm ? "armed" : "armed by the loader",
+	    a8b_rd(a8b_wdt, WTCON), a8b_wdt_count, a8b_rd(a8b_wdt, WTCNT),
+	    a8b_wdt_count / WDT_HZ, a8b_rd(pmu, PMU_DISABLE_WDT), a8b_rd(pmu, PMU_MASK_WDT));
+	if (kernel_thread_start_priority(a8b_wdt_thread, NULL, A8B_WDT_PRI, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		printf("A8 WDT: no pet thread; disarming\n");
+		a8b_wr(pmu, PMU_MASK_WDT, a8b_rd(pmu, PMU_MASK_WDT) | PMU_WDT_BIT);
+		a8b_wdt_count = 0;
+	}
+}
+
+static void
+a8b_wdt_disarm(void)
+{
+	volatile uint32_t *pmu = (volatile uint32_t *)ml_io_map(A8B_PMU_PA, 0x1000);
+	if (pmu != NULL) {
+		a8b_wr(pmu, PMU_MASK_WDT, a8b_rd(pmu, PMU_MASK_WDT) | PMU_WDT_BIT);
+	}
+}
+
+/* ---- the deliberately broken kernel (a8bootpanic=SECONDS) ---- */
+
+static uint32_t a8b_bootpanic;
+
+static void
+a8b_bootpanic_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	a8b_sleep_ms(a8b_bootpanic * 1000u);
+	panic("a8bootpanic: deliberate test panic %u s after start (Phase 2 fallback test)",
+	    a8b_bootpanic);
+}
+
+/* ---- panic text for the next boot ---- */
+
+static char a8b_panic_buf[A8B_PANIC_MAX];
+
+void
+a8_slots_panic(const char *fmt, va_list *args)
+{
+	va_list copy;
+	int n;
+
+	if (a8b_page == NULL || a8b_panicked) {
+		return;
+	}
+	a8b_panicked = true;
+	va_copy(copy, *args);
+	n = vsnprintf(a8b_panic_buf, sizeof(a8b_panic_buf), fmt, copy);
+	va_end(copy);
+	if (n < 0) {
+		n = 0;
+	}
+	if ((uint32_t)n >= sizeof(a8b_panic_buf)) {
+		n = (int)sizeof(a8b_panic_buf) - 1;
+	}
+	volatile uint32_t *w = a8b_words(A8B_PANIC);
+	volatile uint8_t *t = a8b_page + A8B_PANIC + 16;
+	for (int i = 0; i < n; i++) {
+		t[i] = (uint8_t)a8b_panic_buf[i];
+	}
+	w[1] = (uint32_t)n;
+	w[2] = a8b_st.pending;
+	w[3] = a8b_boot_valid ? a8b_boot[2] : 0xffffffffu;
+	w[0] = PANIC_MAGIC;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+a8b_report_panic(void)
+{
+	volatile uint32_t *w = a8b_words(A8B_PANIC);
+	uint32_t n = w[1];
+	char line[161];
+
+	if (w[0] != PANIC_MAGIC || n == 0 || n > A8B_PANIC_MAX) {
+		return;
+	}
+	printf("A8 SLOTS: last boot panicked (slot %d, try %u):\n", (int)w[3], w[2]);
+	for (uint32_t i = 0; i < n; i += 160) {
+		uint32_t k = 0;
+		for (; k < 160 && i + k < n; k++) {
+			char c = (char)a8b_page[A8B_PANIC + 16 + i + k];
+			line[k] = (c == '\n' || c == '\r' || c == 0) ? ' ' : c;
+		}
+		line[k] = 0;
+		printf("A8 PANIC: %s\n", line);
+	}
+	w[0] = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* ---- boot ---- */
+
+void
+a8b_init(void)
+{
+	uint32_t secs = 0, rst;
+	volatile uint32_t *b;
+	bool loader_armed;
+
+	a8b_page = (volatile uint8_t *)ml_io_map(A8B_PAGE_PA, 0x1000);
+	if (a8b_page == NULL) {
+		printf("A8 SLOTS: cannot map the RAM page\n");
+		return;
+	}
+	b = a8b_words(A8B_BOOT);
+	for (int i = 0; i < 12; i++) {
+		a8b_boot[i] = b[i];
+	}
+	a8b_boot_valid = a8b_boot[0] == BOOT_MAGIC && a8b_boot[1] == 2 &&
+	    a8b_boot[11] == a8b_xor(b, 11);
+	b[0] = 0;               /* a single-kernel boot later must not show it */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (a8b_boot_valid) {
+		rst = a8b_boot[5];
+	} else {
+		volatile uint32_t *pmu = (volatile uint32_t *)ml_io_map(A8B_PMU_PA, 0x1000);
+		rst = pmu != NULL ? a8b_rd(pmu, PMU_RST_STAT) : 0;
+	}
+	a8b_state_load();
+	if (rst & RST_MANUAL) {
+		if (a8b_st.fails || a8b_st.wdt_row) {
+			printf("A8 SLOTS: force restart: try and watchdog limits cleared\n");
+		}
+		a8b_st.fails = 0;
+		a8b_st.wdt_row = 0;
+	}
+	a8b_st.wdt_row = (rst & PMU_WDT_BIT) ? a8b_st.wdt_row + 1 : 0;
+	if (a8b_boot_valid) {
+		printf("A8 SLOTS: booted slot %u (%s), default %d, gen %u, loader decode %u ms, "
+		    "reset cause %08x%s\n", a8b_boot[2], a8b_reason(a8b_boot[3]), (int)a8b_boot[7],
+		    a8b_boot[8], a8b_boot[6], rst, (rst & PMU_WDT_BIT) ? " (WATCHDOG)" : "");
+	} else {
+		printf("A8 SLOTS: single-kernel boot, reset cause %08x%s\n", rst,
+		    (rst & PMU_WDT_BIT) ? " (WATCHDOG)" : "");
+	}
+	if (a8b_st.pending != 0) {
+		if (a8b_this_is_try()) {
+			printf("A8 SLOTS: this is try %u of slot %u; judge it with tryok or promote\n",
+			    a8b_st.pending, a8b_st.pending_slot);
+		} else {
+			a8b_st.fails++;
+			printf("A8 SLOTS: TRY %u OF SLOT %u FAILED: %s (%u in a row)\n",
+			    a8b_st.pending, a8b_st.pending_slot,
+			    a8b_boot_valid && a8b_boot[3] == WHY_TRY_FAILED && a8b_boot[4] == a8b_st.pending ?
+			    "the loader refused it" : "it did not stay up", a8b_st.fails);
+			a8b_st.pending = 0;
+		}
+	}
+	a8b_state_save();
+	a8b_report_panic();
+
+	loader_armed = a8b_boot_valid && a8b_boot[3] == WHY_TRY;
+	secs = a8b_boot_valid ? 60u : 0u;
+	(void)PE_parse_boot_argn("a8wdt", &secs, sizeof(secs));
+	if (a8b_st.wdt_row >= 2) {
+		printf("A8 WDT: %u watchdog resets in a row; not arming (call the user)\n",
+		    a8b_st.wdt_row);
+		if (loader_armed) {
+			a8b_wdt_disarm();
+		}
+	} else if (loader_armed) {
+		a8b_wdt_start(0, false);
+	} else if (secs != 0) {
+		a8b_wdt_start(secs < 10u ? 10u : secs, true);
+	}
+
+	if (PE_parse_boot_argn("a8bootpanic", &a8b_bootpanic, sizeof(a8b_bootpanic)) &&
+	    a8b_bootpanic > 0) {
+		thread_t th;
+		printf("A8 SLOTS: a8bootpanic=%u: this kernel will panic on purpose\n",
+		    a8b_bootpanic);
+		if (kernel_thread_start(a8b_bootpanic_thread, NULL, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+		}
+	}
+}
