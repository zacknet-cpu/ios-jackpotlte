diff --git a/bsd/dev/a8_slots.c b/bsd/dev/a8_slots.c
new file mode 100644
index 0000000..caf6629
--- /dev/null
+++ b/bsd/dev/a8_slots.c
@@ -0,0 +1,1097 @@
+/*
+ * A8 2018: two kernel slots in BOOT (Phase 2), driven from the USB console's
+ * kernel shell (a5xelte_usb.c, a8usbmode=1).
+ *
+ * BOOT holds a "SWEETSLT" container (tools/jackpotlte/mkslots.py) in place of
+ * one kernel payload. The boot shim (shim/jackpotlte/loader.c) boots the good
+ * slot with the highest generation (the default), or the other slot once when
+ * the RAM page below asks for it. This file writes the other slot, asks for
+ * one try of it, and promotes it after the PC has scored the try.
+ *
+ *   slots                     both slots, the default, what booted and why
+ *   bput SIZE SHA256          then  bd BASE64 ... (repeated)  then  bend
+ *       SIZE and SHA256 are of a slot image ("mkslots.py blob"): a 128-byte
+ *       record and the compressed payload. Written only to the slot that is
+ *       NOT the default, read back and compared, then its record is written.
+ *   tryb                      boot the other slot once (reboots now)
+ *   tryok                     on the try boot: the try counts as good
+ *   promote                   on the try boot: make that slot the default
+ *
+ * Limits the PC cannot lift: never the default slot; at most 4 tries in any
+ * hour (calendar time, so "date" must have been set); none after two tries
+ * in a row that did not come back, until a force restart (a person at the
+ * phone); promote only from the try boot itself and after 120 s of uptime.
+ *
+ * RAM page 0xed3ff000 (last page of the 20 MiB framebuffer reservation,
+ * outside XNU RAM; it survives a warm reset):
+ *   +0x000 try request (written here, read and wiped by the loader)
+ *   +0x100 boot record (written by the loader)
+ *   +0x200 this file's state across reboots (tries, failures)
+ *   +0x400 the first panic message of the previous boot
+ *
+ * Watchdog (watchdog@10060000, reset masked by the PMU until armed): the
+ * loader arms it for a try boot (about 80 s); this file pets it every 5 s.
+ * On other two-slot boots it arms it for 60 s (a8wdt=SECONDS to change,
+ * a8wdt=0 for off); a single-kernel image only with a8wdt. A panic stops the
+ * petting, so the phone resets by itself and the loader picks the default.
+ * After two watchdog resets in a row it is not armed again (the panic stays
+ * on the screen for a person to see).
+ */
+#include <pexpert/arm64/board_config.h>
+#include <pexpert/pexpert.h>
+
+#if defined(ARM64_BOARD_CONFIG_A5XELTE) && defined(JACKPOTLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/kalloc.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
