+/*
+ * 0208: console "scsc" (bsd/dev/a5xelte_usb.c), once the boot's own bring-up
+ * (a8wifi=1) has finished:
+ *   scsc               PMU, mailboxes, panic records, driver state
+ *   scsc hold          the vendor's hold (WIFI_RESET_SET = 1, state 0x80)
+ *   scsc start [f] [r] hold, then release again and wait 2 s for
+ *                      MM_START_IND; f = send the ACPM flag first, r = load
+ *                      the firmware image into the MIF again first
+ */
+void a5xelte_scsc_command(const char *args);
+
+void
+a5xelte_scsc_command(const char *args)
+{
+	bool start = false, hold = false, flag = false, reload = false;
+	uint32_t waited;
+
+	while (args != NULL && *args == ' ') {
+		args++;
+	}
+	if (args != NULL && strncmp(args, "start", 5) == 0) {
+		start = true;
+		flag = strchr(args + 5, 'f') != NULL;
+		reload = strchr(args + 5, 'r') != NULL;
+	} else if (args != NULL && strncmp(args, "hold", 4) == 0) {
+		hold = true;
+	}
+	if (!a5scsc.pmu_mapped) {
+		printf("A5XELTE SCSC: not mapped\n");
+		return;
+	}
+	if (!start && !hold) {
+		a5scsc_fail_dump("now");
+		printf("A5XELTE SCSC: transport %d, firmware %s, MM_START_IND %s, poll %s, irq 0x%04x\n",
+		    a5scsc_transport_state, a5scsc.fw_loaded ? "loaded" : "not loaded",
+		    a5scsc.mm_start_seen ? "seen" : "not seen", a5scsc.poll_running ? "running" : "stopped",
+		    a5scsc.mbox_mapped ? a5scsc_irq_get() : 0);
+		return;
+	}
+	if (a5scsc_transport_state != 2 || !a5scsc.fw_loaded || !a5scsc.mbox_mapped) {
+		printf("A5XELTE SCSC: only after the a8wifi=1 bring-up finished (transport %d)\n",
+		    a5scsc_transport_state);
+		return;
+	}
+	(void)a5scsc_pmu_hold();
+	if (hold) {
+		return;
+	}
+	if (reload) {
+		size_t size = 0;
+		int err = a5scsc_read_file(A5SCSC_FW_PATH, (void *)a5scsc.mif,
+		    a5scsc.fw_runtime_len, &size);
+
+		printf("A5XELTE SCSC: firmware image loaded again: error %d, %u bytes\n", err, (unsigned)size);
+		if (err != 0) {
+			return;
+		}
+	}
+	a5scsc_mbox_init(a5scsc.fw_entry, a5scsc.mxconf_ref);
+	a5scsc.mm_start_seen = false;
+	a5scsc_mb();
+	(void)a5scsc_pmu_release(flag);
+	for (waited = 0; waited < A5SCSC_MXMAN_START_TIMEOUT_MS && !a5scsc.mm_start_seen; waited += 10) {
+		a5scsc_sleep_ms(10);
+	}
+	if (a5scsc.mm_start_seen) {
+		printf("A5XELTE SCSC: restart: MM_START_IND after %u ms, RF 0x%04x\n", waited, a5scsc.rf_hw_ver);
+	} else {
+		printf("A5XELTE SCSC: restart: no MM_START_IND in %u ms\n", waited);
+		a5scsc_fail_dump("restart");
+	}
+}
