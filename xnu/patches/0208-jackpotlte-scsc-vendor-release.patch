+		printf("A5XELTE SCSC: %s: R4 ISSR0-3 0x%08x 0x%08x 0x%08x 0x%08x INTMSR0 0x%08x; "
+		    "M4 ISSR0-3 0x%08x 0x%08x 0x%08x 0x%08x\n", when,
+		    a5scsc_rd(r, A5SCSC_ISSR(0)), a5scsc_rd(r, A5SCSC_ISSR(1)),
+		    a5scsc_rd(r, A5SCSC_ISSR(2)), a5scsc_rd(r, A5SCSC_ISSR(3)),
+		    a5scsc_rd(r, A5SCSC_INTMSR0),
+		    a5scsc_rd(m, A5SCSC_ISSR(0)), a5scsc_rd(m, A5SCSC_ISSR(1)),
+		    a5scsc_rd(m, A5SCSC_ISSR(2)), a5scsc_rd(m, A5SCSC_ISSR(3)));
+	}
+	if (a5scsc.mif_mapped && a5scsc.fw_loaded) {
+		uint32_t r4p = a5scsc_mif_rd32(176), m4p = a5scsc_mif_rd32(180);
+		bool r4ok = r4p <= A5SCSC_MIF_DRAM_SIZE - 16, m4ok = m4p <= A5SCSC_MIF_DRAM_SIZE - 8;
+
+		printf("A5XELTE SCSC: %s: panic records R4 at 0x%x: 0x%08x 0x%08x 0x%08x 0x%08x, "
+		    "M4 at 0x%x: 0x%08x 0x%08x\n", when, r4p,
+		    r4ok ? a5scsc_mif_rd32(r4p) : 0, r4ok ? a5scsc_mif_rd32(r4p + 4) : 0,
+		    r4ok ? a5scsc_mif_rd32(r4p + 8) : 0, r4ok ? a5scsc_mif_rd32(r4p + 12) : 0, m4p,
+		    m4ok ? a5scsc_mif_rd32(m4p) : 0, m4ok ? a5scsc_mif_rd32(m4p + 4) : 0);
+	}
+}
