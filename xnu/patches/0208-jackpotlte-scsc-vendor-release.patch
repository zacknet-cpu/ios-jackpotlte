+/*
+ * 0208: one raw command for another driver (a5xelte_scsc.c sends the vendor's
+ * acpm_dvfs SET_FLAG before the WLBT reset release).  cmd comes back as the
+ * answer.  Needs a8dvfs=1 like the console's "acpm send".
+ */
+int a8_acpm_send(uint32_t channel, uint32_t cmd[4]);
+
+int
+a8_acpm_send(uint32_t channel, uint32_t cmd[4])
+{
+	int error;
+
+	lck_mtx_lock(&a8a_lock);
+	if (!a8a_init()) {
+		error = ENXIO;
+	} else if (a8a.allow == 0) {
+		error = ENOTSUP;
+	} else {
+		error = a8a_ipc(channel, cmd);
+	}
+	lck_mtx_unlock(&a8a_lock);
+	return error;
+}
