+ * ... to ensure BUCK2 gets the right voltage" (platform_mif.c:579-584).
+ * Boot-arg a8wififlag=0 leaves it out; console "scsc start f" sends it.
+ */
+extern int a8_acpm_send(uint32_t channel, uint32_t cmd[4]);    /* a8_acpm.c, 0208 */
+#define A5SCSC_ACPM_DVFS_CHANNEL        5u
