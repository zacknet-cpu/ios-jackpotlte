+	printf("A5XELTE SCSC: ACPM SET_FLAG (channel %u): %s %d, 0x%08x 0x%08x 0x%08x 0x%08x\n",
+	    A5SCSC_ACPM_DVFS_CHANNEL, err ? "error" : "answered", err, cmd[0], cmd[1], cmd[2], cmd[3]);
+}
