+/* 0208: the PMU's view, one line (vendor bits: mif_reg_S5E7885.h:46-131). */
+static void
+a5scsc_pmu_snapshot(const char *when)
+{
+	uint32_t cs = a5scsc_rd(a5scsc.pmu, A5SCSC_CENTRAL_SEQ_WIFI_STATUS);
+
+	printf("A5XELTE SCSC: %s: CTRL_NS 0x%08x CTRL_S 0x%08x STAT 0x%08x seq cfg 0x%08x state 0x%02x\n",
+	    when, a5scsc_rd(a5scsc.pmu, A5SCSC_WIFI_CTRL_NS),
+	    a5scsc_rd(a5scsc.pmu, A5SCSC_WIFI_CTRL_S),
+	    a5scsc_rd(a5scsc.pmu, A5SCSC_WIFI_STAT),
+	    a5scsc_rd(a5scsc.pmu, A5SCSC_CENTRAL_SEQ_WIFI_CONFIGURATION),
+	    (cs & A5SCSC_CENTRAL_SEQ_STATES) >> 16);
+}
