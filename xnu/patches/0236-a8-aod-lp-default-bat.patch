+/*
+ * 0235 (P14 AOD): a flip while DECON's trigger is masked for the dim lock
+ * screen (0233 aodstop) would never reach the panel -- with the live dim
+ * lock screen (GL shim glca31b) CoreAnimation draws each new minute.  The
+ * flip arms the trigger, and 50 ms later (three TE periods; the update has
+ * gone by then, or it waits another 50 ms) it is masked again while the
+ * screen is still dim.
+ */
+static uint32_t a8_decon_trigger(bool on);
+static thread_call_t a8_remask_call;
+static uint32_t a8_aod_frames_let;
+
+static void
+a8_remask(thread_call_param_t p0, thread_call_param_t p1)
+{
+#pragma unused(p0, p1)
+	bool again = false;
+
+	if (a8_scan_lock == NULL) {
+		return;
+	}
+	IOSimpleLockLock(a8_scan_lock);
+	if (sweet_fb_aod_stopped) {
+		if (a8_scan_pending()) {
+			again = true;
+		} else {
+			(void)a8_decon_trigger(false);
+		}
+	}
+	IOSimpleLockUnlock(a8_scan_lock);
+	if (again) {
+		uint64_t deadline;
+
+		clock_interval_to_deadline(50, kMillisecondScale, &deadline);
+		thread_call_enter_delayed(a8_remask_call, deadline);
+	}
+}
+
+static void
+a8_aod_let_frame(void)
+{
+	uint64_t deadline;
+
+	if (a8_remask_call == NULL) {
+		return;
+	}
+	(void)a8_decon_trigger(true);
+	a8_aod_frames_let++;
+	clock_interval_to_deadline(50, kMillisecondScale, &deadline);
+	thread_call_enter_delayed(a8_remask_call, deadline);
+}
+
