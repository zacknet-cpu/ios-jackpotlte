diff --git a/bsd/dev/a8_files.c b/bsd/dev/a8_files.c
new file mode 100644
index 0000000..7f8bc72
--- /dev/null
+++ b/bsd/dev/a8_files.c
@@ -0,0 +1,557 @@
+/*
+ * A8 2018: files and the clock from the USB console's kernel shell
+ * (a5xelte_usb.c, a8usbmode=1), so a setting on the iOS data volume can be
+ * read and changed while iOS runs, with no image to rebuild or flash.
+ *
+ *   fget PATH [OFFSET [LENGTH]]   the file as base64 lines, at most 512 KiB:
+ *       A8F GET PATH size S off O len N crc C
+ *       A8F: <base64 of 57 bytes>          (repeated)
+ *       A8F END PATH
+ *   fput PATH SIZE CRC32 [MODE UID GID]   then  fd BASE64 ... (repeated)  then  fend
+ *       Writes PATH.a8new, gives it the old file's mode and owner (or the
+ *       ones given), syncs it and renames it over PATH, so nothing ever reads
+ *       a half-written file.  Only under /private/var/ (the data volume);
+ *       the system's own files are not touched.
+ *   fls DIR                        names, types and sizes
+ *   date [SECONDS]                 the calendar, or set it (seconds since 1970, UTC)
+ *
+ * The CRC is the zlib/PNG CRC-32 of the whole file.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_A5XELTE) && defined(JACKPOTLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/stat.h>
+#include <sys/proc.h>
+#include <sys/mount.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/dirent.h>
+#include <sys/uio.h>
+#include <sys/kauth.h>
+#include <kern/kalloc.h>
+#include <kern/clock.h>
+#include <string.h>
+
+int a8_kernel_rename(const char *from, const char *to);         /* vfs_syscalls.c */
+void a8f_get(const char *args);
+void a8f_put(const char *args);
+void a8f_data(const char *b64);
+void a8f_end(void);
+void a8f_ls(const char *args);
+void a8f_date(const char *args);
+
+#define A8F_MAX_GET     (512u << 10)
+#define A8F_MAX_PUT     (1024u << 10)
+#define A8F_PATH        512u
+
+static const char a8f_b64[] =
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static uint32_t
+a8f_crc32(uint32_t crc, const uint8_t *p, size_t n)
+{
+	crc = ~crc;
+	while (n--) {
+		crc ^= *p++;
+		for (int k = 0; k < 8; k++) {
+			crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+		}
+	}
+	return ~crc;
+}
+
+static int
+a8f_b64_value(char c)
+{
+	if (c >= 'A' && c <= 'Z') {
+		return c - 'A';
+	}
+	if (c >= 'a' && c <= 'z') {
+		return c - 'a' + 26;
+	}
+	if (c >= '0' && c <= '9') {
+		return c - '0' + 52;
+	}
+	if (c == '+') {
+		return 62;
+	}
+	if (c == '/') {
+		return 63;
+	}
+	return -1;
+}
+
+/* Whether s contains sub (the kernel has no strstr). */
+static bool
+a8f_has(const char *s, const char *sub)
+{
+	size_t n = strlen(sub);
+
+	for (; *s; s++) {
+		if (strncmp(s, sub, n) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Next space-separated word of *p into out (bounded); false when none. */
+static bool
+a8f_word(const char **p, char *out, size_t size)
+{
+	size_t n = 0;
+
+	while (**p == ' ') {
+		(*p)++;
+	}
+	while (**p != 0 && **p != ' ') {
+		if (n + 1 < size) {
+			out[n++] = **p;
+		}
+		(*p)++;
+	}
+	out[n] = 0;
+	return n > 0;
+}
+
+static bool
+a8f_number(const char **p, int base, uint64_t *value)
+{
+	char word[24];
+	uint64_t v = 0;
+
+	if (!a8f_word(p, word, sizeof(word))) {
+		return false;
+	}
+	for (const char *c = word; *c; c++) {
+		int d;
+		if (*c >= '0' && *c <= '9') {
+			d = *c - '0';
+		} else if (base == 16 && *c >= 'a' && *c <= 'f') {
+			d = *c - 'a' + 10;
+		} else if (base == 16 && *c >= 'A' && *c <= 'F') {
+			d = *c - 'A' + 10;
+		} else {
+			return false;
+		}
+		if (d >= base) {
+			return false;
+		}
+		v = v * (uint64_t)base + (uint64_t)d;
+	}
+	*value = v;
+	return true;
+}
+
+void
+a8f_get(const char *args)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	char path[A8F_PATH];
+	uint64_t off = 0, len = 0;
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int error;
+
+	if (!a8f_word(&args, path, sizeof(path)) || path[0] != '/') {
+		printf("A8F GET error: fget PATH [OFFSET [LENGTH]] (absolute path)\n");
+		return;
+	}
+	if (*args && !a8f_number(&args, 10, &off)) {
+		printf("A8F GET error: bad offset\n");
+		return;
+	}
+	if (*args && !a8f_number(&args, 10, &len)) {
+		printf("A8F GET error: bad length\n");
+		return;
+	}
+	error = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (error) {
+		printf("A8F GET error %d %s\n", error, path);
+		return;
+	}
+	if (vnode_vtype(vp) != VREG) {
+		vnode_close(vp, FREAD, ctx);
+		printf("A8F GET error: %s is not a file\n", path);
+		return;
+	}
+	(void)vnode_size(vp, &size, ctx);
+	if (off > (uint64_t)size) {
+		off = (uint64_t)size;
+	}
+	if (len == 0 || len > (uint64_t)size - off) {
+		len = (uint64_t)size - off;
+	}
+	if (len > A8F_MAX_GET) {
+		len = A8F_MAX_GET;
+	}
+	uint8_t *buf = len ? kalloc_data((vm_size_t)len, Z_WAITOK) : NULL;
+	if (len && buf == NULL) {
+		vnode_close(vp, FREAD, ctx);
+		printf("A8F GET error: no memory for %llu bytes\n", len);
+		return;
+	}
+	int resid = 0;
+	if (len) {
+		error = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)len, (off_t)off, UIO_SYSSPACE, 0,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	}
+	vnode_close(vp, FREAD, ctx);
+	if (error) {
+		printf("A8F GET error %d reading %s\n", error, path);
+		kfree_data(buf, (vm_size_t)len);
+		return;
+	}
+	uint64_t got = len - (uint64_t)resid;
+	printf("A8F GET %s size %lld off %llu len %llu crc %08x\n", path, (long long)size, off, got,
+	    a8f_crc32(0, buf, (size_t)got));
+	for (uint64_t at = 0; at < got; at += 57) {
+		char out[4 + 76 + 1];
+		size_t o = 0;
+		uint64_t n = got - at < 57 ? got - at : 57;
+
+		for (uint64_t i = 0; i < n; i += 3) {
+			uint32_t v = (uint32_t)buf[at + i] << 16;
+			if (i + 1 < n) {
+				v |= (uint32_t)buf[at + i + 1] << 8;
+			}
+			if (i + 2 < n) {
+				v |= buf[at + i + 2];
+			}
+			out[o++] = a8f_b64[(v >> 18) & 63];
+			out[o++] = a8f_b64[(v >> 12) & 63];
+			out[o++] = i + 1 < n ? a8f_b64[(v >> 6) & 63] : '=';
+			out[o++] = i + 2 < n ? a8f_b64[v & 63] : '=';
+		}
+		out[o] = 0;
+		printf("A8F: %s\n", out);
+	}
+	printf("A8F END %s\n", path);
+	if (buf != NULL) {
+		kfree_data(buf, (vm_size_t)len);
+	}
+}
+
+/* The file being put, between fput and fend. */
+static struct {
+	char     path[A8F_PATH];
+	uint8_t *buf;
+	uint32_t size, have, crc, mode, uid, gid;
+	bool     owner;                 /* mode, uid and gid were given */
+	bool     bad;
+	uint32_t quad;                  /* base64 bits not yet a whole byte */
+	int      quad_bits;
+} a8f_put_state;
+
+static void
+a8f_put_reset(void)
+{
+	if (a8f_put_state.buf != NULL) {
+		kfree_data(a8f_put_state.buf, a8f_put_state.size ? a8f_put_state.size : 1);
+	}
+	bzero(&a8f_put_state, sizeof(a8f_put_state));
+}
+
+void
+a8f_put(const char *args)
+{
+	uint64_t size = 0, crc = 0, mode = 0, uid = 0, gid = 0;
+
+	a8f_put_reset();
+	if (!a8f_word(&args, a8f_put_state.path, sizeof(a8f_put_state.path)) ||
+	    !a8f_number(&args, 10, &size) || !a8f_number(&args, 16, &crc) || crc > 0xffffffffull) {
+		printf("A8F PUT error: fput PATH SIZE CRC32 [MODE UID GID]\n");
+		a8f_put_reset();
+		return;
+	}
+	if (*args) {
+		if (!a8f_number(&args, 8, &mode) || !a8f_number(&args, 10, &uid) ||
+		    !a8f_number(&args, 10, &gid) || mode > 07777) {
+			printf("A8F PUT error: MODE is octal, UID and GID decimal\n");
+			a8f_put_reset();
+			return;
+		}
+		a8f_put_state.owner = true;
+	}
+	/* The data volume only, and no way out of it. */
+	if (strncmp(a8f_put_state.path, "/private/var/", 13) != 0 ||
+	    a8f_has(a8f_put_state.path, "/../") || a8f_has(a8f_put_state.path, "/./")) {
+		printf("A8F PUT error: only files under /private/var/ (no . or ..): %s\n",
+		    a8f_put_state.path);
+		a8f_put_reset();
+		return;
+	}
+	if (size > A8F_MAX_PUT) {
+		printf("A8F PUT error: %llu bytes is more than %u\n", size, A8F_MAX_PUT);
+		a8f_put_reset();
+		return;
+	}
+	a8f_put_state.buf = kalloc_data(size ? (vm_size_t)size : 1, Z_WAITOK | Z_ZERO);
+	if (a8f_put_state.buf == NULL) {
+		printf("A8F PUT error: no memory for %llu bytes\n", size);
+		a8f_put_reset();
+		return;
+	}
+	a8f_put_state.size = (uint32_t)size;
+	a8f_put_state.crc = (uint32_t)crc;
+	a8f_put_state.mode = (uint32_t)mode;
+	a8f_put_state.uid = (uint32_t)uid;
+	a8f_put_state.gid = (uint32_t)gid;
+	printf("A8F PUT ready %s %u bytes\n", a8f_put_state.path, a8f_put_state.size);
+}
+
+void
+a8f_data(const char *b64)
+{
+	if (a8f_put_state.buf == NULL || a8f_put_state.bad) {
+		return;
+	}
+	for (const char *c = b64; *c; c++) {
+		int v;
+		if (*c == ' ' || *c == '=') {
+			continue;
+		}
+		v = a8f_b64_value(*c);
+		if (v < 0) {
+			a8f_put_state.bad = true;
+			printf("A8F PUT error: not base64 at '%c'\n", *c);
+			return;
+		}
+		a8f_put_state.quad = (a8f_put_state.quad << 6) | (uint32_t)v;
+		a8f_put_state.quad_bits += 6;
+		if (a8f_put_state.quad_bits >= 8) {
+			a8f_put_state.quad_bits -= 8;
+			if (a8f_put_state.have >= a8f_put_state.size) {
+				a8f_put_state.bad = true;
+				printf("A8F PUT error: more than %u bytes\n", a8f_put_state.size);
+				return;
+			}
+			a8f_put_state.buf[a8f_put_state.have++] =
+			    (uint8_t)(a8f_put_state.quad >> a8f_put_state.quad_bits);
+		}
+	}
+}
+
+/* Write path from buf: beside it first, then renamed over it. */
+static int
+a8f_write(const char *path, const uint8_t *buf, uint32_t size, bool owner, uint32_t mode,
+    uint32_t uid, uint32_t gid, const char **step)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	char temp[A8F_PATH + 8];
+	struct vnode_attr va;
+	vnode_t vp = NULLVP;
+	int error;
+
+	snprintf(temp, sizeof(temp), "%s.a8new", path);
+	/* The old file's mode and owner, unless they were given. */
+	*step = "stat";
+	if (!owner) {
+		mode = 0644;
+		uid = 0;
+		gid = 0;
+		if (vnode_lookup(path, 0, &vp, ctx) == 0) {
+			VATTR_INIT(&va);
+			VATTR_WANTED(&va, va_mode);
+			VATTR_WANTED(&va, va_uid);
+			VATTR_WANTED(&va, va_gid);
+			if (vnode_getattr(vp, &va, ctx) == 0) {
+				if (VATTR_IS_SUPPORTED(&va, va_mode)) {
+					mode = va.va_mode & ALLPERMS;
+				}
+				if (VATTR_IS_SUPPORTED(&va, va_uid)) {
+					uid = va.va_uid;
+				}
+				if (VATTR_IS_SUPPORTED(&va, va_gid)) {
+					gid = va.va_gid;
+				}
+			}
+			vnode_put(vp);
+			vp = NULLVP;
+		}
+	}
+	*step = "open";
+	error = vnode_open(temp, FWRITE | O_CREAT, (int)(mode & ALLPERMS), 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	/* vnode_open leaves O_TRUNC to its callers (wardevsa 0244): a stale
+	 * .a8new would keep its old tail. */
+	*step = "truncate";
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_data_size, 0);
+	error = vnode_setattr(vp, &va, ctx);
+	if (!error && size) {
+		int resid = 0;
+		*step = "write";
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)buf, (int)size, 0, UIO_SYSSPACE,
+		    IO_UNIT, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!error && resid) {
+			error = EIO;
+		}
+	}
+	if (!error) {
+		*step = "chown";
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_mode, (mode_t)(mode & ALLPERMS));
+		VATTR_SET(&va, va_uid, (uid_t)uid);
+		VATTR_SET(&va, va_gid, (gid_t)gid);
+		error = vnode_setattr(vp, &va, ctx);
+	}
+	if (!error) {
+		*step = "fsync";
+		error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	vnode_close(vp, FWRITE, ctx);
+	if (!error) {
+		*step = "rename";
+		error = a8_kernel_rename(temp, path);
+	}
+	return error;
+}
+
+void
+a8f_end(void)
+{
+	const char *step = "";
+	int error;
+
+	if (a8f_put_state.buf == NULL) {
+		printf("A8F PUT error: fend without fput\n");
+		return;
+	}
+	if (a8f_put_state.bad || a8f_put_state.have != a8f_put_state.size) {
+		printf("A8F PUT error: %u of %u bytes arrived%s; nothing written\n",
+		    a8f_put_state.have, a8f_put_state.size, a8f_put_state.bad ? " (bad data)" : "");
+		a8f_put_reset();
+		return;
+	}
+	uint32_t crc = a8f_crc32(0, a8f_put_state.buf, a8f_put_state.size);
+	if (crc != a8f_put_state.crc) {
+		printf("A8F PUT error: crc %08x, not %08x; nothing written\n", crc, a8f_put_state.crc);
+		a8f_put_reset();
+		return;
+	}
+	error = a8f_write(a8f_put_state.path, a8f_put_state.buf, a8f_put_state.size,
+	    a8f_put_state.owner, a8f_put_state.mode, a8f_put_state.uid, a8f_put_state.gid, &step);
+	if (error) {
+		printf("A8F PUT error %d at %s: %s\n", error, step, a8f_put_state.path);
+	} else {
+		printf("A8F PUT ok %s %u bytes crc %08x\n", a8f_put_state.path, a8f_put_state.size, crc);
+	}
+	a8f_put_reset();
+}
+
+void
+a8f_ls(const char *args)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	char path[A8F_PATH];
+	vnode_t vp = NULLVP;
+	int error, eof = 0, numdirent = 0, shown = 0;
+	off_t offset = 0;
+	const size_t bufsize = 8192;
+	char *buf;
+
+	if (!a8f_word(&args, path, sizeof(path)) || path[0] != '/') {
+		printf("A8F LS error: fls DIR (absolute path)\n");
+		return;
+	}
+	error = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (error) {
+		printf("A8F LS error %d %s\n", error, path);
+		return;
+	}
+	if (vnode_vtype(vp) != VDIR) {
+		vnode_close(vp, FREAD, ctx);
+		printf("A8F LS error: %s is not a directory\n", path);
+		return;
+	}
+	buf = kalloc_data(bufsize, Z_WAITOK);
+	if (buf == NULL) {
+		vnode_close(vp, FREAD, ctx);
+		return;
+	}
+	printf("A8F LS %s\n", path);
+	while (!eof && shown < 2000) {
+		uio_t uio = uio_create(1, offset, UIO_SYSSPACE, UIO_READ);
+		if (uio == NULL) {
+			break;
+		}
+		uio_addiov(uio, CAST_USER_ADDR_T(buf), bufsize);
+		error = VNOP_READDIR(vp, uio, 0, &eof, &numdirent, ctx);
+		size_t got = bufsize - (size_t)uio_resid(uio);
+		offset = uio_offset(uio);
+		uio_free(uio);
+		if (error || got == 0) {
+			break;
+		}
+		for (size_t at = 0; at + __builtin_offsetof(struct dirent, d_name) <= got;) {
+			/* getdirentries()' records (VNOP_READDIR without the extended flag) */
+			const struct dirent *dp = (const struct dirent *)(void *)(buf + at);
+			size_t head = __builtin_offsetof(struct dirent, d_name);
+			uint16_t reclen = dp->d_reclen;
+			uint8_t type = dp->d_type;
+			size_t namlen = dp->d_namlen;
+			char name[256];
+			if ((size_t)reclen <= head || at + reclen > got) {
+				break;
+			}
+			if (namlen > reclen - head) {
+				namlen = reclen - head;
+			}
+			if (namlen > sizeof(name) - 1) {
+				namlen = sizeof(name) - 1;
+			}
+			memcpy(name, dp->d_name, namlen);
+			name[namlen] = 0;
+			at += reclen;
+			if (name[0] == 0 || strcmp(name, ".") == 0 || strcmp(name, "..") == 0) {
+				continue;
+			}
+			off_t size = -1;
+			if (type == DT_REG) {
+				char full[A8F_PATH + 256];
+				vnode_t fvp = NULLVP;
+				snprintf(full, sizeof(full), "%s/%s", path, name);
+				if (vnode_lookup(full, 0, &fvp, ctx) == 0) {
+					(void)vnode_size(fvp, &size, ctx);
+					vnode_put(fvp);
+				}
+			}
+			printf("A8F: %c %lld %s\n", type == DT_DIR ? 'd' : type == DT_REG ? 'f' :
+			    type == DT_LNK ? 'l' : '?', (long long)size, name);
+			shown++;
+		}
+	}
+	printf("A8F LS END %s (%d)\n", path, shown);
+	kfree_data(buf, bufsize);
+	vnode_close(vp, FREAD, ctx);
+}
+
+void
+a8f_date(const char *args)
+{
+	clock_sec_t secs = 0;
+	clock_usec_t usecs = 0;
+	uint64_t want = 0;
+
+	if (*args && a8f_number(&args, 10, &want)) {
+		if (want < 1600000000ull || want > 4102444800ull) {
+			printf("A8SH: date: %llu is not a time between 2020 and 2100\n", want);
+			return;
+		}
+		clock_set_calendar_microtime((clock_sec_t)want, 0);
+		printf("A8SH: date set\n");
+	} else if (*args) {
+		printf("A8SH: date [SECONDS since 1970, UTC]\n");
+		return;
+	}
+	clock_get_calendar_microtime(&secs, &usecs);
+	printf("A8SH: date %lu (seconds since 1970, UTC)\n", (unsigned long)secs);
+}
