+/*
+ * Pixels that are already in the client's memory: IOSurfaceAddress at create,
+ * and IOSurfaceWrapClientImage (sel 6), which is what CoreAnimation's OpenGL
+ * ES renderer asks for every image it draws -- app icons, glyph masks,
+ * gradients.  Both used to be ignored: sel 6 was refused (backboardd then
+ * asked again, every image every frame: 135,000 refusals in 25 minutes on
+ * jt 0189), and its fallback, a create with IOSurfaceAddress, got fresh zero
+ * pages, so the home screen's icons and the widgets' pictures were drawn as
+ * nothing (the S7 port hit the same: wardevsa 0255, 0259, 0332).
+ *
+ * The surface IS the client's pages when they can be held (wired) -- what the
+ * client draws there later is then seen by everyone who maps the surface --
+ * and otherwise it is a copy of them taken now.  `need` is how many bytes from
+ * `at` the pixels span.  Runs in the client's own context (copyin).
+ * Boot-arg sweetwrap=0: always copy.
+ */
+static int sweet_surface_wrap_on = -1;
+
+static IOReturn
+sweet_surface_take_client(SweetSurface *s, task_t task, uint64_t at, uint64_t need,
+    bool *wrapped)
+{
+	uint64_t first = trunc_page_64(at);
+	uint64_t off = at - first;
+	uint64_t len;
+
+	*wrapped = false;
+	if (at == 0 || need == 0 || need > SWEET_SURFACE_MAX_ALLOC) {
+		return kIOReturnBadArgument;
+	}
+	if (sweet_surface_wrap_on < 0) {
+		uint32_t on = 1;
+		PE_parse_boot_argn("sweetwrap", &on, sizeof(on));
+		sweet_surface_wrap_on = on != 0;
+	}
+	len = round_page_64(off + need);
+	if (sweet_surface_wrap_on) {
+		uint64_t before = (uint64_t)OSAddAtomic64((SInt64)len,
+		    (volatile SInt64 *)&sweet_surface_client_wired);
+		if (before + len <= SWEET_SURFACE_CLIENT_MAX) {
+			/* Read-write if the client may write them, else for reading. */
+			static const IOOptionBits ways[2] = { kIODirectionInOut, kIODirectionOut };
+			for (int w = 0; w < 2; w++) {
+				IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(
+					(mach_vm_address_t)first, (mach_vm_size_t)len, ways[w], task);
+				if (md != NULL && md->prepare() == kIOReturnSuccess) {
+					s->memory = md;
+					s->clientBytes = len;
+					s->wrapOffset = (uint32_t)off;
+					s->mapReadOnly = (w == 1);
+					s->mapCache = kIOMapDefaultCache;
+					s->allocSize = (uint32_t)(len - off);
+					*wrapped = true;
+					return kIOReturnSuccess;
+				}
+				OSSafeReleaseNULL(md);
+			}
+		}
+		OSAddAtomic64(-(SInt64)len, (volatile SInt64 *)&sweet_surface_client_wired);
+	}
+
+	/* A copy: as much of it as can be read, page by page if need be. */
+	uint64_t size = round_page_64(need);
+	IOBufferMemoryDescriptor *mem = NULL;
+	if ((uint64_t)OSAddAtomic64((SInt64)size, (volatile SInt64 *)&sweet_surface_wired) + size <=
+	    SWEET_SURFACE_WIRED_MAX) {
+		mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared, (vm_size_t)size, page_size);
+	}
+	if (mem == NULL) {
+		OSAddAtomic64(-(SInt64)size, (volatile SInt64 *)&sweet_surface_wired);
+		return kIOReturnNoMemory;
+	}
+	uint8_t *dst = (uint8_t *)mem->getBytesNoCopy();
+	bzero(dst, (size_t)size);
+	if (copyin((user_addr_t)at, dst, (vm_size_t)need) != 0) {
+		for (uint64_t done = 0; done < need;) {
+			uint64_t n = PAGE_SIZE - ((at + done) & PAGE_MASK);
+			if (n > need - done) {
+				n = need - done;
+			}
+			(void)copyin((user_addr_t)(at + done), dst + done, (vm_size_t)n);
+			done += n;
+		}
+	}
+	s->memory = mem;
+	s->mapCache = kIOMapDefaultCache;
+	s->allocSize = (uint32_t)size;
+	return kIOReturnSuccess;
+}
