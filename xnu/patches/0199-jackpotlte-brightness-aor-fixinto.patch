+
+/*
+ * 0199: the console's "fixinto NAME,NAME|-": programs that get the fix
+ * library (a8fix=1) although their path has no ".app/" in it -- daemons, so
+ * that an uncaught exception that kills one is printed (the library's
+ * exception printer) and can be read with "tee".
+ */
+static char a8_fixinto_buf[2][128];
+static const char *volatile a8_fixinto_names = "";
+static uint32_t a8_fixinto_flip;
+
+void a8_fixinto_set(const char *names);
+const char *a8_fixinto_get(void);
+bool a8_fixinto_wants(const char *name, size_t len);
+
+void
+a8_fixinto_set(const char *names)
+{
+	char *buf = a8_fixinto_buf[++a8_fixinto_flip & 1u];
+	size_t n;
+
+	while (*names == ' ') {
+		names++;
+	}
+	if (names[0] == '-') {
+		names = "";
+	}
+	strlcpy(buf, names, sizeof(a8_fixinto_buf[0]));
+	for (n = strlen(buf); n > 0 && buf[n - 1] == ' '; n--) {
+		buf[n - 1] = 0;
+	}
+	a8_fixinto_names = buf;
+}
+
+const char *
+a8_fixinto_get(void)
+{
+	return a8_fixinto_names;
+}
+
+bool
+a8_fixinto_wants(const char *name, size_t len)
+{
+	const char *list = a8_fixinto_names;
+
+	return name != NULL && list[0] != 0 && a8_tee_listed(list, name, len);
+}
