+/*
+ * Readers of the console ring other than the SYSTEM log writer: the USB serial
+ * link (bsd/dev/a5xelte_usb.c). Positions count bytes since boot. A reader
+ * that fell more than the ring behind skips to the oldest byte still there.
+ * Bytes are only handed out up to `limit`, a total the caller saw a moment
+ * ago, so a writer that reserved its bytes but has not copied them yet is not
+ * read early.
+ */
+uint64_t a5xelte_log_position(void);
+uint32_t a5xelte_log_copy(uint64_t *pos, uint64_t limit, char *out, uint32_t max);
+
+uint64_t
+a5xelte_log_position(void)
+{
+	return os_atomic_load(&emmc_log_total, relaxed);
+}
+
+uint32_t
+a5xelte_log_copy(uint64_t *pos, uint64_t limit, char *out, uint32_t max)
+{
+	uint64_t total = os_atomic_load(&emmc_log_total, relaxed);
+	if (limit > total) {
+		limit = total;
+	}
+	if (limit > A5_LOG_SIZE && *pos < limit - A5_LOG_SIZE) {
+		*pos = limit - A5_LOG_SIZE;
+	}
+	if (*pos >= limit) {
+		return 0;
+	}
+	uint64_t avail = limit - *pos;
+	uint32_t n = avail < max ? (uint32_t)avail : max;
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = emmc_log_ring[(*pos + i) % A5_LOG_SIZE];
+	}
+	*pos += n;
+	return n;
+}
