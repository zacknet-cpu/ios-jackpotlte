+/* ---------------------------------------------------------------------------
+ * Serial link (a8usbmode=1)
+ * ---------------------------------------------------------------------------
+ *
+ * Phone to PC: the kernel's console ring (everything printf and the console
+ * print, bsd/dev/a5xelte_emmc.c) streams out on bulk IN 0x81 while a
+ * terminal holds the port open (DTR). Opening the port replays the ring from
+ * its oldest byte (up to 4 MiB), so the whole boot so far comes first.
+ *
+ * PC to phone: lines on bulk OUT 0x01 are commands for a small kernel shell
+ * (a8s_command); its answers are printf lines prefixed "A8SH:", so they reach
+ * the PC through the same stream and also land in the SYSTEM log.
+ *
+ * Everything but the commands runs on the gadget's polling thread, so the
+ * endpoint state needs no lock; commands run on their own thread because a
+ * reboot syncs the disks first.
+ */
+extern uint64_t a5xelte_log_position(void);
+extern uint32_t a5xelte_log_copy(uint64_t *pos, uint64_t limit, char *out, uint32_t max);
+extern int sync_internal(void);
+
+#define A8S_PMU_INFORM2   0x0808u
+#define A8S_PMU_INFORM3   0x080cu
+#define A8S_PMU_SWRESET   0x0400u
+#define A8S_POWER_RESET   0x12345678u  /* sec_reboot.c: INFORM2, a restart */
+#define A8S_REASON_NONE   0x12345670u  /* INFORM3: normal boot */
+#define A8S_REASON_DL     0x12345671u  /* INFORM3: download (Odin) mode */
+#define A8S_REASON_REC    0x12345674u  /* INFORM3: recovery (TWRP) */
+
+static void
+a8s_rx_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(a8g.dma + A8G_TRB_RX);
+	uint32_t len;
+
+	a8g_sync(A8G_TRB_RX, 16);
+	len = A8G_RX_MAX - (t[2] & 0xffffffu);
+	a8g_sync(A8G_RX, A8G_RX_MAX);
+	a8g.rx_bytes += len;
+	for (uint32_t i = 0; i < len && i < A8G_RX_MAX; i++) {
+		char c = ((const char *)(a8g.dma + A8G_RX))[i];
+		if (c == '\r' || c == '\n') {
+			if (a8g.line_len == 0) {
+				continue;
+			}
+			a8g.line[a8g.line_len] = 0;
+			if (!a8g.cmd_ready) {
+				memcpy(a8g.cmd, a8g.line, a8g.line_len + 1);
+				__asm__ volatile ("dmb ish" ::: "memory");
+				a8g.cmd_ready = true;
+			}
+			a8g.line_len = 0;
+		} else if (a8g.line_len < sizeof(a8g.line) - 1) {
+			a8g.line[a8g.line_len++] = c;
+		}
+	}
+	a8g_rx_arm();
+}
+
+/* Next piece of the console ring to the host, if the IN endpoint is idle. */
+static void
+a8s_pump(void)
+{
+	uint64_t now = a5xelte_log_position();
+
+	if (!a8g.configured || !a8g.host_open || a8g.tx_busy) {
+		a8g.log_limit = now;
+		return;
+	}
+	if (a8g.rewind) {
+		a8g.rewind = false;
+		a8g.log_pos = 0;        /* a5xelte_log_copy clamps to the oldest */
+	}
+	/* Only bytes reserved one poll ago: their writers have finished. */
+	uint32_t n = a5xelte_log_copy(&a8g.log_pos, a8g.log_limit,
+	    (char *)(a8g.dma + A8G_TX), A8G_TX_MAX);
+	a8g.log_limit = now;
+	if (n == 0) {
+		return;
+	}
+	/* A transfer of a multiple of 512 would need a zero-length packet to
+	 * end it on the host; hold its last byte back for the next one. */
+	if ((n % 512u) == 0) {
+		n--;
+		a8g.log_pos--;
+	}
+	a8g.tx_busy = true;
+	a8g.tx_bytes += n;
+	a8g_start_trb(A8G_EP_TX, A8G_TRB_TX, A8G_TX, n, A8_TRBCTL_NORMAL);
+}
+
+static uint64_t
+a8s_hex(const char **p, bool *ok)
+{
+	uint64_t v = 0;
+	int digits = 0;
+
+	while (**p == ' ') {
+		(*p)++;
+	}
+	if ((*p)[0] == '0' && ((*p)[1] == 'x' || (*p)[1] == 'X')) {
+		*p += 2;
+	}
+	for (;; (*p)++, digits++) {
+		char c = **p;
+		uint32_t d;
+		if (c >= '0' && c <= '9') {
+			d = (uint32_t)(c - '0');
+		} else if (c >= 'a' && c <= 'f') {
+			d = (uint32_t)(c - 'a' + 10);
+		} else if (c >= 'A' && c <= 'F') {
+			d = (uint32_t)(c - 'A' + 10);
+		} else {
+			break;
+		}
+		v = (v << 4) | d;
+	}
+	*ok = digits > 0 && digits <= 16;
+	return v;
+}
+
+static bool
+a8s_word(const char *s, const char *w, const char **rest)
+{
+	size_t n = strlen(w);
+	if (strncmp(s, w, n) != 0 || (s[n] != 0 && s[n] != ' ')) {
+		return false;
+	}
+	*rest = s + n;
+	return true;
+}
+
+static void
+a8s_reboot(uint32_t reason, const char *what)
+{
+	vm_offset_t pmu = ml_io_map(A8_PMU_PA, A8_PMU_SIZE);
+
+	printf("A8SH: sync, then restart into %s\n", what);
+	(void)sync_internal();
+	delay(500 * 1000);              /* let the line reach the PC */
+	if (pmu == 0) {
+		printf("A8SH: PMU map failed\n");
+		return;
+	}
+	/* sec_reboot.c sec_reboot(), then exynos-reboot.c's SWRESET. */
+	a8_usb_wr(pmu, A8S_PMU_INFORM2, A8S_POWER_RESET);
+	a8_usb_wr(pmu, A8S_PMU_INFORM3, reason);
+	a8_usb_wr(pmu, A8S_PMU_SWRESET, 1u);
+	for (;;) {
+		delay(1000);
+	}
+}
+
+static void
+a8s_command(const char *line)
+{
+	const char *rest;
+	bool ok = true;
+
+	printf("A8SH> %s\n", line);
+	if (a8s_word(line, "help", &rest)) {
+		printf("A8SH: help | ping | stat | log (resend the ring) | "
+		    "peek ADDR [WORDS] | poke ADDR VALUE | "
+		    "reboot [recovery|download]\n");
+	} else if (a8s_word(line, "ping", &rest)) {
+		printf("A8SH: pong\n");
+	} else if (a8s_word(line, "stat", &rest)) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		printf("A8SH: up %llu s, log %llu bytes, usb rx %llu tx %llu, "
+		    "events %u\n", ns / NSEC_PER_SEC, a5xelte_log_position(),
+		    a8g.rx_bytes, a8g.tx_bytes, a8g.events);
+	} else if (a8s_word(line, "log", &rest)) {
+		a8g.rewind = true;
+	} else if (a8s_word(line, "peek", &rest)) {
+		uint64_t pa = a8s_hex(&rest, &ok);
+		bool okn = true;
+		uint64_t words = *rest ? a8s_hex(&rest, &okn) : 1;
+		if (!ok || !okn || (pa & 3) || words == 0 || words > 64 ||
+		    ((pa & 0xfffu) + words * 4) > 0x1000u) {
+			printf("A8SH: peek ADDR [WORDS]: hex, 4-byte aligned, "
+			    "1-64 words inside one 4 KiB page\n");
+			return;
+		}
+		vm_offset_t va = ml_io_map((vm_offset_t)(pa & ~0xfffull), 0x1000);
+		if (va == 0) {
+			printf("A8SH: map failed\n");
+			return;
+		}
+		for (uint64_t i = 0; i < words; i += 4) {
+			char out[96];
+			int len = snprintf(out, sizeof(out), "A8SH: %09llx:", pa + i * 4);
+			for (uint64_t j = i; j < words && j < i + 4; j++) {
+				len += snprintf(out + len, sizeof(out) - (size_t)len, " %08x",
+				    a8_usb_rd(va, (uint32_t)((pa & 0xfffu) + j * 4)));
+			}
+			printf("%s\n", out);
+		}
+	} else if (a8s_word(line, "poke", &rest)) {
+		uint64_t pa = a8s_hex(&rest, &ok);
+		bool okv = true;
+		uint64_t val = a8s_hex(&rest, &okv);
+		if (!ok || !okv || (pa & 3) || val > 0xffffffffull) {
+			printf("A8SH: poke ADDR VALUE (hex, 32-bit)\n");
+			return;
+		}
+		vm_offset_t va = ml_io_map((vm_offset_t)(pa & ~0xfffull), 0x1000);
+		if (va == 0) {
+			printf("A8SH: map failed\n");
+			return;
+		}
+		uint32_t off = (uint32_t)(pa & 0xfffu);
+		uint32_t before = a8_usb_rd(va, off);
+		a8_usb_wr(va, off, (uint32_t)val);
+		printf("A8SH: %09llx: %08x -> %08x (reads %08x)\n", pa, before,
+		    (uint32_t)val, a8_usb_rd(va, off));
+	} else if (a8s_word(line, "reboot", &rest)) {
+		while (*rest == ' ') {
+			rest++;
+		}
+		if (*rest == 0) {
+			a8s_reboot(A8S_REASON_NONE, "iOS");
+		} else if (strcmp(rest, "recovery") == 0) {
+			a8s_reboot(A8S_REASON_REC, "recovery");
+		} else if (strcmp(rest, "download") == 0) {
+			a8s_reboot(A8S_REASON_DL, "download mode");
+		} else {
+			printf("A8SH: reboot [recovery|download]\n");
+		}
+	} else {
+		printf("A8SH: unknown command; try help\n");
+	}
+}
+
+static void
+a8s_cmd_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	char line[256];
+
+	for (;;) {
+		if (!a8g.cmd_ready) {
+			a8g_sleep_ms(20);
+			continue;
+		}
+		__asm__ volatile ("dmb ish" ::: "memory");
+		strlcpy(line, a8g.cmd, sizeof(line));
+		__asm__ volatile ("dmb ish" ::: "memory");
+		a8g.cmd_ready = false;
+		a8s_command(line);
+	}
+}
