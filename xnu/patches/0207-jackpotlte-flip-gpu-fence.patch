+/* 0207: called by jackpotlte_mali_enqueue() before a GPU job is queued.  With
+ * async SwapEnd the next frame may start drawing while the panel has not yet
+ * taken the flip to the last one, i.e. into the buffer it still shows (seen as
+ * heavy flicker on 11-24); the job waits for that, at most 20 ms. */
+extern "C" void
+sweet_fb_gpu_gate(void)
+{
+	uint32_t us;
+
+	if (!a8_flip_async || !a8_flip_gpu_on() || !a8_scan_pending()) {
+		return;
+	}
+	us = a8_scan_settle();
+	a8_gpu_gates++;
+	a8_gpu_gate_us += us;
+}
+
+/* 0207: before a swap points the panel at a buffer, the GPU finishes what is
+ * queued, which includes the frame being presented (at most 50 ms). */
+static void
+a8_flip_gpu_wait(void)
+{
+	uint64_t seq, t0, ns;
+	bool done;
+
+	if (!a8_flip_gpu_on()) {
+		return;
+	}
+	seq = jackpotlte_mali_queued_seq();
+	if (seq == 0 || jackpotlte_mali_wait(seq, 0)) {
+		return;
+	}
+	t0 = mach_absolute_time();
+	done = jackpotlte_mali_wait(seq, 50ull * NSEC_PER_MSEC);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	a8_flip_gpu_busy++;
+	a8_flip_gpu_us += ns / 1000;
+	if (!done && a8_flip_gpu_late++ < 8) {
+		IOLog("A8 FLIP: the GPU was still busy 50 ms into a swap (job %llu)\n", seq);
+	}
+}
