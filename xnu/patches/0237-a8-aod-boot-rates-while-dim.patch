diff --git a/bsd/dev/a8_acpm.c b/bsd/dev/a8_acpm.c
index 2a39414..6b9a8c1 100644
--- a/bsd/dev/a8_acpm.c
+++ b/bsd/dev/a8_acpm.c
@@ -1391,6 +1391,64 @@ a8a_domain_named(const char *name)
 	return -1;
 }
 
+/*
+ * 0237 (P14 AOD power, user's OK 11-28): while the screen is dim, big,
+ * little and g3d go to their boot rates (the S-Boot levels the phone ran at
+ * before a8dvfsboot, and where the 80 C watch puts them: big 1352000, little
+ * 1014000, g3d 343000 kHz, lower voltages); at wake the rates asked before
+ * come back.  Only domains that were above their boot rate are touched.
+ * Measured 11-28 before this: ~250-360 mA locked (97 -> 91 % in 30 min) with
+ * the CPUs nearly idle (12 % of one core) at 2184/1586/1100 MHz.
+ */
+static uint32_t a8a_dim_saved[A8A_DOMAINS];
+static bool a8a_dimmed;
+
+int a8_dvfs_dim(int on);
+
+int
+a8_dvfs_dim(int on)
+{
+	static const char *const want[] = { "big", "little", "g3d" };
+	int changed = 0;
+
+	if (a8a.allow == 0) {
+		return -1;
+	}
+	lck_mtx_lock(&a8a_lock);
+	if (on && !a8a_dimmed) {
+		for (unsigned i = 0; i < 3; i++) {
+			int d = a8a_domain_named(want[i]);
+			struct a8a_domain *dom;
+
+			if (d < 0) {
+				continue;
+			}
+			dom = &a8a.dom[d];
+			a8a_dim_saved[d] = 0;
+			if (dom->ok && dom->boot_khz != 0 && dom->asked_khz > dom->boot_khz) {
+				a8a_dim_saved[d] = dom->asked_khz;
+				a8a_dvfs_set((uint32_t)d, dom->boot_khz);
+				changed++;
+			}
+		}
+		a8a_dimmed = true;
+	} else if (!on && a8a_dimmed) {
+		for (uint32_t d = 0; d < A8A_DOMAINS; d++) {
+			if (a8a_dim_saved[d] != 0) {
+				a8a_dvfs_set(d, a8a_dim_saved[d]);
+				a8a_dim_saved[d] = 0;
+				changed++;
+			}
+		}
+		a8a_dimmed = false;
+	}
+	lck_mtx_unlock(&a8a_lock);
+	printf("A8 DVFS: dim lock screen %s (0237): %d domains\n", on ? "on, boot rates" : "off, rates back",
+	    changed);
+	return changed;
+}
