+/* 0214 */
+/*
+ * 0214 (host-tested as one piece, va_test.c in the session's notes; callers
+ * hold jt_mali_lock).   GPU addresses below 4 GB, handed out again once freed.  Linux panfrost
+ * keeps every buffer in [32 MB, 4 GB) (panfrost_mmu.c, drm_mm_init) and
+ * Mesa's Bifrost code relies on it: some descriptors keep only the low 32
+ * bits of a shader's address and take the rest from another shader's.  A
+ * bitmap of 64 KB granules from JT_VA_FIRST to 4 GB; next fit from a rolling
+ * cursor; every buffer gets one more granule than it needs, so the next
+ * buffer never starts right after it (an overrun still faults).  The last
+ * granule below 4 GB is never handed out, so no buffer ends on the boundary.
+ */
+#define JT_VA_GRANULE		0x10000ull			/* 64 KB */
+#define JT_VA_TOP		(1ull << 32)
+#define JT_VA_GRANULES		((uint32_t)(JT_VA_TOP / JT_VA_GRANULE))	/* 65536 */
+#define JT_VA_FIRST		0x01000000ull			/* 16 MB */
+
+static uint64_t jt_va_used[JT_VA_GRANULES / 64];	/* bit set: granule in use */
+static uint32_t jt_va_cursor;				/* where the next search starts */
+static uint64_t jt_va_in_use, jt_va_peak;		/* granules */
+static uint64_t jt_va_allocs, jt_va_frees, jt_va_fails, jt_va_kept;
+static bool jt_va_ready;
+
+static inline bool
+jt_va_bit(uint32_t g)
+{
+	return (jt_va_used[g >> 6] >> (g & 63)) & 1;
+}
+
+static inline void
+jt_va_set(uint32_t g, bool on)
+{
+	if (on) {
+		jt_va_used[g >> 6] |= 1ull << (g & 63);
+	} else {
+		jt_va_used[g >> 6] &= ~(1ull << (g & 63));
+	}
+}
+
+static void
+jt_va_init(void)
+{
+	uint32_t g;
+
+	for (g = 0; g < JT_VA_GRANULES / 64; g++) {
+		jt_va_used[g] = 0;
+	}
+	for (g = 0; g < (uint32_t)(JT_VA_FIRST / JT_VA_GRANULE); g++) {
+		jt_va_set(g, true);			/* below 16 MB: never */
+	}
+	jt_va_set(JT_VA_GRANULES - 1, true);		/* nothing ends on 4 GB */
+	jt_va_cursor = (uint32_t)(JT_VA_FIRST / JT_VA_GRANULE);
+	jt_va_in_use = 0;
+	jt_va_ready = true;
+}
+
+/* Granules a buffer of `size` bytes takes: its own plus one free after it. */
+static inline uint32_t
+jt_va_granules(uint64_t size)
+{
+	return (uint32_t)((size + JT_VA_GRANULE - 1) / JT_VA_GRANULE) + 1;
+}
+
+/* Look for `need` free granules in [from, to); the first one or 0xffffffffu. */
+static uint32_t
+jt_va_find(uint32_t from, uint32_t to, uint32_t need)
+{
+	uint32_t g = from, run = 0, start = from;
+
+	while (g < to) {
+		if ((g & 63) == 0 && run == 0 && jt_va_used[g >> 6] == ~0ull) {
+			g += 64;			/* a whole word in use */
+			continue;
+		}
+		if (jt_va_bit(g)) {
+			run = 0;
+			g++;
+			continue;
+		}
+		if (run == 0) {
+			start = g;
+		}
+		if (++run == need) {
+			return start;
+		}
+		g++;
+	}
+	return 0xffffffffu;
+}
+
+/* `size` bytes of GPU address below 4 GB; 0: none free. */
+static uint64_t
+jt_va_alloc(uint64_t size)
+{
+	uint32_t need = jt_va_granules(size), first = (uint32_t)(JT_VA_FIRST / JT_VA_GRANULE);
+	uint32_t start, g;
+
+	if (!jt_va_ready) {
+		jt_va_init();
+	}
+	if (size == 0 || need > JT_VA_GRANULES - first) {
+		jt_va_fails++;
+		return 0;
+	}
+	start = jt_va_find(jt_va_cursor, JT_VA_GRANULES, need);
+	if (start == 0xffffffffu) {
+		start = jt_va_find(first, jt_va_cursor, need);
+	}
+	if (start == 0xffffffffu) {
+		start = jt_va_find(first, JT_VA_GRANULES, need);	/* across the cursor */
+	}
+	if (start == 0xffffffffu) {
+		jt_va_fails++;
+		return 0;
+	}
+	for (g = start; g < start + need; g++) {
+		jt_va_set(g, true);
+	}
+	jt_va_cursor = start + need < JT_VA_GRANULES ? start + need : first;
+	jt_va_in_use += need;
+	if (jt_va_in_use > jt_va_peak) {
+		jt_va_peak = jt_va_in_use;
+	}
+	jt_va_allocs++;
+	return (uint64_t)start * JT_VA_GRANULE;
+}
+
+/* Give back what jt_va_alloc(size) handed out at `address`. */
+static void
+jt_va_free(uint64_t address, uint64_t size)
+{
+	uint32_t first = (uint32_t)(address / JT_VA_GRANULE), need = jt_va_granules(size), g;
+
+	if (!jt_va_ready || address < JT_VA_FIRST || address >= JT_VA_TOP ||
+	    (address & (JT_VA_GRANULE - 1)) != 0 || first + need > JT_VA_GRANULES - 1) {
+		return;
+	}
+	for (g = first; g < first + need; g++) {
+		if (jt_va_bit(g)) {
+			jt_va_set(g, false);
+			jt_va_in_use--;
+		}
+	}
+	jt_va_frees++;
+}
