+/* 0214: the addresses of a buffer whose pages jackpotlte_mali_unmap() took out
+ * (and out of the MMU) go back to the allocator; `idle` false (its last job
+ * did not finish) keeps them, so a late GPU access faults instead of landing
+ * in another buffer. */
+void
+jackpotlte_mali_release(uint64_t gpu, uint64_t size, bool idle)
+{
+	lck_mtx_lock(&jt_mali_lock);
+	if (jt_va_mode > 0) {
+		if (idle) {
+			jt_va_free(gpu, size);
+		} else {
+			jt_va_kept++;
+		}
+	}
+	lck_mtx_unlock(&jt_mali_lock);
+}
