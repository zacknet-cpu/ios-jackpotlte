+/*
+ * One job chain from a client, queued (0218: the body of kPanfrostSubmit, so
+ * that kJackpotlteSubmit2 can take two in one call).  gMaliLock held.  The
+ * job's number goes back in s->jc (0: not queued).
+ */
+uint64_t
+JackpotlteMaliUserClient::submitOne(struct drm_panfrost_submit * s)
+{
+	struct mali_buffer * b;
+	/* queued, not run here: the job's number goes back in `jc`, and every buffer it names
+	 * remembers it (kPanfrostWaitBO, and no buffer is freed under a job that uses it) */
+	uint64_t seq = 0;
+	uint64_t t0 = mach_absolute_time(), t1 = t0, t2 = t0;
+
+	fSubmits++;
+	gMaliSubmits++;
+	if (s->jc != 0) {
+		bool fragment = (s->requirements & PANFROST_JD_REQ_FS) != 0;
+		bool gate = true;
+
+		/* 0211: with a8gatescan (default), only a fragment job that names a
+		 * scan-out buffer waits for the panel to take a pending flip. */
+		if (sweet_fb_gate_scanout_only()) {
+			gate = false;
+			for (uint32_t i = 0; fragment && !gate && i < s->bo_handle_count && i < 4096; i += 64) {
+				uint32_t handles[64];
+				uint32_t n = s->bo_handle_count - i < 64 ? s->bo_handle_count - i : 64;
+
+				if (copyin((user_addr_t) (s->bo_handles + i * sizeof(uint32_t)), handles,
+				    n * sizeof(uint32_t)) != 0) {
+					gate = true;
+					break;
+				}
+				for (uint32_t k = 0; k < n && !gate; k++) {
+					b = buffer(handles[k]);
+					gate = b != NULL && b->scanout;
+				}
+			}
+		}
+		t1 = mach_absolute_time();
+		seq = jackpotlte_mali_enqueue_gated(s->jc, fragment, gate);
+		t2 = mach_absolute_time();
+		if (seq == 0) {
+			gMaliFailed++;
+		}
+	}
+	for (uint32_t i = 0; seq != 0 && i < s->bo_handle_count && i < 4096; i += 64) {
+		uint32_t handles[64];
+		uint32_t n = s->bo_handle_count - i < 64 ? s->bo_handle_count - i : 64;
+
+		if (copyin((user_addr_t) (s->bo_handles + i * sizeof(uint32_t)), handles, n * sizeof(uint32_t)) != 0) {
+			break;
+		}
+		for (uint32_t k = 0; k < n; k++) {
+			b = buffer(handles[k]);
+			if (b != NULL) {
+				b->last_seq = seq;
+			}
+		}
+	}
+	/* Bring-up aid: a chain that reaches here is the first thing the
+	 * GPU is asked to draw in this port, so its presence or absence
+	 * in the log says how far the GL path got.  The first few only:
+	 * a frame submits many. */
+	if (fSubmits <= 8) {
+		IOLog("JackpotlteMali: job %u: chain %#llx, %u buffers, "
+		    "requirements %#x, seq %llu\n", fSubmits,
+		    (unsigned long long) s->jc, s->bo_handle_count,
+		    s->requirements, (unsigned long long) seq);
+	}
+	s->jc = seq;
+	{
+		uint64_t total, queueing;
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &total);
+		absolutetime_to_nanoseconds(t2 - t1, &queueing);
+		gMaliSubmitNs += total;
+		gMaliEnqueueNs += queueing;
+		gMaliTimedSubmits++;
+	}
+	return seq;
+}
