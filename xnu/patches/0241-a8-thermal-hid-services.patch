+/*
+ * 0241 (P16): one TMU probe for SweetThermal's HID temperature services
+ * (iokit/Kernel/arm/hid/SweetHID.cpp), in hundredths of a degree C.
+ * which 0 = the CPU block (exynos7885.dtsi BIG@10070000 and LITTLE@10070000
+ * both read its one probe, sensors = <1>), 1 = G3D@10074000.  Never waits:
+ * while a8a_lock is held (ACPM IPC, a DVFS change, the firmware load) the
+ * last good reading of that probe is given, if it is under 10 s old.
+ * 0, or -1 when there is no reading.
+ */
+int a8_tmu_centi(int which, int *centi);
+int
+a8_tmu_centi(int which, int *centi)
+{
+	static int last[2];
+	static uint64_t last_at[2];
+	uint32_t raw[4], esr;
+	uint64_t now, age;
+	int celsius = 0;
+	bool ok;
+
+	if (which < 0 || which > 1 || centi == NULL) {
+		return -1;
+	}
+	now = mach_absolute_time();
+	if (!lck_mtx_try_lock(&a8a_lock)) {
+		nanoseconds_to_absolutetime(10ULL * NSEC_PER_SEC, &age);
+		if (last_at[which] != 0 && now - last_at[which] < age) {
+			*centi = last[which];
+			return 0;
+		}
+		return -1;
+	}
+	a8t_map();
+	ok = a8t_read(which == 0 ? a8a.tmu_cpu : a8a.tmu_g3d, &celsius, raw, &esr);
+	if (ok) {
+		last[which] = celsius * 100;
+		last_at[which] = now;
+	}
+	lck_mtx_unlock(&a8a_lock);
+	if (!ok) {
+		return -1;
+	}
+	*centi = celsius * 100;
+	return 0;
+}
