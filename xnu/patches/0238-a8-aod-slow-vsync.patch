+/*
+ * 0238 (P14 AOD power): the vsync tick (60 Hz, a VSync notification to
+ * every framebuffer client -- backboardd's CoreAnimation -- each time, and
+ * where a pending frame is shown) runs at a8aodvsync Hz while the screen is
+ * dim (default 4; 0 or >= 60 keeps 60).  With the live dim lock screen a new
+ * minute still reaches the panel within a quarter second; display on asks
+ * for the next tick at once (kickVsync).  Console "aodvsync N".
+ */
+static int sweet_fb_aod_vsync_hz = -1;
+static uint32_t
+sweet_fb_aod_vsync_us(void)
+{
+	if (sweet_fb_aod_vsync_hz < 0) {
+		int v = 4;
+		(void)PE_parse_boot_argn("a8aodvsync", &v, sizeof(v));
+		sweet_fb_aod_vsync_hz = v < 0 ? 4 : v;
+	}
+	if (sweet_fb_aod_vsync_hz <= 0 || sweet_fb_aod_vsync_hz >= 60) {
+		return SWEET_FB_VSYNC_US;
+	}
+	return 1000000u / (uint32_t)sweet_fb_aod_vsync_hz;
+}
