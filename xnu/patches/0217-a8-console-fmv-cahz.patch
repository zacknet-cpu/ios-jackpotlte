+/*
+ * 0217: console "fmv FROM TO" renames a file or a directory, both paths under
+ * /private/var/ (the data volume; no . or ..), with kernel credentials.  It is
+ * the reversible way to take a file out of the way: move it aside, and back.
+ * First use: LaunchServices' database (InternalDaemon/<id>/Library/Caches/
+ * com.apple.LaunchServices-*.csstore, and its SystemDataOnly- twin) moved
+ * aside, so that lsd builds it anew now that it knows the extension points
+ * (0216).  The Galaxy S7 port removes it once for the same reason
+ * (wardevsa/ios-a5xelte gpu/eagl/test/hero-run.c, remove_ls_db_once).
+ */
+void
+a8f_mv(const char *args)
+{
+	char from[A8F_PATH], to[A8F_PATH];
+	int error;
+
+	if (!a8f_word(&args, from, sizeof(from)) || !a8f_word(&args, to, sizeof(to))) {
+		printf("A8F MV error: fmv FROM TO (both under /private/var/)\n");
+		return;
+	}
+	if (strncmp(from, "/private/var/", 13) != 0 || strncmp(to, "/private/var/", 13) != 0 ||
+	    a8f_has(from, "/../") || a8f_has(from, "/./") ||
+	    a8f_has(to, "/../") || a8f_has(to, "/./")) {
+		printf("A8F MV error: only under /private/var/ (no . or ..): %s -> %s\n", from, to);
+		return;
+	}
+	error = a8_kernel_rename(from, to);
+	printf("A8F MV %s -> %s: %s (%d)\n", from, to, error ? "failed" : "done", error);
+}
+
 void
 a8f_ls(const char *args)
 {
