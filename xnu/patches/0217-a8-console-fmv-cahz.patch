 }
 
+/*
+ * 0217: console "cahz N" publishes IOMFBDisplayRefresh at N Hz (30-240) on the
+ * framebuffer, "cahz 0" takes it away, "cahz" reports.  CoreAnimation reads it
+ * when backboardd starts, so a change is seen after "kill backboardd".  The
+ * boot-arg sweetfb_cahz does the same at boot, but the line has no room
+ * (598 of 607): this tries 120 Hz (the S7/S9 ports' setting) without a slot.
+ */
+static uint32_t a8_cahz_told;
+
+extern "C" int
+sweet_fb_cahz_set(int hz)
+{
+	AppleCLCD *fb = sweet_fb_main;
+
+	if (fb == NULL) {
+		return -1;
+	}
+	if (a8_cahz_told == 0 && hz < 0) {
+		a8_cahz_told = a8_cahz_boot;
+	}
+	if (hz == 0) {
+		fb->removeProperty("IOMFBDisplayRefresh");
+		a8_cahz_told = 0;
+	} else if (hz >= 30 && hz <= 240) {
+		OSDictionary *refresh = OSDictionary::withCapacity(4);
+		if (refresh != NULL) {
+			uint64_t interval = (1ULL << 32) / (uint32_t)hz, ticks = 0;
+			static const char *const keys[] = {
+				"displayMinRefreshInterval", "displayMaxRefreshInterval", "displayRefreshStep"
+			};
+			nanoseconds_to_absolutetime(NSEC_PER_SEC / (uint32_t)hz, &ticks);
+			for (unsigned k = 0; k < 3; k++) {
+				OSNumber *n = OSNumber::withNumber(interval, 64);
+				if (n != NULL) {
+					refresh->setObject(keys[k], n);
+					n->release();
+				}
+			}
+			OSNumber *t = OSNumber::withNumber(ticks, 64);
+			if (t != NULL) {
+				refresh->setObject("displayRefreshStepMachTime", t);
+				t->release();
+			}
+			fb->setProperty("IOMFBDisplayRefresh", refresh);
+			refresh->release();
+			a8_cahz_told = (uint32_t)hz;
+		}
+	}
+	IOLog("A8 FB: IOMFBDisplayRefresh %s%u%s (seen by CoreAnimation after kill backboardd)\n",
+	    a8_cahz_told ? "" : "not published (", a8_cahz_told, a8_cahz_told ? " Hz" : ")");
+	return (int)a8_cahz_told;
+}
