+/*
+ * 0211: tunables (boot-args, read once) and counters.
+ *  a8gpunap   a job wait's nap in us once the first 300 us of polling are
+ *             over (default 50; 0153-0210 slept 200 us at a time, so a job's
+ *             end was seen up to 200 us late, several times a frame).
+ *  a8mmuflush 1 (default): a buffer entered into or taken out of address
+ *             space 0 drops only its own range from the MMU (LOCK +
+ *             FLUSH_PT, as panfrost_mmu.c does), which is allowed while jobs
+ *             run; 0: the whole address space is set up again (UPDATE), which
+ *             waits for the running job (0153-0210).
+ */
+static int jt_tuned;
+static uint32_t jt_nap_us = 50;
+static int jt_mmu_region = 1;
+static uint64_t jt_jobs[2], jt_job_ns[2], jt_job_max_ns[2], jt_jobs_failed, jt_jobs_fast_fail;
+static uint64_t jt_mmu_flushes, jt_mmu_updates, jt_mmu_slow;
+static uint64_t jt_jobs_gated, jt_jobs_free;
+static unsigned jt_fault_dumps;
+
+static void
+jt_tune(void)
+{
+	uint32_t v;
+
+	if (jt_tuned) {
+		return;
+	}
+	if (PE_parse_boot_argn("a8gpunap", &v, sizeof(v)) && v >= 5 && v <= 1000) {
+		jt_nap_us = v;
+	}
+	if (PE_parse_boot_argn("a8mmuflush", &v, sizeof(v))) {
+		jt_mmu_region = v != 0;
+	}
+	jt_tuned = 1;
+}
+
+/* A job on `slot` done (true), failed or stopped by an MMU fault (false,
+ * *mmu set for the fault), or not done within `ms`.  0153-0210 waited for
+ * the done bit alone, so a failed job (its fault bit set at once) or one
+ * held by an MMU fault (neither bit) cost the whole second. */
+static bool
+jt_wait_job(uint32_t slot, uint32_t ms, bool *mmu)
+{
+	uint32_t done = 1u << slot, fail = 1u << (slot + 16), raw;
+	uint64_t deadline, nap;
+
+	*mmu = false;
+	for (int i = 0; i < 60; i++) {		/* 300 us at 5 us */
+		raw = jt_rd(jt_gpu, JT_MALI_JOB_INT_RAWSTAT);
+		if (raw & (done | fail)) {
+			return (raw & fail) == 0;
+		}
+		if (jt_rd(jt_gpu, JT_MALI_MMU_INT_RAWSTAT) & 0x10001u) {
+			*mmu = true;
+			return false;
+		}
+		delay(5);
+	}
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		raw = jt_rd(jt_gpu, JT_MALI_JOB_INT_RAWSTAT);
+		if (raw & (done | fail)) {
+			return (raw & fail) == 0;
+		}
+		if (jt_rd(jt_gpu, JT_MALI_MMU_INT_RAWSTAT) & 0x10001u) {
+			*mmu = true;
+			return false;
+		}
+		clock_interval_to_deadline(jt_nap_us, NSEC_PER_USEC, &nap);
+		lck_mtx_lock(&jt_wait_lock);
+		(void)lck_mtx_sleep_deadline(&jt_wait_lock, LCK_SLEEP_DEFAULT,
+		    (event_t)&jt_wait_event, THREAD_UNINT, nap);
+		lck_mtx_unlock(&jt_wait_lock);
+	}
+	raw = jt_rd(jt_gpu, JT_MALI_JOB_INT_RAWSTAT);
+	return (raw & done) && !(raw & fail);
+}
+
+/* With jt_mali_lock held: AS 0 has no command running (true), within 10 ms. */
+static bool
+jt_as0_ready(void)
+{
+	for (int i = 0; i < 10000; i++) {
+		if (!(jt_rd(jt_gpu, JT_MALI_AS0 + JT_MALI_AS_STATUS) &
+		    JT_MALI_AS_STATUS_ACTIVE)) {
+			return true;
+		}
+		delay(1);
+	}
+	jt_mmu_slow++;
+	return false;
+}
+
+/* With jt_mali_lock held: the MMU forgets what it cached of [start, start +
+ * size), as panfrost_mmu.c's lock_region() + AS_COMMAND_FLUSH_PT: the smallest
+ * naturally aligned power-of-two block holding the range, at least 32 KB, its
+ * log2 minus one in the low bits of LOCKADDR. */
+static void
+jt_as0_flush_range(uint64_t start, uint64_t size)
+{
+	uint64_t end = start + size, region;
+	uint32_t width;
+
+	if (size == 0 || jt_gpu == NULL) {
+		return;
+	}
+	width = 64u - (uint32_t)__builtin_clzll(start ^ (end - 1));
+	if (width < 15u) {
+		width = 15u;
+	}
+	width -= 1u;
+	region = (start & ~((1ull << width) - 1)) | width;
+	(void)jt_as0_ready();
+	jt_wr(jt_gpu, JT_MALI_AS0 + JT_MALI_AS_LOCKADDR_LO, (uint32_t)region);
+	jt_wr(jt_gpu, JT_MALI_AS0 + JT_MALI_AS_LOCKADDR_HI, (uint32_t)(region >> 32));
+	jt_wr(jt_gpu, JT_MALI_AS0 + JT_MALI_AS_COMMAND, JT_MALI_AS_COMMAND_LOCK);
+	(void)jt_as0_ready();
+	jt_wr(jt_gpu, JT_MALI_AS0 + JT_MALI_AS_COMMAND, JT_MALI_AS_COMMAND_FLUSH_PT);
+	(void)jt_as0_ready();
+	jt_mmu_flushes++;
+}
