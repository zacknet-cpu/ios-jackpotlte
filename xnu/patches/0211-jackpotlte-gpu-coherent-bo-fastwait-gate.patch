+/*
+ * 0211: a new buffer's memory is zeroed by the processor through the kernel's
+ * cached mapping (IOBufferMemoryDescriptor, Z_ZERO), but the GPU does not see
+ * the processor's caches.  Until those lines are written back the GPU reads
+ * whatever an earlier owner of the pages left in memory, and a dirty line
+ * written back later overwrites what Mesa or the GPU put there since.  That
+ * fits the faults seen on 11-24/25 after an hour or more of use: fragment
+ * jobs fetching shaders at addresses inside an earlier, dead backboardd's
+ * tiler heap.  Linux makes the pages coherent when panfrost maps them
+ * (dma_map_sgtable); here the buffer is cleaned and invalidated to the point
+ * of coherency once, when it is made.  Boot-arg a8boclean=0 skips it.
+ */
+static int gMaliClean = -1;
+
+static bool
+mali_clean_on(void)
+{
+	if (gMaliClean < 0) {
+		int on = 1;
+
+		PE_parse_boot_argn("a8boclean", &on, sizeof(on));
+		gMaliClean = on != 0;
+	}
+	return gMaliClean > 0;
 }
 
