+/* 0211: what a faulting job held, for reading next to the fault line: `words`
+ * 32-bit words at GPU address `gpu`, through the same tables the GPU walks. */
+static void
+jt_dump_gpu(const char *what, uint64_t gpu, unsigned words)
+{
+	for (unsigned i = 0; i < words; i += 8) {
+		uint32_t w[8];
+		unsigned n = 0;
+
+		while (n < 8 && i + n < words) {
+			uint64_t at = gpu + 4ull * (i + n);
+			uint64_t pte = jt_pt_lookup(at & ~0xfffull);
+			vm_offset_t kva;
+
+			if (!(pte & 1)) {
+				break;
+			}
+			kva = phystokv((pte & JT_PTE_ADDRESS) + (at & 0xfffull));
+			FlushPoC_DcacheRegion(kva & ~(vm_offset_t)63, 64);
+			w[n++] = *(volatile uint32_t *)kva;
+		}
+		printf("JACKPOTLTE MALI: %s %#llx+%#x:", what,
+		    (unsigned long long)gpu, i * 4);
+		for (unsigned k = 0; k < n; k++) {
+			printf(" %08x", w[k]);
+		}
+		printf("%s\n", n < 8 && i + n < words ? " (not mapped)" : "");
+		if (n < 8 && i + n < words) {
+			break;
+		}
+	}
+}
