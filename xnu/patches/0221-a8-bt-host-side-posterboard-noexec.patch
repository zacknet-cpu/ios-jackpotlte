diff --git a/iokit/Kernel/arm/A8Bluetooth.cpp b/iokit/Kernel/arm/A8Bluetooth.cpp
new file mode 100644
index 0000000..400f98b
--- /dev/null
+++ b/iokit/Kernel/arm/A8Bluetooth.cpp
@@ -0,0 +1,70 @@
+/*
+ * 0221: the Galaxy A8's Bluetooth for iOS's bluetoothd: an IOService named
+ * "bluetooth", which bluetoothd looks for first, with what it reads of it:
+ * local-mac-address (the device address), transport-encoding (1: H4) and
+ * transport-speed.  The HCI itself goes through the kernel control that
+ * bsd/dev/a5xelte_bt.c registers.  As the Galaxy S20 port's RedwoodBluetooth
+ * (jesvi-eulah/Jesvi-iOS, xnu/files/iokit/Kernel/RedwoodWLAN.cpp).
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <libkern/c++/OSData.h>
+
+#if defined(ARM64_BOARD_CONFIG_A5XELTE) && defined(JACKPOTLTE)
+
+class A8Bluetooth : public IOService
+{
+	OSDeclareDefaultStructors(A8Bluetooth);
+};
+
+OSDefineMetaClassAndStructors(A8Bluetooth, IOService);
+
+extern "C" int a8_bluetooth_publish(const uint8_t *address, uint32_t speed);
+
+int
+a8_bluetooth_publish(const uint8_t *address, uint32_t speed)
+{
+	IOService *platform = IOService::getPlatform();
+	A8Bluetooth *bt;
+	OSData *data;
+	uint32_t encoding = 1;
+
+	if (platform == NULL || address == NULL) {
+		return -1;
+	}
+	bt = OSTypeAlloc(A8Bluetooth);
+	if (bt == NULL || !bt->init()) {
+		OSSafeReleaseNULL(bt);
+		return -1;
+	}
+	if ((data = OSData::withBytes(address, 6)) != NULL) {
+		bt->setProperty("local-mac-address", data);
+		data->release();
+	}
+	if ((data = OSData::withBytes(&encoding, sizeof(encoding))) != NULL) {
+		bt->setProperty("transport-encoding", data);
+		data->release();
+	}
+	if ((data = OSData::withBytes(&speed, sizeof(speed))) != NULL) {
+		bt->setProperty("transport-speed", data);
+		data->release();
+	}
+	bt->setProperty("IOBuiltin", true);
+	if (!bt->attach(platform)) {
+		bt->release();
+		return -1;
+	}
+	bt->setName("bluetooth");
+	if (!bt->start(platform)) {
+		bt->detach(platform);
+		bt->release();
+		return -1;
+	}
+	bt->registerService();
+	bt->release();
+	IOLog("A8Bluetooth: \"bluetooth\" published (H4, %u)\n", speed);
+	return 0;
+}
+
+#endif  /* ARM64_BOARD_CONFIG_A5XELTE && JACKPOTLTE */
