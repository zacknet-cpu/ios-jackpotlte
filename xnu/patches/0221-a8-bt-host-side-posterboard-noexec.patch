+	reg.ctl_flags = CTL_FLAG_REG_SOCK_STREAM;
+	reg.ctl_sendsize = 64 << 10;
+	reg.ctl_recvsize = 256 << 10;
+	reg.ctl_connect = a5h4_connect;
+	reg.ctl_disconnect = a5h4_disconnect;
+	reg.ctl_send = a5h4_send;
+	reg.ctl_setopt = a5h4_setopt;
+	reg.ctl_getopt = a5h4_getopt;
+	e = ctl_register(&reg, &a5h4.ctl);
+	if (e != 0) {
+		printf("A5XELTE BT: host side: kernel control %s not registered (%d)\n",
+		    A5H4_CTL_NAME, e);
+		return;
+	}
+	if (a8_bluetooth_publish(a5bt.address, A5H4_SPEED) != 0) {
+		printf("A5XELTE BT: host side: the IOService \"bluetooth\" was not published\n");
+	}
+	printf("A5XELTE BT: host side ready: kernel control %s (H4), IOService \"bluetooth\"; "
+	    "vendor commands %s\n", A5H4_CTL_NAME,
+	    a5h4.vendor_on ? "go to the chip (a8btvendor=1)" : "answered here");
