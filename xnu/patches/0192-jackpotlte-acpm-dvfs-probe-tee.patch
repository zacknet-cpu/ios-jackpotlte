diff --git a/bsd/dev/a8_acpm.c b/bsd/dev/a8_acpm.c
new file mode 100644
index 0000000..dcfe453
--- /dev/null
+++ b/bsd/dev/a8_acpm.c
@@ -0,0 +1,1260 @@
+/*
+ * A8 2018 (Exynos 7885): the clocks of the CPU clusters and the GPU, through
+ * the power manager that owns them.
+ *
+ * The 7885 does not let the kernel write its DVFS clocks or voltages.  A
+ * Cortex-M0+ in the always-on block (the "APM") runs Samsung's ACPM firmware,
+ * which holds the frequency/voltage map of each domain, drives the PMIC over
+ * its own bus and reprograms the PLLs itself; the kernel asks for a rate over
+ * a mailbox and a few words of shared SRAM.  S-Boot starts the framework and
+ * its DVFS plug-in and leaves every domain at its boot level: the Mali-G71 at
+ * 343 MHz, the A73 pair at 1352 MHz, the A53s at 1014 MHz (read off this
+ * phone on 2026-11-23, session handoff section 11).  Nothing in XNU ever
+ * asked for more, which is the larger part of why the UI draws 10-19 frames
+ * a second.
+ *
+ * What stock Linux does, and this file repeats (Samsung's 7885 kernel,
+ * drivers/soc/samsung/acpm/acpm.c, acpm_ipc.c and cal-if/acpm_dvfs.c,
+ * fvmap.c; the structures are fw_header/framework.h and common.h):
+ *
+ *  - shared SRAM 0x02052000 (0x1b000), mailbox 0x11c40000; the framework's
+ *    description of itself ("initdata") is at SRAM + 0x4b80: where the
+ *    plug-in table and the IPC channel table are.
+ *  - A channel is two queues of 16-byte commands in the SRAM.  To send: put
+ *    the command at the AP->APM queue's front, advance the front, raise the
+ *    channel's bit in the mailbox (INTGR0, upper half).  The answer comes
+ *    back in the APM->AP queue with the same 6-bit sequence number, and the
+ *    channel's bit in INTSR1.
+ *  - Rates are asked for on channel 0 (the clock controller's): {domain,
+ *    kHz, FREQ_REQ}, and read back with {domain, 0, FREQ_GET}.  Domains:
+ *    0 MIF, 1 INT, 2 the A73s ("big"), 3 the A53s ("little"), 4 G3D.
+ *  - Channel 0 belongs to the plug-in "exynos7885_acpm_fvp.fw", and that one
+ *    S-Boot does not start: Linux copies it into the SRAM at boot (12288
+ *    bytes at SRAM + 0x7800, from the kernel's built-in firmware) and
+ *    attaches it over channel 4.  The same bytes are in this phone's own
+ *    stock BOOT image; "acpm fvp PATH" loads them from a file on the data
+ *    volume and checks length and CRC before a byte is written.
+ *
+ * Nothing here runs unless the boot-args say a8dvfs=1, and then only on a
+ * console command (a5xelte_usb.c): there is no automatic governor.  A rate
+ * has to be one of the firmware's own table and not above the stock limit of
+ * its domain; raising one needs a temperature reading below a8dvfstemp
+ * (default 80 C), and a thread takes every raised domain back to its boot
+ * rate when the SoC gets hotter than that.
+ *
+ * Never read the CPU clusters' clock blocks (0x10800000, 0x10900000,
+ * 0x10a00000) from here: the read is refused and was a panic (sleh.c,
+ * a8_probe_read32).  CPU rates come from FREQ_GET.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_A5XELTE) && defined(JACKPOTLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <string.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern bool a8_probe_read32(vm_offset_t va, uint32_t *value, uint32_t *esr);    /* sleh.c */
+extern int a8f_read_whole(const char *path, uint8_t *buf, uint32_t max, uint32_t *got,
+    uint32_t *crc);                                                             /* a8_files.c */
+
+void a8_acpm_command(const char *args);
+void a8_dvfs_command(const char *args);
+void a8_tmu_command(const char *args);
+
+/* ---- where things are ---- */
+#define A8A_SRAM_PA             0x02052000u     /* acpm_ipc reg[1] */
+#define A8A_SRAM_SIZE           0x1b000u
+#define A8A_MBOX_PA             0x11c40000u     /* acpm_ipc reg[0] */
+#define A8A_MBOX_SIZE           0x1000u
+#define A8A_INITDATA            0x4b80u         /* acpm_ipc initdata-base */
+#define A8A_FVMAP_AFTER         0x6c00u         /* acpm fvmap_offset, from the DVFS plug-in's base */
+
+/* mailbox (acpm_ipc.h) */
+#define A8A_INTGR0              0x08u           /* AP -> APM: bit (16 + channel) */
+#define A8A_INTCR1              0x20u           /* APM -> AP: clear */
+#define A8A_INTMR1              0x24u           /* APM -> AP: mask */
+#define A8A_INTSR1              0x28u           /* APM -> AP: raw status */
+#define A8A_INTGR1              0x1cu
+
+/* command word 0 (acpm_ipc_ctrl.h) */
+#define A8A_PROTO_ID_SHIFT      26
+#define A8A_PROTO_ATTACH        (1u << 25)
+#define A8A_PROTO_DETACH        (1u << 24)
+#define A8A_PROTO_SEQ_SHIFT     16
+#define A8A_PROTO_SEQ_MASK      (0x3fu << A8A_PROTO_SEQ_SHIFT)
+
+/* DVFS requests, command word 2 (acpm_dvfs.h) */
+#define A8A_FREQ_REQ            0u
+#define A8A_FREQ_GET            1u
+
+#define A8A_CH_DVFS             0u              /* clock-controller acpm-ipc-channel */
+#define A8A_CH_FRAMEWORK        4u              /* acpm acpm-ipc-channel */
+#define A8A_TYPE_QUEUE          1u
+
+#define A8A_IPC_TIMEOUT_MS      150u            /* acpm_ipc.h IPC_TIMEOUT */
+
+/* The FVP plug-in, as it is in this phone's stock BOOT image (0xd00170) and
+ * in firmware/exynos7885_acpm_fvp.fw.ihex of Samsung's kernel. */
+#define A8A_FVP_NAME            "exynos7885_acpm_fvp.fw"
+#define A8A_FVP_BYTES           12288u
+#define A8A_FVP_CRC             0x14f4d437u
+#define A8A_FVP_BASE            0x7800u
+#define A8A_DVFS_NAME           "exynos7885_acpm_dvfs.fw"
+
+#define A8A_PLUGINS_MAX         8u
+#define A8A_CHANNELS_MAX        16u
+#define A8A_PLUGIN_WORDS        11u
+#define A8A_CHANNEL_WORDS       18u
+
+/* ---- DVFS domains (acpm_dvfs_exynos7885.h) ---- */
+#define A8A_DOM_MIF             0u
+#define A8A_DOM_INT             1u
+#define A8A_DOM_BIG             2u
+#define A8A_DOM_LITTLE          3u
+#define A8A_DOM_G3D             4u
+#define A8A_DOMAINS             5u
+#define A8A_LEVELS_MAX          32u
+
+static const char *const a8a_dom_name[A8A_DOMAINS] = { "mif", "int", "big", "little", "g3d" };
+/* The most each domain may be asked for: the stock kernel's own ceilings
+ * (cpufreq domain tables in the device tree top out at 2184000 and 1690000;
+ * mali gpu_max_clock is 1100000).  The firmware's tables go further (2496,
+ * 2002, 1300 MHz); those entries are not for this phone.  0: not ours to set. */
+static const uint32_t a8a_dom_cap[A8A_DOMAINS] = { 0, 0, 2184000u, 1690000u, 1100000u };
+
+/* ---- TMU (exynos_tmu.c, exynos78XX; device tree BIG/LITTLE@10070000, G3D@10074000) ---- */
+#define A8T_CPU_PA              0x10070000u
+#define A8T_G3D_PA              0x10074000u
+#define A8T_TRIMINFO            0x00u
+#define A8T_CONTROL             0x20u
+#define A8T_STATUS              0x28u
+#define A8T_CURRENT_TEMP        0x40u           /* sensor 0 in bits 8:0 */
+#define A8T_CORE_EN             (1u << 0)
+#define A8T_EFUSE               0x13au          /* samsung,tmu_efuse_value */
+#define A8T_FIRST_POINT         25              /* samsung,tmu_first_point_trim */
+#define A8T_SECOND_POINT        85              /* samsung,tmu_second_point_trim */
+
+/* G3D PLL, to show what a request did (jackpotlte_mali.c reads the same). */
+#define A8A_PMU_PA              0x11c80000u
+#define A8A_PMU_G3D_STATUS      0x40a4u
+#define A8A_CMU_G3D_PA          0x11400000u
+#define A8A_G3D_PLL_CON0        0x0120u
+
+struct a8a_plugin {
+	uint32_t id, base, ops, attached, size, stay, name_off;
+	char     name[32];
+};
+
+struct a8a_channel {
+	uint32_t id, owner, type, poll, len, esize;
+	uint32_t ap_rear, ap_front, ap_base;            /* AP -> APM (the firmware's rx_*) */
+	uint32_t apm_rear, apm_front, apm_base;         /* APM -> AP (the firmware's tx_*) */
+	uint32_t seq;
+};
+
+struct a8a_domain {
+	bool     ok;
+	uint32_t levels, init_lv, table;                /* table: SRAM offset of {kHz, uV} pairs */
+	uint32_t boot_khz;
+	uint32_t asked_khz;                             /* 0: never asked */
+	bool     raised;
+};
+
+static struct {
+	bool                    ready, failed, mask_set;
+	uint32_t                allow;                  /* boot-arg a8dvfs */
+	uint32_t                temp_limit;             /* boot-arg a8dvfstemp, C */
+	volatile uint32_t      *sram;
+	volatile uint32_t      *mbox;
+	volatile uint32_t      *tmu_cpu, *tmu_g3d, *pmu, *cmu_g3d;
+	uint32_t                init[26];
+	uint32_t                nplug, nchan, nap;
+	struct a8a_plugin       plug[A8A_PLUGINS_MAX];
+	struct a8a_channel      chan[A8A_CHANNELS_MAX];
+	uint32_t                fvmap;                  /* SRAM offset, 0: not found */
+	struct a8a_domain       dom[A8A_DOMAINS];
+	bool                    watching, hot;
+	uint32_t                watch_ticks, tmu_misses;
+	int                     watch_chan;
+} a8a;
+
+static LCK_GRP_DECLARE(a8a_grp, "a8acpm");
+static LCK_MTX_DECLARE(a8a_lock, &a8a_grp);
+
+/* ---- the shared SRAM ---- */
+static bool
+a8a_in(uint32_t off, uint32_t len)
+{
+	return (off & 3u) == 0 && off < A8A_SRAM_SIZE && len <= A8A_SRAM_SIZE - off;
+}
+
+static uint32_t
+a8a_rd(uint32_t off)
+{
+	if (a8a.sram == NULL || !a8a_in(off, 4)) {
+		return 0;
+	}
+	return a8a.sram[off >> 2];
+}
+
+static void
+a8a_wr(uint32_t off, uint32_t value)
+{
+	if (a8a.sram != NULL && a8a_in(off, 4)) {
+		a8a.sram[off >> 2] = value;
+	}
+}
+
+static uint32_t
+a8a_rd8(uint32_t off)
+{
+	return (a8a_rd(off & ~3u) >> ((off & 3u) * 8u)) & 0xffu;
+}
+
+static uint32_t
+a8a_rd16(uint32_t off)
+{
+	return a8a_rd8(off) | (a8a_rd8(off + 1) << 8);
+}
+
+static uint32_t
+a8a_mb(uint32_t reg)
+{
+	return a8a.mbox[reg >> 2];
+}
+
+static void
+a8a_mb_wr(uint32_t reg, uint32_t value)
+{
+	a8a.mbox[reg >> 2] = value;
+}
+
+/* Whether s contains sub (the kernel has no strstr). */
+static bool
+a8a_has(const char *s, const char *sub)
+{
+	size_t n = strlen(sub);
+
+	for (; *s; s++) {
+		if (strncmp(s, sub, n) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* ---- the framework's tables ---- */
+static void
+a8a_read_plugins(void)
+{
+	for (uint32_t i = 0; i < a8a.nplug; i++) {
+		uint32_t at = a8a.init[0] + i * A8A_PLUGIN_WORDS * 4u;
+		struct a8a_plugin *p = &a8a.plug[i];
+
+		p->id = a8a_rd(at);
+		p->base = a8a_rd(at + 4);
+		p->ops = a8a_rd(at + 12);
+		p->attached = a8a_rd(at + 28) & 0xffu;
+		p->size = a8a_rd(at + 32);
+		p->stay = a8a_rd(at + 36) & 0xffu;
+		p->name_off = a8a_rd(at + 40);
+		p->name[0] = 0;
+		if (p->name_off != 0 && a8a_in(p->name_off & ~3u, sizeof(p->name))) {
+			for (uint32_t k = 0; k < sizeof(p->name) - 1; k++) {
+				char c = (char)a8a_rd8(p->name_off + k);
+				if (c < 0x20 || c > 0x7e) {
+					c = 0;
+				}
+				p->name[k] = c;
+				p->name[k + 1] = 0;
+				if (c == 0) {
+					break;
+				}
+			}
+		}
+	}
+}
+
+static struct a8a_plugin *
+a8a_plugin_named(const char *name)
+{
+	for (uint32_t i = 0; i < a8a.nplug; i++) {
+		if (strcmp(a8a.plug[i].name, name) == 0) {
+			return &a8a.plug[i];
+		}
+	}
+	return NULL;
+}
+
+static struct a8a_channel *
+a8a_channel(uint32_t id)
+{
+	for (uint32_t i = 0; i < a8a.nap; i++) {
+		if (a8a.chan[i].id == id) {
+			return &a8a.chan[i];
+		}
+	}
+	return NULL;
+}
+
+/*
+ * The frequency/voltage map behind the DVFS plug-in (fvmap.h): one 24-byte
+ * header a domain, then {kHz, uV} pairs, fastest first.
+ */
+static void
+a8a_read_fvmap(void)
+{
+	struct a8a_plugin *dvfs = a8a_plugin_named(A8A_DVFS_NAME);
+
+	a8a.fvmap = 0;
+	for (uint32_t d = 0; d < A8A_DOMAINS; d++) {
+		a8a.dom[d].ok = false;
+	}
+	if (dvfs == NULL || !dvfs->attached) {
+		return;
+	}
+	uint32_t base = (dvfs->base & ~1u) + A8A_FVMAP_AFTER;
+	if (!a8a_in(base, 0x800)) {
+		return;
+	}
+	for (uint32_t d = 0; d < A8A_DOMAINS; d++) {
+		uint32_t h = base + d * 24u;
+		struct a8a_domain *dom = &a8a.dom[d];
+		uint32_t levels = a8a_rd8(h + 1);
+		uint32_t init_lv = a8a_rd8(h + 8);
+		uint32_t table = base + a8a_rd16(h + 20);
+		uint32_t last = 0xffffffffu;
+		bool ok = a8a_rd8(h) == d && levels >= 1 && levels <= A8A_LEVELS_MAX &&
+		    init_lv < levels && a8a_in(table, levels * 8u);
+
+		for (uint32_t i = 0; ok && i < levels; i++) {
+			uint32_t khz = a8a_rd(table + i * 8u);
+			uint32_t uv = a8a_rd(table + i * 8u + 4);
+
+			/* fastest first, and volts a PMIC buck can make */
+			if (khz == 0 || khz >= last || uv < 400000u || uv > 1400000u) {
+				ok = false;
+			}
+			last = khz;
+		}
+		if (!ok) {
+			printf("A8A: fvmap domain %u (%s) does not look like one: type %u, %u levels, "
+			    "init %u, table 0x%x\n", d, a8a_dom_name[d], a8a_rd8(h), levels, init_lv, table);
+			continue;
+		}
+		dom->levels = levels;
+		dom->init_lv = init_lv;
+		dom->table = table;
+		dom->boot_khz = a8a_rd(table + init_lv * 8u);
+		dom->ok = true;
+	}
+	a8a.fvmap = base;
+}
+
+static bool
+a8a_init(void)
+{
+	if (a8a.ready) {
+		return true;
+	}
+	if (a8a.failed) {
+		return false;
+	}
+	a8a.temp_limit = 80;
+	(void)PE_parse_boot_argn("a8dvfs", &a8a.allow, sizeof(a8a.allow));
+	(void)PE_parse_boot_argn("a8dvfstemp", &a8a.temp_limit, sizeof(a8a.temp_limit));
+	if (a8a.temp_limit < 40 || a8a.temp_limit > 95) {
+		a8a.temp_limit = 80;
+	}
+	a8a.sram = (volatile uint32_t *)ml_io_map(A8A_SRAM_PA, A8A_SRAM_SIZE);
+	a8a.mbox = (volatile uint32_t *)ml_io_map(A8A_MBOX_PA, A8A_MBOX_SIZE);
+	if (a8a.sram == NULL || a8a.mbox == NULL) {
+		printf("A8A: cannot map the power manager's SRAM or mailbox\n");
+		a8a.failed = true;
+		return false;
+	}
+	for (uint32_t i = 0; i < 26; i++) {
+		a8a.init[i] = a8a_rd(A8A_INITDATA + i * 4u);
+	}
+	a8a.nplug = a8a.init[1];
+	a8a.nchan = a8a.init[3];
+	a8a.nap = a8a.init[6];
+	if (a8a.nplug == 0 || a8a.nplug > A8A_PLUGINS_MAX || a8a.nchan == 0 ||
+	    a8a.nchan > A8A_CHANNELS_MAX || a8a.nap == 0 || a8a.nap > a8a.nchan ||
+	    !a8a_in(a8a.init[0], a8a.nplug * A8A_PLUGIN_WORDS * 4u) ||
+	    !a8a_in(a8a.init[2], a8a.nchan * A8A_CHANNEL_WORDS * 4u)) {
+		printf("A8A: no ACPM framework at SRAM + 0x%x: plugins 0x%x x %u, channels 0x%x x %u, "
+		    "%u for the AP\n", A8A_INITDATA, a8a.init[0], a8a.nplug, a8a.init[2], a8a.nchan,
+		    a8a.nap);
+		a8a.failed = true;
+		return false;
+	}
+	a8a_read_plugins();
+	for (uint32_t i = 0; i < a8a.nchan; i++) {
+		uint32_t at = a8a.init[2] + i * A8A_CHANNEL_WORDS * 4u;
+		struct a8a_channel *c = &a8a.chan[i];
+
+		c->id = a8a_rd(at);
+		c->owner = a8a_rd(at + 8);
+		c->type = a8a_rd(at + 12);
+		c->ap_rear = a8a_rd(at + 16);
+		c->ap_front = a8a_rd(at + 20);
+		c->ap_base = a8a_rd(at + 24);
+		c->apm_rear = a8a_rd(at + 40);
+		c->apm_front = a8a_rd(at + 44);
+		c->apm_base = a8a_rd(at + 48);
+		c->len = a8a_rd(at + 52);
+		c->esize = a8a_rd(at + 56);
+		c->poll = a8a_rd(at + 68);
+		c->seq = 0;
+	}
+	a8a_read_fvmap();
+	a8a.ready = true;
+	return true;
+}
+
+/* ---- IPC (acpm_ipc.c: acpm_ipc_send_data, check_response) ---- */
+static bool
+a8a_channel_usable(const struct a8a_channel *c)
+{
+	return c != NULL && c->type == A8A_TYPE_QUEUE && c->poll == 1 && c->esize == 16 &&
+	       c->len >= 2 && c->len <= 64 && c->id < 16 &&
+	       a8a_in(c->ap_rear, 4) && a8a_in(c->ap_front, 4) && a8a_in(c->ap_base, c->len * 16u) &&
+	       a8a_in(c->apm_rear, 4) && a8a_in(c->apm_front, 4) && a8a_in(c->apm_base, c->len * 16u);
+}
+
+/* The answer with our sequence number, if it is in the APM->AP queue. */
+static bool
+a8a_take_answer(struct a8a_channel *c, uint32_t cmd[4])
+{
+	uint32_t front = a8a_rd(c->apm_front);
+	uint32_t rear = a8a_rd(c->apm_rear);
+	uint32_t want = cmd[0] & A8A_PROTO_SEQ_MASK;
+
+	if (front >= c->len || rear >= c->len) {
+		return false;
+	}
+	for (uint32_t i = rear; i != front; i = (i + 1) % c->len) {
+		uint32_t at = c->apm_base + i * 16u;
+
+		if ((a8a_rd(at) & A8A_PROTO_SEQ_MASK) != want) {
+			continue;
+		}
+		for (uint32_t k = 0; k < 4; k++) {
+			cmd[k] = a8a_rd(at + k * 4u);
+		}
+		/* Take it out: the oldest entry moves into its place. */
+		if (i != rear) {
+			for (uint32_t k = 0; k < 4; k++) {
+				a8a_wr(at + k * 4u, a8a_rd(c->apm_base + rear * 16u + k * 4u));
+			}
+		}
+		rear = (rear + 1) % c->len;
+		a8a_wr(c->apm_rear, rear);
+		if (rear == a8a_rd(c->apm_front)) {
+			a8a_mb_wr(A8A_INTCR1, 1u << c->id);
+			if (rear != a8a_rd(c->apm_front)) {
+				a8a_mb_wr(A8A_INTGR1, 1u << c->id);
+			}
+		}
+		return true;
+	}
+	return false;
+}
+
+/*
+ * One command and its answer.  cmd comes back as the answer.  0, or EINVAL
+ * (no such queue), ENOSPC (the queue stayed full), ETIMEDOUT (no answer).
+ * Called with a8a_lock held.
+ */
+static int
+a8a_ipc(uint32_t id, uint32_t cmd[4])
+{
+	struct a8a_channel *c = a8a_channel(id);
+	uint64_t deadline;
+	uint32_t front, next;
+
+	if (!a8a_channel_usable(c)) {
+		printf("A8A: channel %u is not a polled queue of 16-byte commands\n", id);
+		return EINVAL;
+	}
+	if (!a8a.mask_set) {
+		/* channel_init(): the channels the AP polls do not interrupt it. */
+		uint32_t mask = 0;
+
+		for (uint32_t i = 0; i < a8a.nap; i++) {
+			if (a8a.chan[i].poll == 1 && a8a.chan[i].id < 16) {
+				mask |= 1u << a8a.chan[i].id;
+			}
+		}
+		a8a_mb_wr(A8A_INTMR1, mask);
+		a8a.mask_set = true;
+	}
+	/*
+	 * Answers nobody is waiting for any more (a command that timed out and
+	 * was answered late): one caller at a time uses a channel here, so
+	 * whatever is in the APM->AP queue now is stale.  Left there, they
+	 * would fill it and the firmware could not answer again.
+	 */
+	{
+		uint32_t stale_rear = a8a_rd(c->apm_rear), stale_front = a8a_rd(c->apm_front);
+		uint32_t dropped = 0;
+
+		while (stale_rear < c->len && stale_front < c->len && stale_rear != stale_front &&
+		    dropped < c->len) {
+			printf("A8A: channel %u: dropping a late answer 0x%08x 0x%x 0x%x 0x%x\n", id,
+			    a8a_rd(c->apm_base + stale_rear * 16u), a8a_rd(c->apm_base + stale_rear * 16u + 4),
+			    a8a_rd(c->apm_base + stale_rear * 16u + 8),
+			    a8a_rd(c->apm_base + stale_rear * 16u + 12));
+			stale_rear = (stale_rear + 1) % c->len;
+			a8a_wr(c->apm_rear, stale_rear);
+			stale_front = a8a_rd(c->apm_front);
+			dropped++;
+		}
+		if (dropped != 0 && stale_rear == a8a_rd(c->apm_front)) {
+			a8a_mb_wr(A8A_INTCR1, 1u << c->id);
+		}
+	}
+	front = a8a_rd(c->ap_front);
+	if (front >= c->len) {
+		printf("A8A: channel %u front %u is past its %u entries\n", id, front, c->len);
+		return EINVAL;
+	}
+	next = (front + 1) % c->len;
+	clock_interval_to_deadline(A8A_IPC_TIMEOUT_MS, NSEC_PER_MSEC, &deadline);
+	while (next == a8a_rd(c->ap_rear)) {
+		if (mach_absolute_time() > deadline) {
+			printf("A8A: channel %u stayed full (rear %u front %u): the plug-in behind it "
+			    "is not taking commands\n", id, a8a_rd(c->ap_rear), front);
+			return ENOSPC;
+		}
+		delay(50);
+	}
+	if (++c->seq == 64) {
+		c->seq = 1;
+	}
+	cmd[0] = (cmd[0] & ~A8A_PROTO_SEQ_MASK) | (c->seq << A8A_PROTO_SEQ_SHIFT);
+	for (uint32_t k = 0; k < 4; k++) {
+		a8a_wr(c->ap_base + front * 16u + k * 4u, cmd[k]);
+	}
+	cmd[1] = cmd[2] = cmd[3] = 0;
+	a8a_wr(c->ap_front, next);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a8a_mb_wr(A8A_INTGR0, (1u << c->id) << 16);
+
+	clock_interval_to_deadline(A8A_IPC_TIMEOUT_MS, NSEC_PER_MSEC, &deadline);
+	for (;;) {
+		if ((a8a_mb(A8A_INTSR1) & (1u << c->id)) != 0 && a8a_take_answer(c, cmd)) {
+			return 0;
+		}
+		if (mach_absolute_time() > deadline) {
+			if (a8a_take_answer(c, cmd)) {
+				return 0;
+			}
+			printf("A8A: channel %u: no answer in %u ms (seq %u; INTSR1 0x%x; AP->APM rear %u "
+			    "front %u; APM->AP rear %u front %u)\n", id, A8A_IPC_TIMEOUT_MS, c->seq,
+			    a8a_mb(A8A_INTSR1), a8a_rd(c->ap_rear), a8a_rd(c->ap_front),
+			    a8a_rd(c->apm_rear), a8a_rd(c->apm_front));
+			return ETIMEDOUT;
+		}
+		delay(50);
+	}
+}
+
+/* ---- the firmware's own log (acpm_ipc.c acpm_log_print) ---- */
+static void
+a8a_log_dump(void)
+{
+	uint32_t rear_at = a8a.init[13], front_at = a8a.init[14], base = a8a.init[15];
+	uint32_t esize = a8a.init[16], len = a8a.init[17];
+	uint32_t front, rear, waiting, shown = 0;
+
+	if (esize != 16 || len == 0 || len > 4096 || !a8a_in(rear_at, 4) || !a8a_in(front_at, 4) ||
+	    !a8a_in(base, len * esize)) {
+		printf("A8A LOG: no log buffer (base 0x%x, %u x %u bytes)\n", base, len, esize);
+		return;
+	}
+	front = a8a_rd(front_at);
+	rear = a8a_rd(rear_at);
+	if (front >= len || rear >= len) {
+		printf("A8A LOG: rear %u front %u are past %u entries\n", rear, front, len);
+		return;
+	}
+	waiting = (front + len - rear) % len;
+	printf("A8A LOG: %u entries waiting (the last 64 are shown)\n", waiting);
+	while (rear != front) {
+		if (waiting <= 64) {
+			uint32_t at = base + rear * esize;
+			uint32_t head = a8a_rd(at);
+			char text[9];
+
+			for (uint32_t k = 0; k < 8; k++) {
+				char ch = (char)a8a_rd8(at + 4 + k);
+				text[k] = (ch >= 0x20 && ch <= 0x7e) ? ch : (ch == 0 ? 0 : '?');
+			}
+			text[8] = 0;
+			printf("A8A LOG: plugin %u tick %u %s 0x%x\n", head >> 29, head & 0x7fffffu, text,
+			    a8a_rd(at + 12));
+			shown++;
+		}
+		waiting--;
+		rear = (rear + 1) % len;
+	}
+	a8a_wr(rear_at, rear);
+	printf("A8A LOG: end (%u shown)\n", shown);
+}
+
+/* ---- status ---- */
+static void
+a8a_status(void)
+{
+	a8a_read_plugins();
+	printf("A8A: framework at SRAM + 0x%x: %u plug-ins at 0x%x, %u channels at 0x%x (%u for the "
+	    "AP), IPC area 0x%x, framework 0x%x bytes; a8dvfs=%u, limit %u C\n", A8A_INITDATA,
+	    a8a.nplug, a8a.init[0], a8a.nchan, a8a.init[2], a8a.nap, a8a.init[18], a8a.init[21],
+	    a8a.allow, a8a.temp_limit);
+	for (uint32_t i = 0; i < a8a.nplug; i++) {
+		const struct a8a_plugin *p = &a8a.plug[i];
+
+		printf("A8A: plug-in %u: base 0x%x size 0x%x ops 0x%x attached %u stay %u %s\n", p->id,
+		    p->base & ~1u, p->size, p->ops, p->attached, p->stay,
+		    p->name[0] ? p->name : "(built in)");
+	}
+	for (uint32_t i = 0; i < a8a.nap; i++) {
+		const struct a8a_channel *c = &a8a.chan[i];
+
+		printf("A8A: channel %u: owner 0x%x %s %s, %u x %u bytes; AP->APM rear %u front %u; "
+		    "APM->AP rear %u front %u\n", c->id, c->owner,
+		    c->type == A8A_TYPE_QUEUE ? "queue" : "buffer", c->poll ? "polled" : "interrupt",
+		    c->len, c->esize, a8a_rd(c->ap_rear), a8a_rd(c->ap_front), a8a_rd(c->apm_rear),
+		    a8a_rd(c->apm_front));
+	}
+	printf("A8A: mailbox INTMR1 0x%x INTSR1 0x%x; fvmap at SRAM + 0x%x\n", a8a_mb(A8A_INTMR1),
+	    a8a_mb(A8A_INTSR1), a8a.fvmap);
+}
+
+/* ---- loading the FVP plug-in (acpm.c plugins_init, handle_dynamic_plugin) ---- */
+static void
+a8a_fvp_load(const char *path)
+{
+	struct a8a_plugin *fvp;
+	uint32_t got = 0, crc = 0, base, cmd[4];
+	uint8_t *buf;
+	int error;
+
+	a8a_read_plugins();
+	fvp = a8a_plugin_named(A8A_FVP_NAME);
+	if (fvp == NULL) {
+		printf("A8A FVP: the framework lists no plug-in named %s\n", A8A_FVP_NAME);
+		return;
+	}
+	if (fvp->attached) {
+		printf("A8A FVP: plug-in %u is attached already (ops 0x%x)\n", fvp->id, fvp->ops);
+		return;
+	}
+	base = fvp->base & ~1u;
+	if (!fvp->stay || base != A8A_FVP_BASE || fvp->size != A8A_FVP_BYTES ||
+	    !a8a_in(base, A8A_FVP_BYTES)) {
+		printf("A8A FVP: plug-in %u is not where this phone had it: base 0x%x size 0x%x "
+		    "stay %u (want 0x%x, 0x%x, 1); nothing written\n", fvp->id, base, fvp->size,
+		    fvp->stay, A8A_FVP_BASE, A8A_FVP_BYTES);
+		return;
+	}
+	/* Its room must not be anyone else's. */
+	for (uint32_t i = 0; i < a8a.nplug; i++) {
+		const struct a8a_plugin *p = &a8a.plug[i];
+		uint32_t pb = p->base & ~1u;
+
+		if (p != fvp && p->attached && p->size != 0 && pb < base + A8A_FVP_BYTES &&
+		    base < pb + p->size) {
+			printf("A8A FVP: its room 0x%x-0x%x is inside attached plug-in %u (0x%x-0x%x); "
+			    "nothing written\n", base, base + A8A_FVP_BYTES, p->id, pb, pb + p->size);
+			return;
+		}
+	}
+	if (!a8a_channel_usable(a8a_channel(A8A_CH_FRAMEWORK))) {
+		printf("A8A FVP: the framework's channel %u is not usable; nothing written\n",
+		    A8A_CH_FRAMEWORK);
+		return;
+	}
+	buf = kalloc_data(A8A_FVP_BYTES, Z_WAITOK | Z_ZERO);
+	if (buf == NULL) {
+		printf("A8A FVP: no memory\n");
+		return;
+	}
+	error = a8f_read_whole(path, buf, A8A_FVP_BYTES, &got, &crc);
+	if (error || got != A8A_FVP_BYTES || crc != A8A_FVP_CRC) {
+		printf("A8A FVP: %s: error %d, %u bytes, crc %08x; want %u bytes, crc %08x; nothing "
+		    "written\n", path, error, got, crc, A8A_FVP_BYTES, A8A_FVP_CRC);
+		kfree_data(buf, A8A_FVP_BYTES);
+		return;
+	}
+	printf("A8A FVP: %s is the plug-in (%u bytes, crc %08x); its room at SRAM + 0x%x starts "
+	    "0x%08x 0x%08x\n", path, got, crc, base, a8a_rd(base), a8a_rd(base + 4));
+	for (uint32_t off = 0; off < A8A_FVP_BYTES; off += 4) {
+		uint32_t word;
+
+		memcpy(&word, buf + off, 4);
+		a8a_wr(base + off, word);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t off = 0; off < A8A_FVP_BYTES; off += 4) {
+		uint32_t word;
+
+		memcpy(&word, buf + off, 4);
+		if (a8a_rd(base + off) != word) {
+			printf("A8A FVP: SRAM + 0x%x reads 0x%08x, not 0x%08x: not attached\n", base + off,
+			    a8a_rd(base + off), word);
+			kfree_data(buf, A8A_FVP_BYTES);
+			return;
+		}
+	}
+	kfree_data(buf, A8A_FVP_BYTES);
+
+	cmd[0] = A8A_PROTO_ATTACH | (fvp->id << A8A_PROTO_ID_SHIFT);
+	cmd[1] = cmd[2] = cmd[3] = 0;
+	error = a8a_ipc(A8A_CH_FRAMEWORK, cmd);
+	a8a_read_plugins();
+	printf("A8A FVP: attach %s: answer 0x%08x 0x%x 0x%x 0x%x; plug-in %u attached %u ops 0x%x\n",
+	    error ? "FAILED" : "sent", cmd[0], cmd[1], cmd[2], cmd[3], fvp->id, fvp->attached,
+	    fvp->ops);
+	if (!error && fvp->attached) {
+		printf("A8A FVP: attached; \"dvfs\" now reads the rates\n");
+	}
+}
