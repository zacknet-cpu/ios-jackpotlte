+/*
+ * The whole of a small file for the kernel's own use (a8_acpm.c loads the
+ * power manager's plug-in from the data volume): at most max bytes into buf,
+ * the count and the CRC-32 back.  An errno, or 0.
+ */
+int a8f_read_whole(const char *path, uint8_t *buf, uint32_t max, uint32_t *got, uint32_t *crc);
+
+int
+a8f_read_whole(const char *path, uint8_t *buf, uint32_t max, uint32_t *got, uint32_t *crc)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int resid = 0;
+	int error;
+
+	*got = 0;
+	*crc = 0;
+	error = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	if (vnode_vtype(vp) != VREG) {
+		vnode_close(vp, FREAD, ctx);
+		return EINVAL;
+	}
+	(void)vnode_size(vp, &size, ctx);
+	if (size <= 0 || (uint64_t)size > (uint64_t)max) {
+		vnode_close(vp, FREAD, ctx);
+		return EFBIG;
+	}
+	error = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)size, 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	vnode_close(vp, FREAD, ctx);
+	if (error) {
+		return error;
+	}
+	if (resid != 0) {
+		return EIO;
+	}
+	*got = (uint32_t)size;
