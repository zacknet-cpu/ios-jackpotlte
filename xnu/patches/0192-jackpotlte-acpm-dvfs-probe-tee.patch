+/* ---- temperature ---- */
+static void
+a8t_map(void)
+{
+	if (a8a.tmu_cpu == NULL) {
+		a8a.tmu_cpu = (volatile uint32_t *)ml_io_map(A8T_CPU_PA, 0x1000);
+		a8a.tmu_g3d = (volatile uint32_t *)ml_io_map(A8T_G3D_PA, 0x1000);
+		a8a.pmu = (volatile uint32_t *)ml_io_map(A8A_PMU_PA, 0x10000);
+		a8a.cmu_g3d = (volatile uint32_t *)ml_io_map(A8A_CMU_G3D_PA, 0x1000);
+	}
+}
+
+/*
+ * One sensor block: degrees C, or false with why in raw[]/esr.  raw is
+ * {TRIMINFO, CONTROL, STATUS, CURRENT_TEMP}.
+ */
+static bool
+a8t_read(volatile uint32_t *base, int *celsius, uint32_t raw[4], uint32_t *esr)
+{
+	static const uint32_t regs[4] = { A8T_TRIMINFO, A8T_CONTROL, A8T_STATUS, A8T_CURRENT_TEMP };
+	int code, e1, e2, temp;
+
+	*esr = 0;
+	raw[0] = raw[1] = raw[2] = raw[3] = 0;
+	if (base == NULL) {
+		return false;
+	}
+	for (int i = 0; i < 4; i++) {
+		if (!a8_probe_read32((vm_offset_t)&base[regs[i] >> 2], &raw[i], esr)) {
+			return false;
+		}
+	}
+	code = (int)(raw[3] & 0x1ffu);
+	if ((raw[1] & A8T_CORE_EN) == 0 || code == 0) {
+		return false;
+	}
+	e1 = (int)(raw[0] & 0x1ffu);
+	e2 = (int)((raw[0] >> 9) & 0x1ffu);
+	if (e1 == 0) {
+		e1 = (int)(A8T_EFUSE & 0x1ffu);
+	}
+	if (((raw[0] >> 23) & 1u) != 0 && e2 > e1) {
+		temp = (code - e1) * (A8T_SECOND_POINT - A8T_FIRST_POINT) / (e2 - e1) + A8T_FIRST_POINT;
+	} else {
+		temp = code - e1 + A8T_FIRST_POINT;
+	}
+	if (temp < -20 || temp > 150) {
+		return false;
+	}
+	*celsius = temp;
+	return true;
+}
+
+/* The hotter of the two sensors; false when neither reads. */
+static bool
+a8t_hottest(int *celsius, int *cpu, int *g3d)
+{
+	uint32_t raw[4], esr;
+	bool have_cpu, have_g3d;
+
+	a8t_map();
+	*cpu = *g3d = -1;
+	have_cpu = a8t_read(a8a.tmu_cpu, cpu, raw, &esr);
+	have_g3d = a8t_read(a8a.tmu_g3d, g3d, raw, &esr);
+	if (!have_cpu && !have_g3d) {
+		return false;
+	}
+	*celsius = (have_cpu && (!have_g3d || *cpu >= *g3d)) ? *cpu : *g3d;
+	return true;
+}
+
+/* ---- DVFS ---- */
+static bool
+a8a_fvp_attached(void)
+{
+	struct a8a_plugin *fvp;
+
+	a8a_read_plugins();
+	fvp = a8a_plugin_named(A8A_FVP_NAME);
+	return fvp != NULL && fvp->attached;
+}
+
+static int
+a8a_get_rate(uint32_t domain, uint32_t *khz)
+{
+	uint32_t cmd[4] = { domain, 0, A8A_FREQ_GET, 0 };
+	int error = a8a_ipc(A8A_CH_DVFS, cmd);
+
+	*khz = error ? 0 : cmd[1];
+	return error;
+}
+
+static int
+a8a_set_rate(uint32_t domain, uint32_t khz, uint32_t answer[4])
+{
+	uint32_t cmd[4] = { domain, khz, A8A_FREQ_REQ, 0 };
+	int error = a8a_ipc(A8A_CH_DVFS, cmd);
+
+	for (int k = 0; k < 4; k++) {
+		answer[k] = cmd[k];
+	}
+	return error;
+}
+
+/* The G3D PLL as the clock block has it now, in kHz; 0: not readable. */
+static uint32_t
+a8a_g3d_pll_khz(uint32_t *con0)
+{
+	uint32_t status = 0, con = 0, esr = 0, m, p, s;
+
+	a8t_map();
+	*con0 = 0;
+	if (a8a.pmu == NULL || a8a.cmu_g3d == NULL ||
+	    !a8_probe_read32((vm_offset_t)&a8a.pmu[A8A_PMU_G3D_STATUS >> 2], &status, &esr) ||
+	    (status & 0xfu) != 0xfu ||
+	    !a8_probe_read32((vm_offset_t)&a8a.cmu_g3d[A8A_G3D_PLL_CON0 >> 2], &con, &esr)) {
+		return 0;
+	}
+	*con0 = con;
+	m = (con >> 16) & 0x3ffu;
+	p = (con >> 8) & 0x3fu;
+	s = con & 0x7u;
+	if (p == 0) {
+		return 0;
+	}
+	return (uint32_t)((26000ull * m / p) >> s);
+}
+
+static void
+a8a_dvfs_table(uint32_t d)
+{
+	const struct a8a_domain *dom = &a8a.dom[d];
+
+	if (!dom->ok) {
+		printf("A8 DVFS: %s: no table\n", a8a_dom_name[d]);
+		return;
+	}
+	for (uint32_t i = 0; i < dom->levels; i++) {
+		uint32_t khz = a8a_rd(dom->table + i * 8u);
+
+		printf("A8 DVFS: %s level %u: %u kHz at %u uV%s%s\n", a8a_dom_name[d], i, khz,
+		    a8a_rd(dom->table + i * 8u + 4), i == dom->init_lv ? " (boot)" : "",
+		    (a8a_dom_cap[d] != 0 && khz > a8a_dom_cap[d]) ? " (above the stock limit)" : "");
+	}
+}
+
+static void
+a8a_dvfs_report(const char *why)
+{
+	bool attached = a8a_fvp_attached();
+	char line[400];
+	int len, hot = 0, cpu = -1, g3d = -1;
+	uint32_t con0 = 0, pll;
+
+	len = snprintf(line, sizeof(line), "A8 DVFS (%s):", why);
+	for (uint32_t d = 0; d < A8A_DOMAINS && len < (int)sizeof(line) - 60; d++) {
+		const struct a8a_domain *dom = &a8a.dom[d];
+		uint32_t khz = 0;
+
+		if (attached && a8a_get_rate(d, &khz) == 0) {
+			len += snprintf(line + len, sizeof(line) - len, " %s %u", a8a_dom_name[d], khz);
+		} else if (dom->ok) {
+			len += snprintf(line + len, sizeof(line) - len, " %s boot %u", a8a_dom_name[d],
+			    dom->boot_khz);
+		} else {
+			len += snprintf(line + len, sizeof(line) - len, " %s ?", a8a_dom_name[d]);
+		}
+	}
+	pll = a8a_g3d_pll_khz(&con0);
+	len += snprintf(line + len, sizeof(line) - len, " kHz; G3D PLL %u kHz (0x%x)", pll, con0);
+	if (a8t_hottest(&hot, &cpu, &g3d)) {
+		len += snprintf(line + len, sizeof(line) - len, "; %d C cpu, %d C g3d", cpu, g3d);
+	} else {
+		len += snprintf(line + len, sizeof(line) - len, "; no temperature");
+	}
+	printf("%s%s\n", line, attached ? "" : "; FVP plug-in not attached, rates are the boot levels");
+}
+
+static void
+a8a_watch_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		uint64_t deadline;
+		int hot = 0, cpu = -1, g3d = -1;
+		bool any = false, have;
+
+		clock_interval_to_deadline(2, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&a8a.watch_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+
+		lck_mtx_lock(&a8a_lock);
+		for (uint32_t d = 0; d < A8A_DOMAINS; d++) {
+			any = any || a8a.dom[d].raised;
+		}
+		have = a8t_hottest(&hot, &cpu, &g3d);
+		if (have) {
+			a8a.tmu_misses = 0;
+			if (a8a.hot && hot + 10 <= (int)a8a.temp_limit) {
+				a8a.hot = false;
+				printf("A8 DVFS: %d C, cool enough to raise a clock again\n", hot);
+			}
+		} else if (any) {
+			a8a.tmu_misses++;
+		}
+		if (any && ((have && hot >= (int)a8a.temp_limit) ||
+		    (!have && a8a.tmu_misses >= 3 && a8a.allow < 2))) {
+			if (have) {
+				printf("A8 DVFS: %d C (cpu %d, g3d %d) is at the %u C limit: back to the boot "
+				    "rates\n", hot, cpu, g3d, a8a.temp_limit);
+			} else {
+				printf("A8 DVFS: the temperature stopped reading: back to the boot rates\n");
+			}
+			for (uint32_t d = 0; d < A8A_DOMAINS; d++) {
+				struct a8a_domain *dom = &a8a.dom[d];
+				uint32_t answer[4];
+
+				if (!dom->raised) {
+					continue;
+				}
+				if (a8a_set_rate(d, dom->boot_khz, answer) == 0) {
+					dom->raised = false;
+					dom->asked_khz = dom->boot_khz;
+				} else {
+					printf("A8 DVFS: %s did not take %u kHz back\n", a8a_dom_name[d],
+					    dom->boot_khz);
+				}
+			}
+			a8a.hot = true;
+			a8a_dvfs_report("after the limit");
+		} else if (any && ++a8a.watch_ticks % 15 == 0) {
+			a8a_dvfs_report("every 30 s");
+		}
+		lck_mtx_unlock(&a8a_lock);
+	}
+}
+
+static void
+a8a_dvfs_set(uint32_t d, uint32_t khz)
+{
+	struct a8a_domain *dom = &a8a.dom[d];
+	uint32_t now = 0, after = 0, answer[4], uv = 0;
+	int hot = 0, cpu = -1, g3d = -1;
+	bool listed = false, have_temp;
+	int error;
+
+	if (a8a.allow == 0) {
+		printf("A8 DVFS: off; boot with a8dvfs=1 to allow rate requests\n");
+		return;
+	}
+	if (a8a_dom_cap[d] == 0 || !dom->ok) {
+		printf("A8 DVFS: %s is not a domain to set from here (big, little, g3d)\n",
+		    a8a_dom_name[d]);
+		return;
+	}
+	if (!a8a_fvp_attached()) {
+		printf("A8 DVFS: the FVP plug-in is not attached (acpm fvp PATH first)\n");
+		return;
+	}
+	for (uint32_t i = 0; i < dom->levels; i++) {
+		if (a8a_rd(dom->table + i * 8u) == khz) {
+			listed = true;
+			uv = a8a_rd(dom->table + i * 8u + 4);
+		}
+	}
+	if (!listed) {
+		printf("A8 DVFS: %u kHz is not a level of %s (dvfs table %s)\n", khz, a8a_dom_name[d],
+		    a8a_dom_name[d]);
+		return;
+	}
+	if (khz > a8a_dom_cap[d]) {
+		printf("A8 DVFS: %u kHz is above the stock limit of %s, %u kHz\n", khz,
+		    a8a_dom_name[d], a8a_dom_cap[d]);
+		return;
+	}
+	/* What it runs at now: its own word if it gives one, else what was
+	 * last asked of it here, else the boot level. */
+	if (a8a_get_rate(d, &now) != 0 || now == 0) {
+		now = dom->asked_khz != 0 ? dom->asked_khz : dom->boot_khz;
+		printf("A8 DVFS: %s does not answer FREQ_GET; taking %u kHz as its rate\n",
+		    a8a_dom_name[d], now);
+	}
+	have_temp = a8t_hottest(&hot, &cpu, &g3d);
+	if (khz > now && a8a.allow < 2) {
+		if (!have_temp) {
+			printf("A8 DVFS: no temperature reading (tmu), so nothing is raised\n");
+			return;
+		}
+		if (a8a.hot || hot + 10 > (int)a8a.temp_limit) {
+			printf("A8 DVFS: %d C is within 10 C of the %u C limit; not raising\n", hot,
+			    a8a.temp_limit);
+			return;
+		}
+	}
+	error = a8a_set_rate(d, khz, answer);
+	(void)a8a_get_rate(d, &after);
+	printf("A8 DVFS: %s %u -> %u kHz (table: %u uV): %s, answer 0x%08x 0x%x 0x%x 0x%x; it now "
+	    "reports %u kHz\n", a8a_dom_name[d], now, khz, uv, error ? "FAILED" : "asked",
+	    answer[0], answer[1], answer[2], answer[3], after);
+	if (error) {
+		return;
+	}
+	dom->asked_khz = khz;
+	/* By what was asked, not by what it reports: a wrong report must not
+	 * take the domain out of the temperature watch. */
+	dom->raised = khz > dom->boot_khz;
+	if (dom->raised && !a8a.watching) {
+		thread_t thread;
+
+		if (kernel_thread_start(a8a_watch_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+			a8a.watching = true;
+		} else {
+			printf("A8 DVFS: no temperature watch thread; watch it by hand (tmu)\n");
+		}
+	}
+	a8a_dvfs_report("after the request");
+}
+
+/* ---- console commands ---- */
+static bool
+a8a_word(const char **p, char *out, size_t size)
+{
+	size_t n = 0;
+
+	while (**p == ' ') {
+		(*p)++;
+	}
+	while (**p != 0 && **p != ' ') {
+		if (n + 1 < size) {
+			out[n++] = **p;
+		}
+		(*p)++;
+	}
+	out[n] = 0;
+	return n > 0;
+}
+
+/* A number: 0x.. is hex, anything else decimal (or hex when asked). */
+static bool
+a8a_number(const char **p, bool hex, uint32_t *value)
+{
+	char word[20];
+	const char *c = word;
+	uint64_t v = 0;
+
+	if (!a8a_word(p, word, sizeof(word))) {
+		return false;
+	}
+	if (c[0] == '0' && (c[1] == 'x' || c[1] == 'X')) {
+		hex = true;
+		c += 2;
+	}
+	if (*c == 0) {
+		return false;
+	}
+	for (; *c; c++) {
+		uint32_t digit;
+
+		if (*c >= '0' && *c <= '9') {
+			digit = (uint32_t)(*c - '0');
+		} else if (hex && *c >= 'a' && *c <= 'f') {
+			digit = (uint32_t)(*c - 'a' + 10);
+		} else if (hex && *c >= 'A' && *c <= 'F') {
+			digit = (uint32_t)(*c - 'A' + 10);
+		} else {
+			return false;
+		}
+		v = v * (hex ? 16u : 10u) + digit;
+		if (v > 0xffffffffull) {
+			return false;
+		}
+	}
+	*value = (uint32_t)v;
+	return true;
+}
+
+static int
+a8a_domain_named(const char *name)
+{
+	for (uint32_t d = 0; d < A8A_DOMAINS; d++) {
+		if (strcmp(name, a8a_dom_name[d]) == 0) {
+			return (int)d;
+		}
+	}
+	return -1;
+}
+
+/*
+ * acpm                     the framework, its plug-ins and channels
+ * acpm log                 the firmware's log buffer (and empties it)
+ * acpm fvp PATH            load and attach the FVP plug-in (a8dvfs=1)
+ * acpm send CH W0 W1 W2 W3 one raw command, hex words (a8dvfs=1)
+ */
+void
+a8_acpm_command(const char *args)
+{
+	char word[16];
+
+	lck_mtx_lock(&a8a_lock);
+	if (!a8a_init()) {
+		lck_mtx_unlock(&a8a_lock);
+		return;
+	}
+	if (!a8a_word(&args, word, sizeof(word))) {
+		a8a_status();
+	} else if (strcmp(word, "log") == 0) {
+		a8a_log_dump();
+	} else if (strcmp(word, "fvp") == 0) {
+		char path[256];
+
+		if (a8a.allow == 0) {
+			printf("A8A: off; boot with a8dvfs=1\n");
+		} else if (!a8a_word(&args, path, sizeof(path)) || path[0] != '/' ||
+		    a8a_has(path, "..")) {
+			printf("A8A: acpm fvp /private/var/.../FILE (the 12288-byte %s)\n", A8A_FVP_NAME);
+		} else {
+			a8a_fvp_load(path);
+		}
+	} else if (strcmp(word, "send") == 0) {
+		uint32_t ch = 0, cmd[4] = { 0, 0, 0, 0 };
+
+		if (a8a.allow == 0) {
+			printf("A8A: off; boot with a8dvfs=1\n");
+		} else if (!a8a_number(&args, true, &ch) || !a8a_number(&args, true, &cmd[0]) ||
+		    !a8a_number(&args, true, &cmd[1]) || !a8a_number(&args, true, &cmd[2]) ||
+		    !a8a_number(&args, true, &cmd[3])) {
+			printf("A8A: acpm send CHANNEL W0 W1 W2 W3 (hex)\n");
+		} else {
+			int error = a8a_ipc(ch, cmd);
+
+			printf("A8A: channel %u: %s 0x%08x 0x%08x 0x%08x 0x%08x\n", ch,
+			    error ? "no answer; command left as" : "answer", cmd[0], cmd[1], cmd[2], cmd[3]);
+		}
+	} else {
+		printf("A8A: acpm | acpm log | acpm fvp PATH | acpm send CH W0 W1 W2 W3\n");
+	}
+	lck_mtx_unlock(&a8a_lock);
+}
+
+/*
+ * dvfs                     the rate of every domain, the G3D PLL, the temperatures
+ * dvfs table [DOMAIN]      the firmware's levels
+ * dvfs DOMAIN KHZ          ask for a rate: big | little | g3d (a8dvfs=1)
+ * dvfs boot                every raised domain back to its boot rate
+ */
+void
+a8_dvfs_command(const char *args)
+{
+	char word[16];
+	uint32_t khz = 0;
+	int d;
+
+	lck_mtx_lock(&a8a_lock);
+	if (!a8a_init()) {
+		lck_mtx_unlock(&a8a_lock);
+		return;
+	}
+	if (!a8a_word(&args, word, sizeof(word))) {
+		a8a_dvfs_report("asked");
+	} else if (strcmp(word, "table") == 0) {
+		if (a8a_word(&args, word, sizeof(word)) && (d = a8a_domain_named(word)) >= 0) {
+			a8a_dvfs_table((uint32_t)d);
+		} else {
+			for (uint32_t i = 0; i < A8A_DOMAINS; i++) {
+				a8a_dvfs_table(i);
+			}
+		}
+	} else if (strcmp(word, "boot") == 0) {
+		for (uint32_t i = 0; i < A8A_DOMAINS; i++) {
+			if (a8a.dom[i].raised) {
+				a8a_dvfs_set(i, a8a.dom[i].boot_khz);
+			}
+		}
+		a8a_dvfs_report("boot rates");
+	} else if ((d = a8a_domain_named(word)) >= 0 && a8a_number(&args, false, &khz)) {
+		a8a_dvfs_set((uint32_t)d, khz);
+	} else {
+		printf("A8 DVFS: dvfs | dvfs table [mif|int|big|little|g3d] | dvfs big|little|g3d KHZ | "
+		    "dvfs boot\n");
+	}
+	lck_mtx_unlock(&a8a_lock);
+}
+
+/*
+ * tmu                      both sensor blocks, raw and in degrees
+ * tmu on                   switch a sensor core on that S-Boot left off (a8dvfs=1)
+ */
+void
+a8_tmu_command(const char *args)
+{
+	static const char *const names[2] = { "cpu", "g3d" };
+	char word[8];
+	bool on;
+
+	lck_mtx_lock(&a8a_lock);
+	if (!a8a_init()) {
+		lck_mtx_unlock(&a8a_lock);
+		return;
+	}
+	on = a8a_word(&args, word, sizeof(word)) && strcmp(word, "on") == 0;
+	a8t_map();
+	for (int i = 0; i < 2; i++) {
+		volatile uint32_t *base = i == 0 ? a8a.tmu_cpu : a8a.tmu_g3d;
+		uint32_t raw[4], esr = 0;
+		int celsius = 0;
+
+		if (a8t_read(base, &celsius, raw, &esr)) {
+			printf("A8 TMU: %s %d C (code %u; TRIMINFO 0x%x CONTROL 0x%x STATUS 0x%x)\n",
+			    names[i], celsius, raw[3] & 0x1ffu, raw[0], raw[1], raw[2]);
+			continue;
+		}
+		if (esr != 0) {
+			printf("A8 TMU: %s: the read was refused (ESR 0x%x)\n", names[i], esr);
+			continue;
+		}
+		printf("A8 TMU: %s: no reading (TRIMINFO 0x%x CONTROL 0x%x STATUS 0x%x CURRENT 0x%x)\n",
+		    names[i], raw[0], raw[1], raw[2], raw[3]);
+		if (on && a8a.allow != 0 && base != NULL && (raw[1] & A8T_CORE_EN) == 0) {
+			base[A8T_CONTROL >> 2] = raw[1] | A8T_CORE_EN;
+			printf("A8 TMU: %s: sensor core switched on (CONTROL 0x%x); ask again in a "
+			    "second\n", names[i], raw[1] | A8T_CORE_EN);
+		}
+	}
+	lck_mtx_unlock(&a8a_lock);
+}
+#endif /* ARM64_BOARD_CONFIG_A5XELTE && JACKPOTLTE */
