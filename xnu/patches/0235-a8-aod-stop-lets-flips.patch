 	    sweet_fb_aod_active ? "; dim now" : "", sweet_fb_aod_stopped ? ", DECON trigger masked" : "");
+#if defined(ARM64_BOARD_CONFIG_A5XELTE) && defined(JACKPOTLTE)
+	printf("A8SH: frames let through the masked trigger (0235): %u\n", a8_aod_frames_let);
+#endif
 	return sweet_fb_aod_lp;
 }
 
@@ -1961,6 +2020,9 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 					(void)a8_panel_brightness((unsigned int)sweet_fb_aod_level);
