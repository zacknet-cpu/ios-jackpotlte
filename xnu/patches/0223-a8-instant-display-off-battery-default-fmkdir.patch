diff --git a/bsd/dev/a8_files.c b/bsd/dev/a8_files.c
index 6c3d5ae..21d0118 100644
--- a/bsd/dev/a8_files.c
+++ b/bsd/dev/a8_files.c
@@ -39,12 +39,14 @@
 #include <string.h>
 
 int a8_kernel_rename(const char *from, const char *to);         /* vfs_syscalls.c */
+int a8_kernel_mkdir(const char *path);                          /* vfs_syscalls.c, 0223 */
 void a8f_get(const char *args);
 void a8f_put(const char *args);
 void a8f_data(const char *b64);
 void a8f_end(void);
 void a8f_ls(const char *args);
 void a8f_mv(const char *args);
+void a8f_mkdir(const char *args);
 void a8f_date(const char *args);
 bool a8_gl_resolve_inject(const char *library, size_t liblen, char *out, size_t out_size);
 bool a8_fix_library_ok(void);
@@ -569,6 +571,29 @@ a8f_mv(const char *args)
 	printf("A8F MV %s -> %s: %s (%d)\n", from, to, error ? "failed" : "done", error);
 }
 
+/*
+ * 0223: console "fmkdir PATH" makes a folder under /private/var/ (no . or
+ * ..), mode 0755, owned by root: a place to move files aside to with fmv
+ * (the console deletes nothing).
+ */
+void
+a8f_mkdir(const char *args)
+{
+	char path[A8F_PATH];
+	int error;
+
+	if (!a8f_word(&args, path, sizeof(path))) {
+		printf("A8F MKDIR error: fmkdir PATH (under /private/var/)\n");
+		return;
+	}
+	if (strncmp(path, "/private/var/", 13) != 0 || a8f_has(path, "/../") || a8f_has(path, "/./")) {
+		printf("A8F MKDIR error: only under /private/var/ (no . or ..): %s\n", path);
+		return;
+	}
+	error = a8_kernel_mkdir(path);
+	printf("A8F MKDIR %s: %s (%d)\n", path, error ? "failed" : "done", error);
+}
+
 void
 a8f_ls(const char *args)
 {
