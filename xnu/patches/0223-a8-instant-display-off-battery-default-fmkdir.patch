 	lck_mtx_lock(&jp_lock);
 	if (jp_enabled < 0) {
-		int value = 0;
+		/* 0223: on by default (it has run on every boot since 11-23),
+		 * which frees "a8battery=1" from the boot-args; a8battery=0
+		 * turns it off. */
+		int value = 1;
 		(void)PE_parse_boot_argn("a8battery", &value, sizeof(value));
-		jp_enabled = (value == 1) ? 1 : 0;
+		jp_enabled = (value != 0) ? 1 : 0;
 		if (!jp_enabled) {
 			printf("JACKPOTLTE BATTERY: off "
-			    "(a8battery=1 reads the s2mu004 charger/fuel gauge)\n");
+			    "(a8battery=0; without it the s2mu004 charger/fuel gauge is read)\n");
 		}
 	}
 	if (!jp_enabled) {
diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
index 15f58c0..a2d75dc 100644
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -9903,6 +9903,24 @@ mkdir(proc_t p, struct mkdir_args *uap, __unused int32_t *retval)
 	           UIO_USERSPACE);
 }
 
+#if defined(JACKPOTLTE)
+/*
+ * 0223: the A8 USB console's fmkdir (bsd/dev/a8_files.c), so that files can
+ * be moved aside into a folder of their own. Kernel path, kernel credentials,
+ * mode 0755.
+ */
+int a8_kernel_mkdir(const char *path);
+int
+a8_kernel_mkdir(const char *path)
+{
+	struct vnode_attr va;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, 0755);
+	return mkdir1at(vfs_context_kernel(), CAST_USER_ADDR_T(path), &va, AT_FDCWD, UIO_SYSSPACE);
+}
+#endif
+
 int
 mkdirat(proc_t p, struct mkdirat_args *uap, __unused int32_t *retval)
 {
