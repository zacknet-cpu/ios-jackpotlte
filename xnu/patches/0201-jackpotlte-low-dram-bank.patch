+#if defined(JACKPOTLTE)
+/*
+ * The A8's lower DRAM bank (a8lowram=1): its safe ranges are already managed
+ * by the pmap (pa_valid, pa_index) and mapped in the physical aperture
+ * (arm_vm_init.c); here the VM gets their pages, the way ml_static_mfree()
+ * hands boot memory back, one vm_page per page from the "vm pages" zone.
+ * That zone is made by vm_page_module_init() at STARTUP(ZALLOC, SECOND),
+ * after pmap_init() (KMEM), so this runs at the end of ZALLOC.
+ *
+ * First a quick probe through the aperture: a word written at the start and
+ * the end of every 2 MiB block, all read back after all were written.  A
+ * range with any wrong word stays out of the VM (it is still managed, which
+ * is harmless with no vm_page).  a8lowram=2 stops after the probe.
+ */
+static bool
+a8lo_probe_range(unsigned int i)
+{
+	const uint64_t pa0 = a8lo_ranges[i].pa, len = a8lo_ranges[i].len;
+	unsigned int bad = 0;
+
+	for (uint64_t off = 0; off < len; off += ARM_TT_L2_SIZE) {
+		volatile uint64_t *w0 = (volatile uint64_t *)phystokv(pa0 + off);
+		volatile uint64_t *w1 = (volatile uint64_t *)phystokv(pa0 + off + ARM_TT_L2_SIZE - sizeof(uint64_t));
+
+		*w0 = (pa0 + off) ^ 0xa8a8a8a855aa55aaULL;
+		*w1 = ~((pa0 + off) ^ 0xa8a8a8a855aa55aaULL);
+	}
+	__builtin_arm_dsb(DSB_SY);
+	for (uint64_t off = 0; off < len; off += ARM_TT_L2_SIZE) {
+		volatile uint64_t *w0 = (volatile uint64_t *)phystokv(pa0 + off);
+		volatile uint64_t *w1 = (volatile uint64_t *)phystokv(pa0 + off + ARM_TT_L2_SIZE - sizeof(uint64_t));
+
+		if ((*w0 != ((pa0 + off) ^ 0xa8a8a8a855aa55aaULL)) ||
+		    (*w1 != ~((pa0 + off) ^ 0xa8a8a8a855aa55aaULL))) {
+			if (bad++ < 4) {
+				printf("A8 RAM: probe mismatch at 0x%llx: 0x%llx 0x%llx\n",
+				    (unsigned long long)(pa0 + off), (unsigned long long)*w0,
+				    (unsigned long long)*w1);
+			}
+		}
+	}
+	return bad == 0;
+}
+
+__startup_func
+static void
+a8lo_give_to_vm(void)
+{
+	uint64_t pages = 0;
+	unsigned int before = vm_page_free_count;
+
+	if (!a8lo_on) {
+		printf("A8 RAM: lower bank not used (boot-arg a8lowram=1 adds it)\n");
+		return;
+	}
+	for (unsigned int i = 0; i < A8LO_RANGES; i++) {
+		const uint64_t pa = a8lo_ranges[i].pa, len = a8lo_ranges[i].len;
+
+		if (!a8lo_probe_range(i)) {
+			printf("A8 RAM: lower bank 0x%llx-0x%llx failed the probe, not used\n",
+			    (unsigned long long)pa, (unsigned long long)(pa + len - 1));
+			continue;
+		}
+		if (a8lo_on == 2) {
+			printf("A8 RAM: lower bank 0x%llx-0x%llx mapped and probed (a8lowram=2: not given)\n",
+			    (unsigned long long)pa, (unsigned long long)(pa + len - 1));
+			continue;
+		}
+		vm_page_create((ppnum_t)atop(pa), (ppnum_t)atop(pa + len));
+		pages += atop(len);
+		printf("A8 RAM: lower bank 0x%llx-0x%llx added (%llu MiB)\n",
+		    (unsigned long long)pa, (unsigned long long)(pa + len - 1),
+		    (unsigned long long)(len >> 20));
+	}
+	printf("A8 RAM: %llu MiB of the lower bank given to the VM, free pages %u -> %u\n",
+	    (unsigned long long)(ptoa_64(pages) >> 20), before, vm_page_free_count);
+}
+STARTUP(ZALLOC, STARTUP_RANK_LAST, a8lo_give_to_vm);
+#endif /* JACKPOTLTE */
