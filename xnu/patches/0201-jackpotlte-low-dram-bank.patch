+++ b/osfmk/arm/pmap/pmap_data.h
@@ -62,6 +62,45 @@
  */
 extern pmap_paddr_t vm_first_phys, vm_last_phys;
 
+#if defined(JACKPOTLTE)
+/*
+ * Galaxy A8 2018 (4 GB): DRAM is two 2 GiB banks, 0x80000000-0xffffffff and
+ * 0x880000000-0x8ffffffff.  XNU's managed range [vm_first_phys, vm_last_phys)
+ * is the upper bank only.  With the boot-arg a8lowram=1 the safe parts of the
+ * lower bank are managed too (a8lo_ranges, osfmk/arm64/arm_vm_init.c): their
+ * pmap indices follow the upper bank's (pa_index), the physical aperture maps
+ * them at one more ptov_table entry, and the VM gets their pages through
+ * vm_page_create() (pmap.c, a8lo_give_to_vm).  What stays out: the Samsung
+ * reserved-memory carve-outs (sec_debug_magic, dram_test, tima, seclog,
+ * wifibt_if, abox, the framebuffer and boot-slot page, modem_if,
+ * cp_ram_logging, gnss_if), the FDT /memreserve/ at 0xe0000000, the TEE hole
+ * 0xbda00000-0xbfffffff and the secondary-core trampoline page 0x8f000000.
+ * a8lo_on is 1, or 2 for "map and manage, but no pages to the VM".
+ */
+#define A8LO_BASE       0x80000000ULL
+#define A8LO_SPAN       0x80000000ULL
+#define A8LO_RANGES     7
+struct a8lo_range {
+	uint64_t pa, len;
+};
+extern const struct a8lo_range a8lo_ranges[A8LO_RANGES];
+extern unsigned int a8lo_on;
+
+static inline bool
+a8lo_valid(pmap_paddr_t pa)
+{
+	if (!a8lo_on || (pa - A8LO_BASE) >= A8LO_SPAN) {
+		return false;
+	}
+	for (unsigned int i = 0; i < A8LO_RANGES; i++) {
+		if ((pa - a8lo_ranges[i].pa) < a8lo_ranges[i].len) {
+			return true;
+		}
+	}
+	return false;
+}
+#endif /* JACKPOTLTE */
+
 /**
  * Return whether the given address represents a kernel-managed physical page.
  *
@@ -74,6 +113,11 @@ extern pmap_paddr_t vm_first_phys, vm_last_phys;
 static inline bool
 pa_valid(pmap_paddr_t pa)
 {
+#if defined(JACKPOTLTE)
+	if (__improbable(pa < vm_first_phys)) {
+		return a8lo_valid(pa);
+	}
+#endif
 	return (pa >= vm_first_phys) && (pa < vm_last_phys);
 }
 
@@ -97,9 +141,42 @@ pa_valid(pmap_paddr_t pa)
 static inline unsigned int
 pa_index(pmap_paddr_t pa)
 {
+#if defined(JACKPOTLTE)
+	if (__improbable(pa < vm_first_phys)) {
+		return (unsigned int)(atop(vm_last_phys - vm_first_phys) + atop(pa - A8LO_BASE));
+	}
+#endif
 	return (unsigned int)atop(pa - vm_first_phys);
 }
 
+/* The physical address of a physical address index (the inverse of pa_index). */
+static inline pmap_paddr_t
+pai_to_pa(unsigned int pai)
+{
+#if defined(JACKPOTLTE)
+	if (__improbable(pai >= atop(vm_last_phys - vm_first_phys))) {
+		return A8LO_BASE + (pmap_paddr_t)ptoa(pai - atop(vm_last_phys - vm_first_phys));
+	}
+#endif
+	return vm_first_phys + (pmap_paddr_t)ptoa(pai);
+}
+
+/*
+ * The offset in pmap_object of a page table page at `pa` (pmap_data.c).  The
+ * upper bank keeps its offsets (pa - gPhysBase, and vm_first_phys is
+ * gPhysBase); the lower bank's follow them, like its pmap indices.
+ */
+static inline vm_object_offset_t
+pmap_object_offset(pmap_paddr_t pa)
+{
+#if defined(JACKPOTLTE)
+	if (__improbable(pa < vm_first_phys)) {
+		return (vm_object_offset_t)(vm_last_phys - vm_first_phys) + (pa - A8LO_BASE);
+	}
+#endif
+	return (vm_object_offset_t)(pa - vm_first_phys);
+}
