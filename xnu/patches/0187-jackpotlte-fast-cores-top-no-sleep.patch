+#if SWEET_FAST_SCHED
+/*
+ * From syncmodz/ios-s9 (Galaxy S9). Galaxy S7 (Exynos 8890): XNU sees the
+ * eight cores as one homogeneous cluster, but cpus 4-7 are Mongoose M1 at
+ * 2.6 GHz, roughly twice as fast as the Cortex-A53s at 1.59 GHz (cpus 0-3,
+ * mkadt_herolte.py). Stock XNU takes the lowest numbered idle CPU, so CoreAnimation's
+ * single render thread in backboardd, the UI threads and every realtime
+ * thread kept landing on slow cores while the fast ones idled. Boot-arg
+ * sweetfast=MASK names the fast cores (default 0xf0, 0 = stock behaviour):
+ * realtime threads and threads at BASEPRI_DEFAULT or above take an idle fast
+ * core first and may preempt a background thread there; threads below take
+ * an idle slow core first, keeping the fast ones free.
+ */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE) && defined(JACKPOTLTE)
+/*
+ * Galaxy A8 2018 (Exynos 7885): logical cpus 0-5 are Cortex-A53s, 6-7 the
+ * two Cortex-A73s (tools/mkadt_jackpotlte.py), so the default is 0xc0.
+ * Ported from the Galaxy S7 port (theasianviet-lab/hackios-s7-kernel 0238,
+ * 0274, 0275, 0321), itself after Scion's sched_slow_secondaries.
+ */
+static cpumap_t sweet_fast_map = 0xc0;
+#else
+static cpumap_t sweet_fast_map = 0xf0;
+#endif
+
+/*
+ * Herolte: Mongoose is three or four times an A53 here. launchd and mediaserverd alone use up to three CPUs, with
+ * nothing on the screen to show for it, and at BASEPRI_DEFAULT they had the fast cores before the UI.
+ */
+extern char *proc_name_address(void *p);
+
+static inline bool
+sweet_is_hog(thread_t thread)
+{
+	static const char *const hogs[] = { "launchd", "mediaserverd", "logd", "kernel_task", "xpcproxy", "cfprefsd", "fairplayd.H2" };
+	void *proc = get_bsdtask_info(get_threadtask(thread));
+	if (proc == NULL) {
+		return false;
+	}
+	const char *name = proc_name_address(proc);
+	for (unsigned i = 0; i < sizeof(hogs) / sizeof(hogs[0]); i++) {
+		if (strncmp(name, hogs[i], 17) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static inline bool
+sweet_wants_fast(thread_t thread)
+{
+	return thread->sched_pri >= BASEPRI_USER_INITIATED && !sweet_is_hog(thread);
+}
+
+/* Idle CPU from idle_map in the thread's preferred class, else any; -1 if none. */
+static int
+sweet_pick_idle(cpumap_t idle_map, thread_t thread)
+{
+	cpumap_t fast = idle_map & sweet_fast_map;
+	cpumap_t slow = idle_map & ~sweet_fast_map;
+	cpumap_t first = sweet_wants_fast(thread) ? fast : slow;
+	return lsb_first(first ? first : idle_map);
+}
