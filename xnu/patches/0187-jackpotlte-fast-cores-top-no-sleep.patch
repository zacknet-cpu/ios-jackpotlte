+/*
+ * Where the CPU went (after the Galaxy S7 port's sweettop, patch 0251 of
+ * theasianviet-lab/hackios-s7-kernel): each pass reads every process's CPU
+ * time (TASK_ABSOLUTETIME_INFO, its live and dead threads) and prints the
+ * ten that used the most since the last pass, as a share of one core:
+ * "A8 TOP 60 s: backboardd 85% SpringBoard 40% ... | all 160% of 800%".
+ * The stat thread runs a pass after each stat line (a8top=0: never), the
+ * console's "top" command runs one on demand. Processes not seen in a pass
+ * leave the table, so the xpcproxy and fairplayd respawns do not fill it.
+ */
+#define A8_TOP_PROCS    384
+static struct a8_top_ent {
+	int      pid;
+	uint32_t gen;
+	uint64_t abs;
+	uint64_t delta;
+	char     name[20];
+} a8_top[A8_TOP_PROCS];
+static unsigned a8_top_n;
+static uint32_t a8_top_gen;
+static uint64_t a8_top_last;            /* mach time of the last pass */
+static LCK_GRP_DECLARE(a8_top_grp, "a8top");
+static LCK_MTX_DECLARE(a8_top_lock, &a8_top_grp);
+extern task_t proc_task(proc_t);
+
+static int
+a8_top_proc(proc_t p, void *arg __unused)
+{
+	task_t task = proc_task(p);
+	task_absolutetime_info_data_t ti;
+	mach_msg_type_number_t count = TASK_ABSOLUTETIME_INFO_COUNT;
+	int pid = proc_pid(p);
+	unsigned i;
+
+	if (task == TASK_NULL ||
+	    task_info(task, TASK_ABSOLUTETIME_INFO, (task_info_t)&ti, &count) != KERN_SUCCESS) {
+		return PROC_RETURNED;
+	}
+	uint64_t abs = ti.total_user + ti.total_system + ti.threads_user + ti.threads_system;
+	for (i = 0; i < a8_top_n && a8_top[i].pid != pid; i++) {
+	}
+	if (i == a8_top_n) {
+		if (a8_top_n == A8_TOP_PROCS) {
+			return PROC_RETURNED;
+		}
+		a8_top_n++;
+		a8_top[i].pid = pid;
+		a8_top[i].abs = abs;            /* first sight: its time before now is not counted */
+		proc_name(pid, a8_top[i].name, sizeof(a8_top[i].name));
+	}
+	a8_top[i].delta = abs > a8_top[i].abs ? abs - a8_top[i].abs : 0;
+	a8_top[i].abs = abs;
+	a8_top[i].gen = a8_top_gen;
+	return PROC_RETURNED;
+}
+
+static void
+a8_top_pass(const char *why)
+{
+	uint64_t now, span_ns, total = 0;
+	char line[480];
+	int len;
+
+	lck_mtx_lock(&a8_top_lock);
+	a8_top_gen++;
+	proc_iterate(PROC_ALLPROCLIST, a8_top_proc, NULL, NULL, NULL);
+	now = mach_absolute_time();
+	absolutetime_to_nanoseconds(now - a8_top_last, &span_ns);
+	/* Drop the processes this pass did not see (exited). */
+	for (unsigned i = 0; i < a8_top_n;) {
+		if (a8_top[i].gen != a8_top_gen) {
+			a8_top[i] = a8_top[--a8_top_n];
+		} else {
+			total += a8_top[i].delta;
+			i++;
+		}
+	}
+	if (a8_top_last == 0 || span_ns < 500 * NSEC_PER_MSEC) {
+		a8_top_last = now;
+		lck_mtx_unlock(&a8_top_lock);
+		printf("A8 TOP: baseline taken (%s); the next pass shows the CPU since now\n", why);
+		return;
+	}
+	a8_top_last = now;
+	len = snprintf(line, sizeof(line), "A8 TOP %llu s (%s):", span_ns / NSEC_PER_SEC, why);
+	for (int k = 0; k < 10 && len < (int)sizeof(line) - 48; k++) {
+		unsigned best = A8_TOP_PROCS;
+		uint64_t ns;
+
+		for (unsigned i = 0; i < a8_top_n; i++) {
+			if (a8_top[i].delta != 0 && (best == A8_TOP_PROCS || a8_top[i].delta > a8_top[best].delta)) {
+				best = i;
+			}
+		}
+		if (best == A8_TOP_PROCS) {
+			break;
+		}
+		absolutetime_to_nanoseconds(a8_top[best].delta, &ns);
+		len += snprintf(line + len, sizeof(line) - len, " %s[%d] %llu%%", a8_top[best].name,
+		    a8_top[best].pid, ns * 100 / span_ns);
+		a8_top[best].delta = 0;
+	}
+	absolutetime_to_nanoseconds(total, &total);
+	lck_mtx_unlock(&a8_top_lock);
+	printf("%s | all %llu%% of %u%%\n", line, total * 100 / span_ns, (unsigned)ml_get_max_cpu_number() * 100 + 100);
+}
