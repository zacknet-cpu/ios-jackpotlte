-		    "hlpm [0|1|2] (now) | bat (gauge now, 0236) | aodclk [0|1] (boot rates while dim, 0237) | aodvsync [HZ] (0238)\n");
+		    "hlpm [0|1|2] (now) | bat (gauge now, 0236) | aodclk [0|1|2] (dim clocks: boot rates / deeper, 0237/0239) | aodvsync [HZ] (0238)\n");
 		printf("A8SH: kernel slots: slots | bput SIZE SHA256, bd BASE64..., bend "
 		    "(writes the slot that is not the default) | tryb (boot it once) | "
 		    "tryok | promote\n");
@@ -2007,7 +2007,8 @@ a8s_command(const char *line)
 		while (*rest == ' ') {
 			rest++;
 		}
-		printf("A8SH: aodclk %d\n", sweet_fb_aodclk_set(*rest == '0' ? 0 : *rest == '1' ? 1 : -1));
+		printf("A8SH: aodclk %d (0 off, 1 boot rates, 2 deeper: big 520 / little 546 MHz)\n",
+		    sweet_fb_aodclk_set(*rest == '0' ? 0 : *rest == '1' ? 1 : *rest == '2' ? 2 : -1));
 	} else if (a8s_word(line, "bat", &rest)) {
 		/* 0236: one fresh charger / fuel gauge sample (drain measurements) */
 		unsigned pct = 0, mv = 0;
@@ -2379,13 +2380,31 @@ a8g_event(uint32_t ev)
 	}
 }
 
+/*
+ * 0239 (P14 AOD power): the gadget thread polled every 1 ms for good --
+ * 1000 wakeups a second, also with the cable out (kernel_task's steady ~6 %
+ * while locked, 11-28).  It still polls each 1 ms while anything moves
+ * (events, a transfer in flight, console output the open port has not had,
+ * commands queued) and after 200 quiet polls every a8usbidle ms (default 20,
+ * at most 100; 0 or 1 = always 1 ms).  An event (a byte from the PC, a plug)
+ * brings it back to 1 ms at the next poll.
+ */
+static uint32_t a8g_idle_ms;
+
 static void
 a8g_thread(void *arg __unused, wait_result_t wr __unused)
 {
-	uint32_t ticks = 0;
+	uint32_t ticks = 0, quiet = 0;
 
+	{
+		uint32_t v = 20;
+
+		(void)PE_parse_boot_argn("a8usbidle", &v, sizeof(v));
+		a8g_idle_ms = v <= 1 ? 1 : (v > 100 ? 100 : v);
+	}
 	for (;;) {
 		uint32_t count = a8_usb_rd(a8g.dwc, A8_GEVNTCOUNT) & 0xffff;
+		bool busy;
 
 		if (count) {
 			a8g_sync(A8G_EVT, A8G_EVT_SIZE);
@@ -2425,7 +2444,10 @@ a8g_thread(void *arg __unused, wait_result_t wr __unused)
 				    a8_usb_rd(a8g.dwc, A8_DSTS));
 			}
 		}
-		a8g_sleep_ms(1);
+		busy = count != 0 || a8g.tx_busy || a8s_rx_held || a8s_qhead != a8s_qtail ||
+		    (a8g.configured && a8g.host_open && a5xelte_log_position() != a8g.log_pos);
+		quiet = busy ? 0 : (quiet < 1000000u ? quiet + 1 : quiet);
+		a8g_sleep_ms(quiet < 200 ? 1 : a8g_idle_ms);
 	}
 }
 
diff --git a/bsd/dev/a8_acpm.c b/bsd/dev/a8_acpm.c
index 6b9a8c1..63bcbcf 100644
--- a/bsd/dev/a8_acpm.c
+++ b/bsd/dev/a8_acpm.c
@@ -1405,6 +1405,23 @@ static bool a8a_dimmed;
 
 int a8_dvfs_dim(int on);
 
+/*
+ * 0239: on = 2 goes deeper (user's OK 11-28): big 520000 and little 546000
+ * kHz, the fastest stock levels at the table's lowest voltage (600000 uV);
+ * g3d stays at its boot level (343000, already its lowest).
+ */
+static uint32_t
+a8a_dim_target(int d, int on)
+{
+	if (on >= 2 && d == (int)A8A_DOM_BIG) {
+		return 520000u;
+	}
+	if (on >= 2 && d == (int)A8A_DOM_LITTLE) {
+		return 546000u;
+	}
+	return a8a.dom[d].boot_khz;
+}
+
 int
 a8_dvfs_dim(int on)
 {
@@ -1425,10 +1442,15 @@ a8_dvfs_dim(int on)
 			}
 			dom = &a8a.dom[d];
 			a8a_dim_saved[d] = 0;
-			if (dom->ok && dom->boot_khz != 0 && dom->asked_khz > dom->boot_khz) {
-				a8a_dim_saved[d] = dom->asked_khz;
-				a8a_dvfs_set((uint32_t)d, dom->boot_khz);
-				changed++;
+			{
+				uint32_t target = a8a_dim_target(d, on);
+				uint32_t from = dom->asked_khz != 0 ? dom->asked_khz : dom->boot_khz;
+
+				if (dom->ok && target != 0 && from > target) {
+					a8a_dim_saved[d] = from;
+					a8a_dvfs_set((uint32_t)d, target);
+					changed++;
+				}
 			}
 		}
 		a8a_dimmed = true;
@@ -1443,8 +1465,8 @@ a8_dvfs_dim(int on)
 		a8a_dimmed = false;
 	}
 	lck_mtx_unlock(&a8a_lock);
-	printf("A8 DVFS: dim lock screen %s (0237): %d domains\n", on ? "on, boot rates" : "off, rates back",
-	    changed);
+	printf("A8 DVFS: dim lock screen %s (0237/0239): %d domains\n",
+	    on >= 2 ? "on, deeper rates" : on ? "on, boot rates" : "off, rates back", changed);
 	return changed;
 }
 
