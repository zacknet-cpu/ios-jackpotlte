+/*
+ * 0231: tools for working out iOS's Always-On Display path at run time
+ * (P14), so experiments need no new kernel:
+ *  - console "fbtrace N": the next N user-client calls are logged with the
+ *    caller, the scalars and the struct input's non-zero words (SwapEnd:
+ *    only words outside the fields this driver reads); "fbtrace 0" stops;
+ *  - console "fbout SEL OFF VALUE": the reply to selector SEL gets the
+ *    32-bit VALUE at byte OFF of its struct output (OFF s0..s15: scalar
+ *    output N, 64 bits); 8 entries; "fbout clear", "fbout" lists;
+ *  - console "fbprop NAME [N|true|false]": sets or removes a property of
+ *    the AppleCLCD service (then "kill backboardd" to have CA read it).
+ */
+static volatile int sweet_fb_trace_left;
+#define SWEET_FB_OUTS 8
+static struct {
+	uint32_t sel;           /* 0: unused (no selector 0 carries data here) */
+	int32_t  off;           /* >= 0: struct byte offset; -1-N: scalar N */
+	uint64_t value;
+} sweet_fb_outs[SWEET_FB_OUTS];
+
+static void
+sweet_fb_out_apply(uint32_t selector, IOExternalMethodArguments *args)
+{
+	for (unsigned i = 0; i < SWEET_FB_OUTS; i++) {
+		if (sweet_fb_outs[i].sel == 0 || sweet_fb_outs[i].sel != selector) {
+			continue;
+		}
+		int32_t off = sweet_fb_outs[i].off;
+		if (off < 0) {
+			uint32_t n = (uint32_t)(-1 - off);
+			if (n < args->scalarOutputCount) {
+				args->scalarOutput[n] = sweet_fb_outs[i].value;
+			}
+		} else if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL &&
+		    (uint32_t)off + 4 <= args->structureOutputSize) {
+			uint32_t v = (uint32_t)sweet_fb_outs[i].value;
+			memcpy((uint8_t *)args->structureOutput + off, &v, 4);
+		}
+	}
+}
+
+static bool
+sweet_fb_swap_field_known(uint32_t off)
+{
+	/* SwapEnd fields this driver reads: swap id, surface ids, rects a/b,
+	 * enabled mask */
+	return off == 0x50 || (off >= 0x54 && off < 0xa4) || (off >= 0xc4 && off < 0x108);
+}
+
+static void
+sweet_fb_trace_call(uint32_t selector, IOExternalMethodArguments *args, IOReturn ret)
+{
+	char name[32], buf[200];
+	unsigned n = 0;
+
+	if (OSDecrementAtomic(&sweet_fb_trace_left) <= 0) {
+		sweet_fb_trace_left = 0;
+		return;
+	}
+	proc_selfname(name, sizeof(name));
+	buf[0] = 0;
+	for (uint32_t i = 0; i < args->scalarInputCount && i < 6 && n < sizeof(buf) - 24; i++) {
+		n += (unsigned)snprintf(buf + n, sizeof(buf) - n, " %llx", args->scalarInput[i]);
+	}
+	IOLog("SWEET FB TRACE: %s sel %u in%s | %u bytes, out %u/%u -> 0x%x\n", name, selector,
+	    buf, args->structureInputSize, args->scalarOutputCount, args->structureOutputSize, ret);
+	if (args->structureInputDescriptor == NULL && args->structureInput != NULL &&
+	    args->structureInputSize >= 4) {
+		const uint8_t *p = (const uint8_t *)args->structureInput;
+		unsigned shown = 0;
+		n = 0;
+		buf[0] = 0;
+		for (uint32_t off = 0; off + 4 <= args->structureInputSize && shown < 12; off += 4) {
+			uint32_t v;
+			memcpy(&v, p + off, 4);
+			if (v == 0 || (selector == kSweetFBSwapEnd && sweet_fb_swap_field_known(off))) {
+				continue;
+			}
+			n += (unsigned)snprintf(buf + n, sizeof(buf) - n, " +%x=%x", off, v);
+			shown++;
+			if (shown % 6 == 0) {
+				IOLog("SWEET FB TRACE:   %s\n", buf);
+				n = 0;
+				buf[0] = 0;
+			}
+		}
+		if (n != 0) {
+			IOLog("SWEET FB TRACE:   %s\n", buf);
+		}
+	}
+}
+
+extern "C" int
+sweet_fb_trace_set(int count)
+{
+	if (count >= 0) {
+		sweet_fb_trace_left = count > 100000 ? 100000 : count;
+	}
+	return sweet_fb_trace_left;
+}
+
+/* sel 0 clears all; returns the number of entries in use */
+extern "C" int
+sweet_fb_out_set(uint32_t sel, int32_t off, uint64_t value, int list)
+{
+	int used = 0;
+
+	if (!list && sel == 0) {
+		bzero(sweet_fb_outs, sizeof(sweet_fb_outs));
+	} else if (!list) {
+		int slot = -1;
+		for (int i = 0; i < SWEET_FB_OUTS; i++) {
+			if (sweet_fb_outs[i].sel == sel && sweet_fb_outs[i].off == off) {
+				slot = i;
+				break;
+			}
+			if (slot < 0 && sweet_fb_outs[i].sel == 0) {
+				slot = i;
+			}
+		}
+		if (slot < 0) {
+			return -1;
+		}
+		sweet_fb_outs[slot].value = value;
+		sweet_fb_outs[slot].off = off;
+		sweet_fb_outs[slot].sel = sel;
+	}
+	for (int i = 0; i < SWEET_FB_OUTS; i++) {
+		if (sweet_fb_outs[i].sel == 0) {
+			continue;
+		}
+		used++;
+		if (sweet_fb_outs[i].off >= 0) {
+			printf("A8SH: fbout sel %u +0x%x = 0x%llx\n", sweet_fb_outs[i].sel,
+			    sweet_fb_outs[i].off, sweet_fb_outs[i].value);
+		} else {
+			printf("A8SH: fbout sel %u scalar %d = 0x%llx\n", sweet_fb_outs[i].sel,
+			    -1 - sweet_fb_outs[i].off, sweet_fb_outs[i].value);
+		}
+	}
+	return used;
+}
+
+/* value NULL: remove; "true"/"false": OSBoolean; else a number (0x hex) */
+extern "C" int
+sweet_fb_prop_set(const char *key, const char *value)
+{
+	AppleCLCD *fb = sweet_fb_main;
+
+	if (fb == NULL || key == NULL || key[0] == 0) {
+		return -1;
+	}
+	if (value == NULL || value[0] == 0) {
+		fb->removeProperty(key);
+		return 0;
+	}
+	if (strcmp(value, "true") == 0 || strcmp(value, "false") == 0) {
+		fb->setProperty(key, value[0] == 't' ? kOSBooleanTrue : kOSBooleanFalse);
+		return 1;
+	}
+	uint64_t v = 0;
+	const char *c = value;
+	unsigned base = 10;
+	if (c[0] == '0' && (c[1] == 'x' || c[1] == 'X')) {
+		base = 16;
+		c += 2;
+	}
+	for (; *c != 0; c++) {
+		unsigned d;
+		if (*c >= '0' && *c <= '9') {
+			d = (unsigned)(*c - '0');
+		} else if (base == 16 && *c >= 'a' && *c <= 'f') {
+			d = (unsigned)(*c - 'a' + 10);
+		} else if (base == 16 && *c >= 'A' && *c <= 'F') {
+			d = (unsigned)(*c - 'A' + 10);
+		} else {
+			return -1;
+		}
+		v = v * base + d;
+	}
+	OSNumber *num = OSNumber::withNumber(v, 64);
+	if (num == NULL) {
+		return -1;
+	}
+	fb->setProperty(key, num);
+	num->release();
+	return 2;
+}
