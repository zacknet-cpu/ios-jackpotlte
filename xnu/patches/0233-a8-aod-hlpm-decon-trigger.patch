+/*
+ * 0233 (P14 AOD): the panel's own low-power mode, Samsung's HLPM
+ * (s6e3fa7_jackpot_lcd_ctrl.c s6e3fa7_enteralpm / s6e3fa7_setalpm /
+ * s6e3fa7_exitalpm, the bytes of s6e3fa7_jackpot_param.h): 1 = HLPM 2 nit,
+ * 2 = HLPM 60 nit, 0 = back to normal.  Enter: test key on, self mask off
+ * (7A 00), AOR B1 08 98, F7 03, 20 ms (a frame is written meanwhile), BB 15
+ * 8C|0C 08 10 7D, 53 03|02, F7 03, test key off.  Exit: test key on, BB 15 8C
+ * 88 7D, 34 ms, 53 00, self mask on (as the init sends it), test key off, then
+ * the last level asked for (brightness requests are only noted while HLPM is
+ * on).  The panel must be powered (ours stays on at display off; Samsung's
+ * enteralpm does nothing on a suspended panel).  Tried by hand 11-27 with the
+ * user watching (console pokes of these packets): 2 nit = the same picture,
+ * dimmer.  Returns the mode now, -1 when the DSI link is down.
+ */
+int a8_panel_hlpm(int mode);
+
+int
+a8_panel_hlpm(int mode)
+{
+	static const unsigned char key_on[] = { 0xF0, 0x5A, 0x5A };
+	static const unsigned char key_off[] = { 0xF0, 0xA5, 0xA5 };
+	static const unsigned char update[] = { 0xF7, 0x03 };
+	static const unsigned char mask_off[] = { 0x7A, 0x00 };
+	static const unsigned char aor_hlpm[] = { 0xB1, 0x08, 0x98 };
+	static const unsigned char ctl_02[] = { 0xBB, 0x15, 0x8C, 0x08, 0x10, 0x7D };
+	static const unsigned char ctl_60[] = { 0xBB, 0x15, 0x0C, 0x08, 0x10, 0x7D };
+	static const unsigned char ctl_off[] = { 0xBB, 0x15, 0x8C, 0x88, 0x7D };
+	static const unsigned char on_02[] = { 0x53, 0x03 };
+	static const unsigned char on_60[] = { 0x53, 0x02 };
+	static const unsigned char hlpm_off[] = { 0x53, 0x00 };
+	int was, level;
+	bool ok;
+
+	if (mode < 0 || mode > 2) {
+		return a8_hlpm_mode;
+	}
+	if (a5p_dsim == 0 || !(a5p_read(a5p_dsim, DSIM_LINK_STATUS3) & DSIM_PLL_STABLE)) {
+		printf("A8 HLPM: the DSI link is not up; nothing sent\n");
+		return -1;
+	}
+	lck_mtx_lock(&a8_bl_lock);
+	was = a8_hlpm_mode;
+	if (mode == was) {
+		lck_mtx_unlock(&a8_bl_lock);
+		return mode;
+	}
+	if (mode != 0) {
+		ok = a8_dsi_cmd(key_on, sizeof(key_on)) && a8_dsi_cmd(mask_off, sizeof(mask_off)) &&
+		    a8_dsi_cmd(aor_hlpm, sizeof(aor_hlpm)) && a8_dsi_cmd(update, sizeof(update));
+		delay(20000);
+		ok = ok && a8_dsi_cmd(mode == 1 ? ctl_02 : ctl_60, sizeof(ctl_02)) &&
+		    a8_dsi_cmd(mode == 1 ? on_02 : on_60, sizeof(on_02)) && a8_dsi_cmd(update, sizeof(update));
+	} else {
+		ok = a8_dsi_cmd(key_on, sizeof(key_on)) && a8_dsi_cmd(ctl_off, sizeof(ctl_off));
+		delay(34000);
+		ok = ok && a8_dsi_cmd(hlpm_off, sizeof(hlpm_off)) &&
+		    a8_dsi_cmd(seq_self_mask_on, sizeof(seq_self_mask_on));
+	}
+	ok = a8_dsi_cmd(key_off, sizeof(key_off)) && ok;
+	a8_hlpm_mode = mode;
+	a8_hlpm_held = 0;
+	level = a8_bl_level;
+	lck_mtx_unlock(&a8_bl_lock);
+	printf("A8 HLPM: %s -> %s%s\n", was == 0 ? "off" : was == 1 ? "2 nit" : "60 nit",
+	    mode == 0 ? "off" : mode == 1 ? "2 nit" : "60 nit", ok ? "" : " (the DSI FIFO did not drain)");
+	if (mode == 0 && level >= 0) {
+		(void)a8_panel_brightness((unsigned int)level);
+	}
+	return mode;
+}
