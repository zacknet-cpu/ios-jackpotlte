+/* 0233: DECON's hardware trigger (HW_SW_TRIG_CONTROL): on = HW_TRIG_EN,
+ * off = HW_TRIG_MASK_DECON (Samsung's decon_reg_set_trigger); the value now. */
+#define A8_DECON_TRIG           0x70u
+#define A8_DECON_TRIG_EN        0x1u
+#define A8_DECON_TRIG_MASK      0x10u
+static uint32_t
+a8_decon_trigger(bool on)
+{
+	volatile uint32_t *reg;
+	uint32_t v;
+
+	if (a8_decon == 0) {
+		return 0;
+	}
+	reg = (volatile uint32_t *)(a8_decon + A8_DECON_TRIG);
+	v = *reg;
+	v = on ? ((v & ~A8_DECON_TRIG_MASK) | A8_DECON_TRIG_EN) : ((v & ~A8_DECON_TRIG_EN) | A8_DECON_TRIG_MASK);
+	*reg = v;
+	return *reg;
+}
