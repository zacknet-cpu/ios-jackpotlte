+	    sweet_fb_aod_lp == 1 ? "HLPM 2 nit" : sweet_fb_aod_lp == 2 ? "HLPM 60 nit" :
+	    sweet_fb_aod_lp == 0 ? "AOR dim" : "boot-arg not read yet", sweet_fb_aod_stop,
+	    sweet_fb_aod_active ? "; dim now" : "", sweet_fb_aod_stopped ? ", DECON trigger masked" : "");
+	return sweet_fb_aod_lp;
+}
