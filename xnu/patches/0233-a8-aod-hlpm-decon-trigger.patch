+/*
+ * 0233 (P14 AOD, power): two optional parts of the dim lock screen, both off
+ * by default until tried with the user watching.  sweet_fb_aod_lp: the
+ * panel's own low-power mode instead of the AOR dim (1 = HLPM 2 nit, 2 = HLPM
+ * 60 nit; a5xelte_panel.c a8_panel_hlpm).  sweet_fb_aod_stop: DECON's
+ * hardware trigger masked while dim (HW_SW_TRIG_CONTROL 0x1281 -> HW_TRIG_EN
+ * off, HW_TRIG_MASK_DECON on, as Samsung's decon_reg_set_trigger(DISABLE)):
+ * the s6e3fa7 is a command-mode panel and keeps the picture in its own
+ * memory, while DECON otherwise sends it the same frame on every TE (seen
+ * 11-27: frame-done keeps coming with no flip; masked, it stops).  Display on
+ * arms the trigger first, then leaves HLPM, then puts the level back.
+ * Boot-args a8aodlp=N, a8aodstop=1; console "aodlp N", "aodstop 0|1".
+ */
+static int sweet_fb_aod_lp = -1;                /* -1: boot-arg not read yet */
+static int sweet_fb_aod_stop = -1;
+static volatile int sweet_fb_aod_stopped;
+#if defined(ARM64_BOARD_CONFIG_A5XELTE) && defined(JACKPOTLTE)
+extern "C" int a8_panel_hlpm(int mode);                         /* a5xelte_panel.c, 0233 */
+#endif
