@@ -236,6 +239,16 @@ jackpotlte_mali_uc_pairs(void)
 	return gMaliPairs;
 }
 
+/* 0230: kJackpotlteSubmitN calls and the submits they brought, for the flip report */
+extern "C" void jackpotlte_mali_uc_batches(uint64_t * calls, uint64_t * jobs);
+
+void
+jackpotlte_mali_uc_batches(uint64_t * calls, uint64_t * jobs)
+{
+	*calls = gMaliBatches;
+	*jobs = gMaliBatchJobs;
+}
+
 /* 0226: frees done outside gMaliLock and their time, and how long requests
  * waited for gMaliLock, for the flip report */
 extern "C" void jackpotlte_mali_uc_frees(uint64_t * frees, uint64_t * ns, uint64_t * takes,
@@ -699,6 +712,7 @@ JackpotlteMaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArgu
 		struct drm_gem_close close;
 		struct drm_panfrost_submit submit;
 		struct drm_panfrost_submit submit2[2];  /* 0218 */
+		struct drm_panfrost_submit submitn[JACKPOTLTE_SUBMITN_MAX];    /* 0230 */
 		struct drm_panfrost_wait_bo wait;
 		struct drm_panfrost_create_bo create;
 		struct drm_panfrost_mmap_bo mmap;
@@ -808,6 +822,26 @@ JackpotlteMaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArgu
 		}
 		gMaliPairs++;
 		break;
+	case kJackpotlteSubmitN: {
+		/* 0230: several passes' submits in one call (libjackpotlte holds them
+		 * until a wait, a close, a sync object or the frame's end needs them),
+		 * queued in order exactly as one call each would have; each gets its
+		 * own number back in its jc (0: not queued). */
+		size_t n = size / sizeof(r.submitn[0]);
+
+		if (n == 0 || n > JACKPOTLTE_SUBMITN_MAX || size != n * sizeof(r.submitn[0])) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		for (size_t k = 0; k < n; k++) {
+			if (r.submitn[k].jc != 0) {
+				(void)submitOne(&r.submitn[k]);
+			}
+		}
+		gMaliBatches++;
+		gMaliBatchJobs += n;
+		break;
+	}
 	case kJackpotlteSurface:
 		ret = surfaceBuffer(&r.surface);
 		break;
