+static bool
+a8_vsync_lock_on(void)
+{
+	if (a8_vsync_lock < 0) {
+		int on = 1;
+
+		PE_parse_boot_argn("a8vlock", &on, sizeof(on));
+		a8_vsync_lock = on != 0;
+	}
+	return a8_vsync_lock > 0;
+}
+
+/*
+ * 0204: when the next software vsync fires.  The panel's frame starts are
+ * seen when an update is taken (a8_scan_settle, the synchronous wait); the
+ * next tick is put just after the panel's next frame start, moved by at most
+ * 2 ms a tick so the timestamps CoreAnimation gets stay even.  Nothing seen
+ * for a quarter second (no frames): the plain 60 Hz tick.
+ */
+static uint32_t
+a8_vsync_next_us(void)
+{
+	const int32_t period = SWEET_FB_VSYNC_US, lead = 400;
+	uint64_t seen = a8_vsync_seen, now = mach_absolute_time(), ns = 0;
+	int32_t phase, until;
+
+	if (!a8_vsync_lock_on() || seen == 0 || now <= seen) {
+		return SWEET_FB_VSYNC_US;
+	}
+	absolutetime_to_nanoseconds(now - seen, &ns);
+	if (ns > 250000000ull) {
+		return SWEET_FB_VSYNC_US;
+	}
+	phase = (int32_t)((ns / 1000) % (uint64_t)period);     /* us since the panel's last frame start */
+	until = period - phase + lead;                          /* just after its next one */
+	if (until < period / 2) {
+		until += period;
+	}
+	if (until < period - 2000) {
+		until = period - 2000;
+	}
+	if (until > period + 2000) {
+		until = period + 2000;
+	}
+	a8_vsync_locked++;
+	return (uint32_t)until;
+}
+
+/* Console "vlock 0|1" (bsd/dev/a5xelte_usb.c); -1 only reports. */
+extern "C" int
+sweet_fb_vsync_lock_set(int on)
+{
+	(void)a8_vsync_lock_on();
+	if (on == 0 || on == 1) {
+		a8_vsync_lock = on;
+	}
+	IOLog("A8 VSYNC: %s to the panel, %llu ticks placed, %llu frame starts seen\n",
+	    a8_vsync_lock_on() ? "locked" : "not locked", a8_vsync_locked, a8_vsync_seens);
+	return a8_vsync_lock_on();
+}
+
+/*
+ * 0204: kern.a8_bind_big.  Write 6 or 7 to bind the calling thread to that
+ * Cortex-A73 (the ADT's cpus 6 and 7), -1 to unbind; read the bound cpu.
+ * jackpotlte-gl binds CoreAnimation's render thread (glca14): its frame
+ * building ran on whichever A53 the single processor set gave it.
+ */
+extern "C" kern_return_t sysctl_thread_bind_cpuid(int32_t cpuid);     /* sched_prim.c */
+extern "C" int32_t sysctl_get_bound_cpuid(void);
+static uint32_t a8_binds;
+
+static int
+a8_bind_big_sysctl(__unused struct sysctl_oid *oidp, __unused void *arg1,
+    __unused int arg2, struct sysctl_req *req)
+{
+	int32_t cpu = sysctl_get_bound_cpuid(), value = 0;
+	int changed = 0;
+	int error = sysctl_io_number(req, cpu, sizeof(cpu), &value, &changed);
+
+	if (error != 0 || !changed) {
+		return error;
+	}
+	if (value != -1 && value != 6 && value != 7) {
+		return EINVAL;
+	}
+	if (sysctl_thread_bind_cpuid(value) != KERN_SUCCESS) {
+		return ENOTSUP;
+	}
+	if (a8_binds++ < 16) {
+		char name[32];
+
+		proc_selfname(name, sizeof(name));
+		IOLog("A8 BIND: a thread of %s %s\n", name, value < 0 ? "unbound" :
+		    value == 6 ? "bound to cpu 6 (A73)" : "bound to cpu 7 (A73)");
+	}
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, a8_bind_big,
+    CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    NULL, 0, a8_bind_big_sysctl, "I", "bind the calling thread to an A73 (6, 7) or unbind (-1)");
+
