+/*
+ * 0225: the last finished job's number in a page that programs map
+ * read-only (JackpotlteMali.cpp, client memory type kJackpotlteDonePage).
+ * Jobs finish in order, so libjackpotlte answers a buffer's WAIT_BO from it
+ * and its own record of each buffer's last job, with no call: "idle" and,
+ * for a look with timeout 0, "busy" too (each such call cost ~35 us, 4.6%
+ * of Control Center's render thread on 11-26).  [0] the last finished job,
+ * [1] JT_DONE_PAGE_MAGIC, [2] the last queued job (for a look only).
+ */
+extern kern_return_t sysctl_thread_bind_cpuid(int32_t cpuid);  /* sched_prim.c */
+
+#define JT_DONE_PAGE_MAGIC      0x31454e4f44384141ull   /* "AA8DONE1" */
+static volatile uint64_t *jt_done_page;
+
+void
+jackpotlte_mali_done_page(volatile uint64_t *page)
+{
+	lck_mtx_lock(&jt_queue_lock);
+	page[2] = jt_queued_seq;
+	__atomic_store_n(&page[0], jt_done_seq, __ATOMIC_RELEASE);
+	__atomic_store_n(&page[1], JT_DONE_PAGE_MAGIC, __ATOMIC_RELEASE);
+	jt_done_page = page;
+	lck_mtx_unlock(&jt_queue_lock);
+	printf("JACKPOTLTE MALI: done page (0225): job %llu finished, %llu queued\n",
+	    jt_done_seq, jt_queued_seq);
+}
+
+/*
+ * 0225 (P3j step 1): what the user-mode timebase would need.  0112 made
+ * user_timebase_type() USER_TIMEBASE_NONE, so every mach_absolute_time in
+ * every program is a trap (~2 us).  User-mode reads use CNTVCT_EL0, which
+ * agrees with the kernel's CNTPCT_EL0 only when CNTVOFF is the same on all
+ * eight cpus, and EL0 may read it only with CNTKCTL_EL1.EL0VCTEN (bit 1).
+ * Read-only: each cpu's CNTPCT - CNTVCT (= its CNTVOFF), CNTKCTL_EL1 and
+ * CNTFRQ_EL0, once, from the GPU worker before it settles on its own cpu.
+ */
+static void
+jt_timer_probe(void)
+{
+	for (int cpu = 0; cpu < 8; cpu++) {
+		uint64_t p0, v, p1, kctl, frq;
+		int on;
+
+		if (sysctl_thread_bind_cpuid(cpu) != KERN_SUCCESS) {
+			printf("A8 TIMER: cpu %d: cannot bind\n", cpu);
+			continue;
+		}
+		on = cpu_number();
+		__builtin_arm_isb(0xf);
+		p0 = __builtin_arm_rsr64("CNTPCT_EL0");
+		__builtin_arm_isb(0xf);
+		v = __builtin_arm_rsr64("CNTVCT_EL0");
+		__builtin_arm_isb(0xf);
+		p1 = __builtin_arm_rsr64("CNTPCT_EL0");
+		kctl = __builtin_arm_rsr64("CNTKCTL_EL1");
+		frq = __builtin_arm_rsr64("CNTFRQ_EL0");
+		printf("A8 TIMER: cpu %d (on %d): CNTPCT-CNTVCT %lld (read window %llu ticks), "
+		    "CNTVCT %llu, CNTKCTL_EL1 %#llx (EL0VCTEN %llu, EL0PCTEN %llu), CNTFRQ %llu\n",
+		    cpu, on, (long long)((p0 + p1) / 2 - v), p1 - p0, v, kctl,
+		    (kctl >> 1) & 1, kctl & 1, frq);
+	}
+	(void)sysctl_thread_bind_cpuid(-1);
+}
