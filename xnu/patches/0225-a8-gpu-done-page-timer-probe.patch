 		jt_queue_head = (jt_queue_head + 1) % JT_MALI_QUEUE;
 		jt_queue_count--;
 		jt_done_seq = seq;
+		if (jt_done_page != NULL) {
+			__atomic_store_n(&jt_done_page[0], seq, __ATOMIC_RELEASE);     /* 0225 */
+		}
 		lck_mtx_unlock(&jt_queue_lock);
 		wakeup((caddr_t)&jt_done_seq);
 		wakeup((caddr_t)&jt_queue_head);
@@ -1505,6 +1574,9 @@ jackpotlte_mali_enqueue_gated(uint64_t chain, bool fragment, bool gate)
 		jt_full_ns += wns;
 	}
 	seq = ++jt_queued_seq;
+	if (jt_done_page != NULL) {
+		jt_done_page[2] = seq;          /* 0225: a look only */
+	}
 	at = (jt_queue_head + jt_queue_count) % JT_MALI_QUEUE;
