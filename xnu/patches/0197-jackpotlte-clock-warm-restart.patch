@@ -125,6 +125,7 @@ struct a8b_state {
 	uint32_t wdt_row;               /* watchdog resets in a row */
 	uint32_t ntimes;
 	uint32_t times[8];              /* calendar seconds of the last tries */
+	uint32_t clock;                 /* 0197: last calendar second seen */
 	uint32_t check;
 };
 
@@ -328,11 +329,11 @@ a8b_state_load(void)
 	for (int i = 0; i < n; i++) {
 		dst[i] = w[i];
 	}
-	if (a8b_st.magic != STATE_MAGIC || a8b_st.version != 1 ||
+	if (a8b_st.magic != STATE_MAGIC || a8b_st.version != 2 ||
 	    a8b_st.check != a8b_xor(w, n - 1)) {
