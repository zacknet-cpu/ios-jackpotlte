 }
@@ -880,6 +881,41 @@ a8b_promote(void)
 	a8b_state_save();
 }
 
+/* ---- clock across warm restarts (0197) ----
+ * XNU has no RTC driver here (the PMIC RTC sits on the SPEEDY bus), so the
+ * calendar starts in 1970 on every boot until the PC sends "date". The state
+ * page keeps the last calendar second seen (every 30 s); a boot after a warm
+ * restart starts the calendar there plus a minute. A cold start still needs
+ * "date". */
+#define A8B_CLOCK_MIN   1767225600u     /* 2026-01-01 */
+
+static void
+a8b_clock_restore(void)
+{
+	uint32_t now = a8b_now();
+
+	if (now >= A8B_CLOCK_MIN || a8b_st.clock < A8B_CLOCK_MIN) {
+		return;
+	}
+	clock_set_calendar_microtime((clock_sec_t)(a8b_st.clock + 60u), 0);
+	printf("A8 CLOCK: calendar set to %u (last seen before the restart, plus 60 s)\n",
+	    a8b_st.clock + 60u);
+}
+
+static void
+a8b_clock_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		uint32_t now = a8b_now();
+
+		if (now >= A8B_CLOCK_MIN && now != a8b_st.clock) {
+			a8b_st.clock = now;
+			a8b_state_save();
+		}
+		a8b_sleep_ms(30000);
+	}
+}
+
 /* ---- watchdog ---- */
 
 static void
@@ -1067,6 +1103,13 @@ a8b_init(void)
 	}
 	a8b_state_save();
 	a8b_report_panic();
+	a8b_clock_restore();
+	{
+		thread_t th;
+		if (kernel_thread_start(a8b_clock_thread, NULL, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+		}
+	}
 
 	loader_armed = a8b_boot_valid && a8b_boot[3] == WHY_TRY;
 	secs = a8b_boot_valid ? 60u : 0u;
