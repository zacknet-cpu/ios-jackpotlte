 extern "C" void
 sweet_hid_touch(int finger, int down, int x, int y)
 {
+	static int tapwake = -1;
+	static uint32_t waking;
+	static uint64_t lastWake;
+
+	if (tapwake < 0) {
+		int value = 1;
+		(void)PE_parse_boot_argn("a8tapwake", &value, sizeof(value));
+		tapwake = value != 0;
+	}
+	if (finger >= 0 && finger < 32) {
+		uint32_t bit = 1u << finger;
+		if (waking & bit) {
+			if (!down) {
+				waking &= ~bit;
+			}
+			return;
+		}
+		if (down && tapwake && gSweetButtons && sweet_fb_requested_off()) {
+			uint64_t now = mach_absolute_time(), gap;
+			nanoseconds_to_absolutetime(8ULL * NSEC_PER_SEC, &gap);
+			waking |= bit;
+			if (lastWake == 0 || now - lastWake > gap) {
+				lastWake = now;
+				IOLog("SWEET HID: tap at %d,%d with the display off: lock button to wake\n", x, y);
+				gSweetButtons->key(kHIDUsage_Csmr_Power, true);
+				gSweetButtons->key(kHIDUsage_Csmr_Power, false);
+			}
+			return;
+		}
+	}
 	if (gSweetTouch) {
 		gSweetTouch->touch(finger, down != 0, x, y);
 	}
