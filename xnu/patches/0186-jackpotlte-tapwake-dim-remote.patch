+/*
+ * Tap to wake (boot-arg a8tapwake, default 1): while iOS has the display off
+ * (SweetFramebuffer's last RequestPowerChange), a finger that lands is turned
+ * into a press of the lock button, which is how iOS wakes, and the rest of
+ * that touch is kept back. A second wake press within 8 s is not sent (a
+ * press while the display is still coming on would lock it again).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+extern "C" int sweet_fb_requested_off(void);    /* SweetFramebuffer.cpp */
