+static long
+a8s_dec(const char **p, bool *ok)
+{
+	long v = 0;
+	int digits = 0;
+	bool neg = false;
+
+	while (**p == ' ') {
+		(*p)++;
+	}
+	if (**p == '-') {
+		neg = true;
+		(*p)++;
+	}
+	while (**p >= '0' && **p <= '9' && digits < 9) {
+		v = v * 10 + (**p - '0');
+		(*p)++;
+		digits++;
+	}
+	*ok = digits > 0 && (**p == 0 || **p == ' ');
+	return neg ? -v : v;
+}
+
+/*
+ * A finger of our own (index 9) on the touch screen. Coordinates are panel
+ * pixels, 1080x2220; SweetHIDTouch takes the touch driver's 1080x1920 frame
+ * on this board, so y is scaled into it.
+ */
+static void
+a8s_touch(int down, long x, long y)
+{
+	if (x < 0) {
+		x = 0;
+	} else if (x > 1079) {
+		x = 1079;
+	}
+	if (y < 0) {
+		y = 0;
+	} else if (y > 2219) {
+		y = 2219;
+	}
+	sweet_hid_touch(9, down, (int)x, (int)(y * 1920 / 2220));
+}
+
+/*
+ * The panel as text: every SCALE-th pixel of every SCALE-th row, RGB, base64,
+ * 24 pixels (96 characters) a line, between "A8SHOT BEGIN W H" and
+ * "A8SHOT END". At the default 6 that is 180x370, ~270 KB of text.
+ */
+static void
+a8s_shot(unsigned scale)
+{
+	static const char b64[] =
+	    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	const uint8_t *px;
+	uint32_t w, h, rb;
+	char out[8 + 96 + 2];
+
+	if (sweet_fb_snapshot(&px, &w, &h, &rb) != 0) {
+		printf("A8SH: no framebuffer\n");
+		return;
+	}
+	if (scale < 2) {
+		scale = 2;
+	} else if (scale > 16) {
+		scale = 16;
+	}
+	uint32_t ow = w / scale, oh = h / scale, n = 0;
+	printf("A8SHOT BEGIN %u %u\n", ow, oh);
+	memcpy(out, "A8SHOT:", 7);
+	for (uint32_t y = 0; y < oh; y++) {
+		const volatile uint8_t *row = px + (size_t)(y * scale + scale / 2) * rb;
+		for (uint32_t x = 0; x < ow; x++) {
+			const volatile uint8_t *p = row + (size_t)(x * scale + scale / 2) * 4;
+			uint32_t v = ((uint32_t)p[2] << 16) | ((uint32_t)p[1] << 8) | p[0];
+			char *o = out + 7 + (n % 24) * 4;
+			o[0] = b64[(v >> 18) & 63];
+			o[1] = b64[(v >> 12) & 63];
+			o[2] = b64[(v >> 6) & 63];
+			o[3] = b64[v & 63];
+			if (++n % 24 == 0) {
+				out[7 + 96] = 0;
+				printf("%s\n", out);
+			}
+		}
+	}
+	if (n % 24) {
+		out[7 + (n % 24) * 4] = 0;
+		printf("%s\n", out);
+	}
+	printf("A8SHOT END\n");
+}
