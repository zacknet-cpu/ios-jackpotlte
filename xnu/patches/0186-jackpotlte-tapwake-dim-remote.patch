+/*
+ * One line of system state (boot-arg a8stat=N prints it every N seconds; the
+ * USB console's "stat" command prints it on demand): uptime, memory in MiB of
+ * 16 KiB pages, the compressor and swap, the load average, process count and
+ * whether iOS has the display off. What a slow or stuck boot is waiting on.
+ */
+extern unsigned int vm_page_free_count, vm_page_active_count,
+    vm_page_inactive_count, vm_page_wire_count, vm_page_speculative_count;
+extern uint32_t c_segment_pages_compressed;
+extern int vm_num_swap_files;
+extern int nprocs;
+extern int sweet_fb_requested_off(void);
+
+static void
+a8_stat_line(void)
+{
+	uint64_t ns;
+	uint32_t mib = (uint32_t)(PAGE_SIZE / 1024);    /* KiB a page */
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	printf("A8 STAT: up %llu s; MiB free %u active %u inactive %u wired %u spec %u; "
+	    "compressed %u MiB; swap files %d; load %u.%02u %u.%02u %u.%02u; procs %d; display %s\n",
+	    ns / NSEC_PER_SEC,
+	    vm_page_free_count * mib / 1024, vm_page_active_count * mib / 1024,
+	    vm_page_inactive_count * mib / 1024, vm_page_wire_count * mib / 1024,
+	    vm_page_speculative_count * mib / 1024,
+	    (uint32_t)((uint64_t)c_segment_pages_compressed * mib / 1024),
+	    vm_num_swap_files,
+	    (unsigned)(averunnable.ldavg[0] / averunnable.fscale),
+	    (unsigned)((averunnable.ldavg[0] % averunnable.fscale) * 100 / averunnable.fscale),
+	    (unsigned)(averunnable.ldavg[1] / averunnable.fscale),
+	    (unsigned)((averunnable.ldavg[1] % averunnable.fscale) * 100 / averunnable.fscale),
+	    (unsigned)(averunnable.ldavg[2] / averunnable.fscale),
+	    (unsigned)((averunnable.ldavg[2] % averunnable.fscale) * 100 / averunnable.fscale),
+	    nprocs, sweet_fb_requested_off() ? "off (iOS asked)" : "on");
+}
+
+static int a8_stat_chan;
+
+static void
+a8_stat_thread(void *arg, wait_result_t wr __unused)
+{
+	uint32_t secs = (uint32_t)(uintptr_t)arg;
+
+	for (;;) {
+		uint64_t deadline;
+		clock_interval_to_deadline(secs, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&a8_stat_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		a8_stat_line();
+	}
+}
