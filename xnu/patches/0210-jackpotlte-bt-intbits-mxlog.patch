+/* ---- the R4 panic record (0210) -------------------------------------------
+ * fw_panic_record.c of the A8's kernel: version 2 is {version, length in
+ * bytes, ..., checksum}, the checksum being the xor of 0xa5a5a5a5 and every
+ * word before it; word 3 is the panic code (mxman.c:1099) and word 51 the
+ * sympathetic-panic flag.  The record sits in the firmware's runtime area
+ * past the image file, which keeps its contents across a warm reboot, so
+ * the bring-up reports and clears it before the release. */
+static uint32_t
+a5scsc_panic_off(void)
+{
+	uint32_t off;
+
+	if (!a5scsc.mif_mapped || !a5scsc.fw_loaded) {
+		return 0;
+	}
+	off = a5scsc_mif_rd32(A5SCSC_R4_PANIC_HDR_OFF);
+	if (off == 0 || (off & 3) != 0 ||
+	    off > A5SCSC_MIF_DRAM_SIZE - 4 * A5SCSC_R4_PANIC_MAX_WORDS) {
+		return 0;
+	}
+	return off;
+}
