+/* ---- the firmware's own log (0210) ----------------------------------------
+ * mxlog_transport.c and mxlog.c of the A8's kernel: every record is a u32
+ * header {sync u16, level u8, length u8} and its payload, in the stream's
+ * 4-byte packets.  Sync 0xA55A (phase 4): `length` bytes of text.  Sync
+ * 0x9669 (phase 5): `length` words {timestamp, offset of the format string
+ * in the firmware's debug/common/log-strings.bin, arguments}; those are
+ * printed raw and tools/jackpotlte/mxlog5.py turns them into text with that
+ * file.  Levels: 0 error, 1 warning, 2 major, 3 minor, 4 detail.  Records
+ * are printed while the budget lasts (a5scsc_mxlog_more()); errors and
+ * warnings are printed anyway; the rest is counted.
  */
+#define A5SCSC_MXLOG_SYNC4              0xa55au /* mxlog.h SYNC_VALUE_PHASE_4 */
+#define A5SCSC_MXLOG_SYNC5              0x9669u /* mxlog.h SYNC_VALUE_PHASE_5 */
+#define A5SCSC_MXLOG_PRINT_BOOT         200u
+#define A5SCSC_R4_PANIC_HDR_OFF         176u    /* fwhdr.c:29 */
+#define A5SCSC_R4_PANIC_MAX_WORDS       64u     /* version 2 records: 53 words */
+
+static uint32_t
+a5scsc_ring_used(const struct a5scsc_stream *s)
+{
+	uint32_t r = *s->read % s->num_packets;
+	uint32_t w = *s->write % s->num_packets;
+
+	return (w + s->num_packets - r) % s->num_packets;
+}
+
+/* The k-th packet after the read index, as a little-endian word. */
+static uint32_t
+a5scsc_ring_word(const struct a5scsc_stream *s, uint32_t k)
+{
+	uint32_t idx = (*s->read + k) % s->num_packets;
+
+	return *(volatile uint32_t *)(a5scsc.mif + s->buf_off +
+	           idx * s->packet_size);
+}
+
+/* Retires n packets and tells the firmware (mifstream.c:120-130). */
+static void
+a5scsc_ring_drop(struct a5scsc_stream *s, uint32_t n)
+{
+	*s->read = (*s->read + n) % s->num_packets;
+	a5scsc_mb();
+	a5scsc_irq_bit_set(s->read_bit, s->target);
+}
+
+static void
+a5scsc_mxlog_print(const struct a5scsc_stream *s, uint32_t hdr, uint32_t words)
+{
+	uint32_t level = (hdr >> 8) & 0xffu, len = hdr & 0xffu, i;
+	char line[260];
+	int n;
+
+	if (a5scsc.mxlog_budget == 0 && level > 1) {
+		a5scsc.mxlog_quiet++;
+		return;
+	}
+	if (a5scsc.mxlog_budget != 0) {
+		a5scsc.mxlog_budget--;
+	}
+	if ((hdr >> 16) == A5SCSC_MXLOG_SYNC4) {
+		for (i = 0; i < len && i < sizeof(line) - 1; i++) {
+			char c = (char)((a5scsc_ring_word(s, 1 + i / 4) >>
+			    (8 * (i % 4))) & 0xffu);
+
+			if (c == 0) {
+				break;
+			}
+			line[i] = (c >= 0x20 && c < 0x7f) ? c : ' ';
+		}
+		while (i > 0 && line[i - 1] == ' ') {
+			i--;
+		}
+		line[i] = 0;
+		printf("A5XELTE MXLOG4 L%u: %s\n", level, line);
+		return;
+	}
+	n = snprintf(line, sizeof(line), "A5XELTE MXLOG5 L%u", level);
+	for (i = 0; i < words && i < 12 && n > 0 && n < (int)sizeof(line) - 12; i++) {
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %x",
+		    a5scsc_ring_word(s, 1 + i));
+	}
+	printf("%s\n", line);
+}
