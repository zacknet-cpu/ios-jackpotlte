+/*
+ * 0232 (P14, the user's choice of 11-27): a dim lock screen instead of black.
+ * When iOS asks for display off, the panel keeps the last frame CoreAnimation
+ * presented -- SpringBoard draws its dimmed always-on lock screen right
+ * before (dark wallpaper, white clock) -- and the panel brightness drops to
+ * sweet_fb_aod_level (0231's AOR command, the values Samsung's driver
+ * sends; no new panel command). Flips go on as with the display on (CA stops
+ * drawing by itself once it has the display off, and a blocked flip is what
+ * made 0230's frozen frame tear), so the picture is the last one, frozen:
+ * clock and battery stay as they were at lock (iOS's own live always-on
+ * frames need its Metal flipbook). Display on puts the user's level back.
+ * Tap to wake still works (sweet_fb_requested_off). Console "aod 0" goes
+ * back to black, "aod 1" dim again, "aod N" (2-255) dim at level N.
+ */
+static int sweet_fb_aod = 1;                    /* 0: black at display off (0231) */
+static int sweet_fb_aod_level = 24;             /* kern.a8_brightness scale */
+static volatile int sweet_fb_aod_active;
+#if defined(ARM64_BOARD_CONFIG_A5XELTE) && defined(JACKPOTLTE)
+static int sweet_fb_aod_saved = -1;             /* user level before the dim */
+extern "C" uint32_t a8_panel_brightness(unsigned int level);    /* a5xelte_panel.c, 0199 */
+extern "C" int a8_panel_brightness_get(void);
+#define SWEET_FB_AOD_WAKE_DEFAULT 160           /* when no level was set since boot */
+#endif
