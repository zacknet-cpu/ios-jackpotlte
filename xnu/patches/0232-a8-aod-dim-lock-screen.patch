+/* 0232: console "aod": -1 report, 0 off (black), 1 on, 2-255 on at that level */
+extern "C" int
+sweet_fb_aod_set(int value)
+{
+	if (value == 0 || value == 1) {
+		sweet_fb_aod = value;
+	} else if (value >= 2 && value <= 255) {
+		sweet_fb_aod = 1;
+		sweet_fb_aod_level = value;
+	}
+	printf("A8SH: aod %s, level %d%s\n", sweet_fb_aod ? "on (dim lock screen)" : "off (black)",
+	    sweet_fb_aod_level, sweet_fb_aod_active ? ", showing now" : "");
+	return sweet_fb_aod;
+}
