diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index cca737d..3cba751 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5671,11 +5671,69 @@ exec_inject_env(struct image_params *imgp, char *env, size_t size)
 	return any;
 }
 
+#if defined(JACKPOTLTE)
+/*
+ * Daemons that do nothing useful on this phone and cost it the CPU and the
+ * memory the UI needs (the Galaxy S7 port's heronoexec, wardevsa/ios-a5xelte
+ * patch 0253, same list plus two). The A8's own count (serial log of 22 Nov,
+ * a8fast512: "A8 TOP" every 30 s): vmd 160-190 % of a core for minutes on
+ * end ("caught burning CPU"), ReportCrash ~50 %, homed ~46 %, searchd ~41 %,
+ * fairplayd.H2 (no FairPlay here: it crashes, 54 launches in 12 min) ~54 %,
+ * bluetoothd (46 launches, crashing), cloudd, aggregated, analyticsd. Their
+ * exec fails with EPERM; launchd throttles and retries every 10 s or gives up.
+ * boot-arg a8noexec=NAME,NAME replaces the list; a8noexec=- refuses nothing.
+ */
+static TUNABLE_STR(exec_deny_conf, 256, "a8noexec", "");
+static const char exec_deny_default[] =
+    "vmd,searchd,ReportCrash,aggregated,analyticsd,cloudd,homed,driverkitd,fairplayd.H2,bluetoothd";
+
+static bool
+exec_denied(struct image_params *imgp)
+{
+	const char *p = exec_deny_conf[0] != 0 ? exec_deny_conf : exec_deny_default;
+	const char *name;
+	size_t namelen;
+
+	if (p[0] == '-' || imgp->ip_ndp == NULL) {
+		return false;
+	}
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+	if (name == NULL || namelen == 0) {
+		return false;
+	}
+	while (*p != 0) {
+		const char *word = p;
+
+		while (*p != 0 && *p != ',') {
+			p++;
+		}
+		if ((size_t)(p - word) == namelen && strncmp(word, name, namelen) == 0) {
+			static uint32_t said;
+
+			if (said++ < 40) {
+				printf("A8 NOEXEC: %.*s refused (a8noexec)\n", (int)namelen, name);
+			}
+			return true;
+		}
+		while (*p == ',') {
+			p++;
+		}
+	}
+	return false;
+}
+#endif /* JACKPOTLTE */
+
 __attribute__((noinline))
 static int
 exec_extract_strings(struct image_params *imgp)
 {
 	int error = 0;
+#if defined(JACKPOTLTE)
+	if (exec_denied(imgp)) {
+		return EPERM;
+	}
+#endif
 	int     ptr_size = (imgp->ip_flags & IMGPF_WAS_64BIT_ADDR) ? 8 : 4;
 	int new_ptr_size = (imgp->ip_flags & IMGPF_IS_64BIT_ADDR) ? 8 : 4;
 	user_addr_t     argv = imgp->ip_user_argv;
