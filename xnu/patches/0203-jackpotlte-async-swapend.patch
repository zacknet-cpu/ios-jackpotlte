+/* Whether the panel has an update it has not taken yet (0203). */
+static bool
+a8_scan_pending(void)
+{
+	return a8_decon != 0 && *(volatile uint32_t *)(a8_decon + A8_DECON_SHADOW_REQ) != 0;
+}
+
+/* Wait, at most 20 ms, until the panel took the last update; the
+ * microseconds waited. */
+static uint32_t
+a8_scan_settle(void)
+{
+	uint32_t us = 0;
+
+	while (us < 20000 && a8_scan_pending()) {
+		IODelay(50);
+		us += 50;
+	}
+	if (us >= 20000 && a8_flip_late++ < 8) {
+		IOLog("A8 FLIP: the display took no update in 20 ms (flip %llu, async)\n", a8_flips);
+	}
+	return us;
+}
