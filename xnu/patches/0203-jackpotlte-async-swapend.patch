+/*
+ * 0203 sysctls for jackpotlte-gl (backboardd):
+ *   kern.a8_flip_async  1: SwapEnd returns once the panel has its new buffer
+ *                       address, without waiting for the frame that takes it.
+ *   kern.a8_flip_wait   (read) waits, at most 20 ms, until the panel took the
+ *                       last update and answers the microseconds waited.  The
+ *                       shim reads it right before a frame goes to the GPU, so
+ *                       the GPU never draws into the buffer the panel still
+ *                       shows, while the CPU work of the frame ran meanwhile.
+ */
+static int
+a8_flip_async_sysctl(__unused struct sysctl_oid *oidp, __unused void *arg1,
+    __unused int arg2, struct sysctl_req *req)
+{
+	int value = a8_flip_async, error;
+
+	error = SYSCTL_OUT(req, &value, sizeof(value));
+	if (error != 0 || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	error = SYSCTL_IN(req, &value, sizeof(value));
+	if (error != 0) {
+		return error;
+	}
+	if (value != 0 && value != 1) {
+		return EINVAL;
+	}
+	if (a8_flip_async != value) {
+		a8_flip_async = value;
+		IOLog("A8 FLIP: SwapEnd %s\n", value ? "async (kern.a8_flip_async)" : "waits for the panel");
+	}
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, a8_flip_async,
+    CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    NULL, 0, a8_flip_async_sysctl, "I", "SwapEnd does not wait for the panel");
+
+static int
+a8_flip_wait_sysctl(__unused struct sysctl_oid *oidp, __unused void *arg1,
+    __unused int arg2, struct sysctl_req *req)
+{
+	uint32_t us = 0;
+
+	if (req->oldptr != USER_ADDR_NULL) {
+		us = a8_scan_settle();
+	}
+	return SYSCTL_OUT(req, &us, sizeof(us));
+}
+SYSCTL_PROC(_kern, OID_AUTO, a8_flip_wait,
+    CTLTYPE_INT | CTLFLAG_RD | CTLFLAG_LOCKED,
+    NULL, 0, a8_flip_wait_sysctl, "IU", "wait until the panel took its last update");
