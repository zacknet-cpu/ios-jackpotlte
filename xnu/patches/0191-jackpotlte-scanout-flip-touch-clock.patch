+static bool
+a8_flip_on(void)
+{
+	if (a8_flip < 0) {
+		int on = 1;
+		PE_parse_boot_argn("a8flip", &on, sizeof(on));
+		a8_flip = on != 0;
+	}
+	return a8_flip > 0;
