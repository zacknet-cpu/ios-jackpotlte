+
+/* Back to the panel memory; copy the second buffer's picture there first
+ * when asked (display going dim, flipping turned off). */
+static void
+a8_scan_to_panel(AppleCLCD *fb, bool copy)
+{
+	SweetSurface *s = a8_scan_owner;
+
+	if (a8_idma == 0 || a8_shown_addr == (uint32_t)fb->fPhys) {
+		return;
+	}
+	if (copy && s != NULL) {
+		uintptr_t src = s->kernelAddress();
+		for (uint32_t y = 0; src != 0 && y < fb->fHeight; y++) {
+			memcpy((void *)(fb->fPixels + (uint64_t)y * fb->fRowBytes),
+			    (const void *)(src + (uint64_t)y * s->bytesPerRow), (size_t)fb->fWidth * 4);
+		}
+	}
+	a8_scan_show(fb, (uint32_t)fb->fPhys, fb->fRowBytes / 4, false);
+}
+
+extern "C" IOMemoryDescriptor *
+sweet_fb_scanout_claim(SweetSurface *s)
+{
+	AppleCLCD *fb = sweet_fb_main;
+	char name[32];
+
+	if (fb == NULL || !a8_flip_on() || s->width != fb->fWidth || s->height != fb->fHeight ||
+	    s->pixelFormat != SWEET_FB_FORMAT_BGRA || s->bytesPerElement != 4 || s->planeCount != 0 ||
+	    s->offset != 0 || s->bytesPerRow < fb->fWidth * 4 || (s->bytesPerRow & 63) != 0) {
+		return NULL;
+	}
+	proc_selfname(name, sizeof(name));
+	if (strcmp(name, "backboardd") != 0) {
+		return NULL;
+	}
+	uint64_t slot = ((uint64_t)fb->fRowBytes * fb->fHeight + 0xffffull) & ~0xffffull;
+	if (slot + s->allocSize > A8_FB_RESERVED) {
+		return NULL;
+	}
+	if (!OSCompareAndSwapPtr(NULL, s, (void * volatile *)&a8_scan_owner)) {
+		return NULL;
+	}
+	a8_scan_phys = fb->fPhys + slot;
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(a8_scan_phys, s->allocSize,
+	    kIODirectionInOut);
+	if (md == NULL) {
+		a8_scan_owner = NULL;
+		return NULL;
+	}
+	IOLog("A8 FLIP: backboardd's %ux%u render target lives at 0x%llx (%u bytes, %u a row)\n",
+	    s->width, s->height, a8_scan_phys, s->allocSize, s->bytesPerRow);
+	return md;
+}
+
+extern "C" void
+sweet_fb_scanout_release(SweetSurface *s)
+{
+	AppleCLCD *fb = sweet_fb_main;
+
+	if (s == NULL || a8_scan_owner != s) {
+		return;
+	}
+	if (fb != NULL && a8_idma != 0 && a8_shown_addr == (uint32_t)a8_scan_phys) {
+		a8_scan_show(fb, (uint32_t)fb->fPhys, fb->fRowBytes / 4, false);
+	}
+	a8_scan_owner = NULL;
+	IOLog("A8 FLIP: the second buffer is free again (%llu flips)\n", a8_flips);
+}
+
+/* Console "flip 0|1" (bsd/dev/a5xelte_usb.c); -1 only reports. */
+extern "C" int
+sweet_fb_flip_set(int on)
+{
+	AppleCLCD *fb = sweet_fb_main;
+
+	if (on >= 0) {
+		(void)a8_flip_on();
