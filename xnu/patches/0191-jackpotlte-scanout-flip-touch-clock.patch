+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" IOMemoryDescriptor *sweet_fb_scanout_claim(SweetSurface *s);
+extern "C" void sweet_fb_scanout_release(SweetSurface *s);
