+			}
+			a8_flip = on != 0;
+			IOLockUnlock(fb->fPresentLock);
+		}
+	}
+	IOLog("A8 FLIP: %s, %llu flips, %llu late, second buffer %s\n", a8_flip_on() ? "on" : "off",
+	    a8_flips, a8_flip_late, a8_scan_owner != NULL ? "in use" : "free");
+	return a8_flip_on();
+}
