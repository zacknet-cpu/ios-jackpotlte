+#define A8_FB_RESERVED          0x1400000ull    /* reserved-memory framebuffer@0xEC000000 */
+#define A8_IDMA0                0x148b1000ul
+#define A8_IDMA_SRC_SIZE        0x10u
+#define A8_IDMA_ADDR_Y8         0x40u
+#define A8_DECON                0x14860000ul
+#define A8_DECON_SHADOW_REQ     0x60u
+#define A8_DECON_UPDATE         0x80000008u
+
