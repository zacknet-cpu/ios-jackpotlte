+/* Show a buffer: physical address and full width in pixels.  Waits for the
+ * frame that takes it when wait is true. */
+static void
+a8_scan_show(AppleCLCD *fb, uint32_t addr, uint32_t width, bool wait)
+{
+	if (a8_idma == 0) {
+		a8_idma = ml_io_map(A8_IDMA0, 0x1000);
+		a8_decon = ml_io_map(A8_DECON, 0x1000);
+		if (a8_idma == 0 || a8_decon == 0) {
+			a8_flip = 0;
+			return;
+		}
+		a8_shown_addr = *(volatile uint32_t *)(a8_idma + A8_IDMA_ADDR_Y8);
+		a8_shown_width = *(volatile uint32_t *)(a8_idma + A8_IDMA_SRC_SIZE) & 0xffffu;
+	}
+	if (addr == a8_shown_addr && width == a8_shown_width) {
+		return;
+	}
+	*(volatile uint32_t *)(a8_idma + A8_IDMA_SRC_SIZE) = (fb->fHeight << 16) | width;
+	*(volatile uint32_t *)(a8_idma + A8_IDMA_ADDR_Y8) = addr;
+	*(volatile uint32_t *)(a8_decon + A8_DECON_SHADOW_REQ) = A8_DECON_UPDATE;
+	a8_shown_addr = addr;
+	a8_shown_width = width;
+	a8_flips++;
+	if (wait) {
+		int i;
+		for (i = 0; i < 200 && *(volatile uint32_t *)(a8_decon + A8_DECON_SHADOW_REQ) != 0; i++) {
+			IODelay(100);
+		}
+		if (i == 200 && a8_flip_late++ < 8) {
+			IOLog("A8 FLIP: the display took no update in 20 ms (flip %llu)\n", a8_flips);
+		}
+	}
+	if (a8_flips <= 4 || (a8_flips & 1023) == 0) {
+		IOLog("A8 FLIP: %llu: showing 0x%08x, %u pixels a row\n", a8_flips, addr, width);
+	}
