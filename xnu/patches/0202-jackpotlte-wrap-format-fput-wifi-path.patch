+#if defined(ARM64_BOARD_CONFIG_A5XELTE) && defined(JACKPOTLTE)
+/*
+ * 0202: kern.a8_wrap_format.  A wrapped surface says pixel format 0, so the GL
+ * shim (jackpotlte-gl, in backboardd) copies its pixels instead of mapping a
+ * client's pages, but then it could not tell what the bytes are: the apps' SF
+ * Symbols are A,B,G,R, which glca9f had to guess from the premultiplied rule.
+ * Write a surface id, read the format IOSurfaceWrapClientImage was given
+ * (0: the surface is not a wrap; ENOENT: no surface with that id).
+ */
+static int
+sweet_wrap_format_sysctl(__unused struct sysctl_oid *oidp, __unused void *arg1,
+    __unused int arg2, struct sysctl_req *req)
+{
+	uint32_t id = 0, fmt;
+	int error;
+
+	if (req->newptr == USER_ADDR_NULL) {
+		return EINVAL;
+	}
+	error = SYSCTL_IN(req, &id, sizeof(id));
+	if (error != 0) {
+		return error;
+	}
+	SweetSurface *s = sweet_surface_copy(id);
+	if (s == NULL) {
+		return ENOENT;
+	}
+	fmt = s->wrapFormat;
+	s->release();
+	return SYSCTL_OUT(req, &fmt, sizeof(fmt));
+}
+SYSCTL_PROC(_kern, OID_AUTO, a8_wrap_format,
+    CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    NULL, 0, sweet_wrap_format_sysctl, "IU",
+    "IOSurfaceWrapClientImage pixel format of a surface id");
+#endif
+
