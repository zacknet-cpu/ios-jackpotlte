@@ -454,7 +510,7 @@ JackpotlteMaliUserClient::surfaceBuffer(struct jackpotlte_surface * request)
 		return kIOReturnSuccess;
 	}
 	for (uint32_t i = 0; i < MALI_BUFFERS; i++) {
-		if (fBuffers[i].memory != NULL && fBuffers[i].surface == s) {
+		if (fBuffers[i].memory != NULL && fBuffers[i].surface == s && !fBuffers[i].closing) {
