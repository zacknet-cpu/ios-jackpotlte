+	while (fClosing != 0) {                 /* 0226: closes outside the lock finish first */
+		IOLockSleep(gMaliLock, &fClosing, THREAD_UNINT);
+	}
 	for (uint32_t i = 0; fBuffers != NULL && i < MALI_BUFFERS; i++) {
 		if (fBuffers[i].memory != NULL) {
 			freeBuffer(&fBuffers[i]);
@@ -685,7 +744,17 @@ JackpotlteMaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArgu
 		}
 		return ret;
 	}
-	IOLockLock(gMaliLock);
+	{
+		uint64_t w0 = mach_absolute_time(), wns;
+
+		IOLockLock(gMaliLock);
+		absolutetime_to_nanoseconds(mach_absolute_time() - w0, &wns);
+		gMaliLockTakes++;               /* 0226 */
+		gMaliLockWaitNs += wns;
+		if (wns > gMaliLockWaitMaxNs) {
+			gMaliLockWaitMaxNs = wns;
+		}
+	}
 	/* Bring-up aid: this log stopped after 32 requests, and one frame's
 	 * setup is longer than that, so what the client asked for just before
 	 * it died was never printed.  256 covers a whole frame's setup and
@@ -750,10 +819,27 @@ JackpotlteMaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArgu
 		break;
 	case kDrmGemClose:
 		b = buffer(r.close.handle);
-		if (b != NULL) {
-			freeBuffer(b);
-		} else {
+		if (b == NULL) {
 			ret = kIOReturnNotFound;
+		} else if (mali_free_unlocked()) {
+			/* 0226: the slow part without gMaliLock, on a copy of the slot */
+			struct mali_buffer gone = *b;
+			uint64_t t0 = mach_absolute_time(), ns;
+
+			b->closing = true;
+			fClosing++;
+			IOLockUnlock(gMaliLock);
+			releaseBuffer(&gone);
+			IOLockLock(gMaliLock);
+			bzero(b, sizeof(*b));
+			if (--fClosing == 0) {
+				IOLockWakeup(gMaliLock, &fClosing, false);
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+			gMaliFreesUnlocked++;
+			gMaliFreeNs += ns;
+		} else {
+			freeBuffer(b);
 		}
 		break;
 	default:
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 3fd9809..f177aa8 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -464,7 +464,26 @@ user_cont_hwclock_allowed(void)
 uint8_t
 user_timebase_type(void)
 {
-#if defined(A5XELTE)
+#if defined(A5XELTE) && defined(JACKPOTLTE)
+	/*
+	 * 0226 (P3j): the A8 (Exynos 7885).  0225 read CNTPCT - CNTVCT = 0 on
+	 * all eight cpus (the secondary entry zeroes CNTVOFF_EL2, start.s), so
+	 * CNTVCT is the kernel's CNTPCT everywhere and programs may read it
+	 * themselves: mach_absolute_time stops being a trap (~2 us) in every
+	 * process.  This also lets EL0 read the counters
+	 * (_enable_timebase_event_stream, each cpu).  Boot-arg a8utb=0: the
+	 * trap again.
+	 */
+	static int a8_utb = -1;
+
+	if (a8_utb < 0) {
+		int on = 1;
+
+		(void)PE_parse_boot_argn("a8utb", &on, sizeof(on));
+		a8_utb = on != 0;
+	}
+	return a8_utb ? USER_TIMEBASE_SPEC : USER_TIMEBASE_NONE;
+#elif defined(A5XELTE)
 	/* CNTVCT has different firmware offsets across Exynos7580 CPUs. */
 	return USER_TIMEBASE_NONE;
 #elif HAS_ACNTVCT
