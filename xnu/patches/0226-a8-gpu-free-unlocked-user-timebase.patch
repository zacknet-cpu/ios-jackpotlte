 void
-JackpotlteMaliUserClient::freeBuffer(struct mali_buffer * b)
+JackpotlteMaliUserClient::releaseBuffer(struct mali_buffer * b)
 {
 	bool idle = true;
 
@@ -304,6 +353,13 @@ JackpotlteMaliUserClient::freeBuffer(struct mali_buffer * b)
 	if (b->surface != NULL) {
