@@ -186,8 +186,38 @@ struct mali_buffer {
 	uint64_t             address, size;
 	uint64_t             last_seq;          /* the last job given it */
 	bool                 scanout;           /* 0211: pixels in the panel's reserved memory */
+	bool                 closing;           /* 0226: being freed outside gMaliLock; the handle stays taken */
 };
 
+/*
+ * 0226: GEM_CLOSE frees a buffer outside gMaliLock.  freeBuffer() waits for
+ * the buffer's last job, takes its pages out of the GPU's tables (and the
+ * TLB), gives its addresses back and releases its memory; all of that under
+ * gMaliLock held every other request of every client, so libjackpotlte's
+ * closer thread held up the render thread's submits (11-26 CC profile:
+ * submit calls ~50 us each against 3 us of work in submitOne).  Now the slot
+ * is marked closing (buffer() and the surface lookup skip it, newBuffer()
+ * does not reuse it: its memory pointer stays), the lock is dropped for the
+ * slow part (jackpotlte_mali_unmap/_release take jt_mali_lock themselves)
+ * and the slot is cleared under the lock again.  clientClose() waits for
+ * closes in flight.  Boot-arg a8gpufree=0: freed under the lock, as before.
+ */
+static int gMaliFreeUnlocked = -1;
+static uint64_t gMaliFreesUnlocked, gMaliFreeNs;
+static uint64_t gMaliLockTakes, gMaliLockWaitNs, gMaliLockWaitMaxNs;   /* 0226: requests' wait for gMaliLock */
+
+static bool
+mali_free_unlocked(void)
+{
+	if (gMaliFreeUnlocked < 0) {
+		int on = 1;
+
+		PE_parse_boot_argn("a8gpufree", &on, sizeof(on));
+		gMaliFreeUnlocked = on != 0;
+	}
+	return gMaliFreeUnlocked > 0;
+}
+
 static IOLock * gMaliLock;
 
 /* Activity counters, for a fault report to show; nothing reads them yet. */
@@ -206,6 +236,22 @@ jackpotlte_mali_uc_pairs(void)
 	return gMaliPairs;
 }
 
+/* 0226: frees done outside gMaliLock and their time, and how long requests
+ * waited for gMaliLock, for the flip report */
+extern "C" void jackpotlte_mali_uc_frees(uint64_t * frees, uint64_t * ns, uint64_t * takes,
+    uint64_t * wait_ns, uint64_t * wait_max_ns);
+
+void
+jackpotlte_mali_uc_frees(uint64_t * frees, uint64_t * ns, uint64_t * takes, uint64_t * wait_ns,
+    uint64_t * wait_max_ns)
+{
+	*frees = gMaliFreesUnlocked;
+	*ns = gMaliFreeNs;
+	*takes = gMaliLockTakes;
+	*wait_ns = gMaliLockWaitNs;
+	*wait_max_ns = gMaliLockWaitMaxNs;
+}
+
 /* 0213: kernel time of a submit (the "flip" report's second A8 GPU line) */
