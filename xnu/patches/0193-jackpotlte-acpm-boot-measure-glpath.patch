+
+/*
+ * 0193: jtexecinject prefers a USB-updated GL shim under /private/var/root.
+ * Boot-arg a8glpath=0 forces the path from the boot-arg (usually
+ * /usr/local/lib/libjackpotlte-gl.dylib).  The root file must be an arm64
+ * Mach-O dylib; otherwise the boot-arg path is used and a line is logged.
+ */
+#define A8_GL_ROOT_PATH    "/private/var/root/libjackpotlte-gl.dylib"
+#define A8_GL_BASENAME     "libjackpotlte-gl.dylib"
+#define A8_MH_MAGIC_64     0xFEEDFACFu
+#define A8_MH_DYLIB        0x6u
+#define A8_CPU_ARM64       0x0100000Cu
+
+static uint32_t
+a8_gl_path_mode(void)
+{
+	static bool read;
+	static uint32_t mode = 1;
+
+	if (!read) {
+		(void)PE_parse_boot_argn("a8glpath", &mode, sizeof(mode));
+		read = true;
+	}
+	return mode;
+}
+
+static bool
+a8_gl_header_ok(vnode_t vp, vfs_context_t ctx)
+{
+	char hdr[16];
+	uio_t auio;
+	int error;
+	uint32_t magic, cputype, filetype;
+
+	auio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	if (auio == NULL) {
+		return false;
+	}
+	uio_addiov(auio, CAST_USER_ADDR_T(hdr), sizeof(hdr));
+	error = VNOP_READ(vp, auio, 0, ctx);
+	uio_free(auio);
+	if (error) {
+		return false;
+	}
+	magic = (uint32_t)(uint8_t)hdr[0] | ((uint32_t)(uint8_t)hdr[1] << 8) |
+	    ((uint32_t)(uint8_t)hdr[2] << 16) | ((uint32_t)(uint8_t)hdr[3] << 24);
+	cputype = (uint32_t)(uint8_t)hdr[4] | ((uint32_t)(uint8_t)hdr[5] << 8) |
+	    ((uint32_t)(uint8_t)hdr[6] << 16) | ((uint32_t)(uint8_t)hdr[7] << 24);
+	filetype = (uint32_t)(uint8_t)hdr[12] | ((uint32_t)(uint8_t)hdr[13] << 8) |
+	    ((uint32_t)(uint8_t)hdr[14] << 16) | ((uint32_t)(uint8_t)hdr[15] << 24);
+	return magic == A8_MH_MAGIC_64 && cputype == A8_CPU_ARM64 && filetype == A8_MH_DYLIB;
+}
+
+/*
+ * library/liblen is the path from jtexecinject.  If it names the GL shim and
+ * a usable root copy exists, fill out[] with that path and return true.
+ * Otherwise return false (caller keeps the original path).
+ */
+bool
+a8_gl_resolve_inject(const char *library, size_t liblen, char *out, size_t out_size)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx;
+	const char *base;
+	int error;
+
+	if (out == NULL || out_size < sizeof(A8_GL_ROOT_PATH) || library == NULL || liblen == 0) {
+		return false;
+	}
+	if (a8_gl_path_mode() == 0) {
+		return false;
+	}
+	base = library;
+	for (size_t i = 0; i < liblen; i++) {
+		if (library[i] == '/') {
+			base = library + i + 1;
+		}
+	}
+	if ((size_t)(library + liblen - base) != sizeof(A8_GL_BASENAME) - 1 ||
+	    strncmp(base, A8_GL_BASENAME, sizeof(A8_GL_BASENAME) - 1) != 0) {
+		return false;
+	}
+	ctx = vfs_context_kernel();
+	error = vnode_open(A8_GL_ROOT_PATH, FREAD, 0, 0, &vp, ctx);
+	if (error || vp == NULLVP) {
+		return false;
+	}
+	if (!a8_gl_header_ok(vp, ctx)) {
+		printf("A8 GL: %s failed the Mach-O header check; using %.*s\n",
+		    A8_GL_ROOT_PATH, (int)liblen, library);
+		(void)vnode_close(vp, FREAD, ctx);
+		return false;
+	}
+	(void)vnode_close(vp, FREAD, ctx);
+	strlcpy(out, A8_GL_ROOT_PATH, out_size);
+	return true;
+}
