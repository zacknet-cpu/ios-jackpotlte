+static bool
+a8a_parse_boot_rates(const char *cfg)
+{
+	const char *p = cfg;
+	bool any = false;
+
+	for (uint32_t i = 0; i < A8A_DOMAINS; i++) {
+		a8a.boot_want[i] = 0;
+	}
+	while (*p != 0) {
+		char name[16];
+		uint32_t n = 0, khz = 0;
+		int d;
+
+		while (*p == ',' || *p == ' ') {
+			p++;
+		}
+		if (*p == 0) {
+			break;
+		}
+		while (*p != 0 && *p != ':' && n + 1 < sizeof(name)) {
+			name[n++] = *p++;
+		}
+		name[n] = 0;
+		if (*p != ':') {
+			printf("A8 DVFS boot: bad a8dvfsboot near \"%s\" (want NAME:KHZ,...)\n", name);
+			return false;
+		}
+		p++;
+		while (*p >= '0' && *p <= '9') {
+			khz = khz * 10u + (uint32_t)(*p++ - '0');
+			if (khz > 4000000u) {
+				printf("A8 DVFS boot: rate too large in a8dvfsboot\n");
+				return false;
+			}
+		}
+		d = -1;
+		for (uint32_t i = 0; i < A8A_DOMAINS; i++) {
+			if (strcmp(name, a8a_dom_name[i]) == 0) {
+				d = (int)i;
+				break;
+			}
+		}
+		if (d < 0 || a8a_dom_cap[d] == 0) {
+			printf("A8 DVFS boot: \"%s\" is not a domain to set at boot (big, little, g3d)\n",
+			    name);
+			return false;
+		}
+		a8a.boot_want[d] = khz;
+		any = true;
+	}
+	return any;
+}
+
+static uint32_t
+a8a_measure_cpu_khz(int cpu)
+{
+	processor_t target, prev;
+	uint64_t window, t0, t1, c0, c1, ns = 0, pmcr;
+	boolean_t iflag;
+	uint32_t khz;
+
+	if (cpu < 0 || cpu >= (int)real_ncpus) {
+		return 0;
+	}
+	target = cpu_to_processor(cpu);
+	if (target == PROCESSOR_NULL) {
+		return 0;
+	}
+	prev = thread_bind(target);
+	thread_block(THREAD_CONTINUE_NULL);
+	if ((int)cpu_number() != cpu) {
+		printf("A8 DVFS: measure: wanted cpu %d, ran on %d\n", cpu, cpu_number());
+		thread_bind(prev);
+		thread_block(THREAD_CONTINUE_NULL);
+		return 0;
+	}
+	nanoseconds_to_absolutetime((uint64_t)A8A_MEASURE_MS * NSEC_PER_MSEC, &window);
+	pmcr = __builtin_arm_rsr64("PMCR_EL0");
+	__builtin_arm_wsr64("PMCR_EL0", (pmcr | 0x15ull) & ~0x2ull);
+	__builtin_arm_wsr64("PMCNTENSET_EL0", 1ull << 31);
+	__builtin_arm_isb(0xf);
+
+	iflag = ml_set_interrupts_enabled(FALSE);
+	t0 = mach_absolute_time();
+	c0 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	do {
+		t1 = mach_absolute_time();
+	} while (t1 - t0 < window);
+	c1 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	(void)ml_set_interrupts_enabled(iflag);
+
+	thread_bind(prev);
+	thread_block(THREAD_CONTINUE_NULL);
+
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	if (ns == 0 || c1 <= c0) {
+		return 0;
+	}
+	khz = (uint32_t)(((c1 - c0) * 1000ull) / ns);
+	return khz;
+}
+
+static void
+a8a_measure_both(void)
+{
+	a8a.meas_little_khz = a8a_measure_cpu_khz(A8A_CPU_LITTLE);
+	a8a.meas_big_khz = a8a_measure_cpu_khz(A8A_CPU_BIG);
+	printf("A8 DVFS: measure (PMCCNTR %u ms): little cpu%u %u kHz, big cpu%u %u kHz\n",
+	    A8A_MEASURE_MS, A8A_CPU_LITTLE, a8a.meas_little_khz, A8A_CPU_BIG, a8a.meas_big_khz);
+}
