+static void
+a8a_boot_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	int hot = 0, cpu = -1, g3d = -1;
+	int tries;
+
+	bool held = false;
+
+	for (tries = 0; tries < 30; tries++) {
+		lck_mtx_lock(&a8a_lock);
+		held = true;
+		if (!a8a_init()) {
+			lck_mtx_unlock(&a8a_lock);
+			printf("A8 DVFS boot: ACPM init failed\n");
+			return;
 		}
+		if (a8a_fvp_attached()) {
+			break;
+		}
+		if (a8a_fvp_load(A8A_FVP_PATH) == 0 && a8a_fvp_attached()) {
+			break;
+		}
+		lck_mtx_unlock(&a8a_lock);
+		held = false;
+		delay(500000);
 	}
-	a8a_dvfs_report("after the request");
+	if (!held) {
+		lck_mtx_lock(&a8a_lock);
+	}
+	if (!a8a_fvp_attached()) {
+		printf("A8 DVFS boot: FVP plug-in not attached after retries; no rates asked\n");
+		a8a.boot_done = true;
+		lck_mtx_unlock(&a8a_lock);
+		return;
+	}
+	if (!a8t_hottest(&hot, &cpu, &g3d) && a8a.allow < 2) {
+		printf("A8 DVFS boot: TMU did not read (cpu/g3d); refusing to raise clocks\n");
+		a8a.boot_done = true;
+		lck_mtx_unlock(&a8a_lock);
+		return;
+	}
+	printf("A8 DVFS boot: TMU %d C cpu, %d C g3d (limit %u)\n", cpu, g3d, a8a.temp_limit);
+	for (uint32_t d = 0; d < A8A_DOMAINS; d++) {
+		uint32_t want = a8a.boot_want[d];
+
+		if (want == 0) {
+			continue;
+		}
+		lck_mtx_unlock(&a8a_lock);
+		printf("A8 DVFS boot: %s -> %u kHz\n", a8a_dom_name[d], want);
+		lck_mtx_lock(&a8a_lock);
+		a8a_dvfs_set(d, want);
+	}
+	a8a_ensure_watch();
+	a8a.boot_done = true;
+	lck_mtx_unlock(&a8a_lock);
+	a8a_measure_both();
+	lck_mtx_lock(&a8a_lock);
+	a8a_dvfs_report("boot done");
+	lck_mtx_unlock(&a8a_lock);
+}
+
+static void
+a8a_boot_hook(void)
+{
+	thread_t thread;
+
+	if (a8a.boot_started) {
+		return;
+	}
+	a8a.boot_started = true;
+	if (kernel_thread_start(a8a_boot_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("A8 DVFS boot: waiting on the FVP file after root mount\n");
+	} else {
+		printf("A8 DVFS boot: no thread\n");
+	}
+}
+
+static void
+a8a_startup(void)
+{
+	char cfg[128];
+
+	cfg[0] = 0;
+	if (!PE_parse_boot_arg_str("a8dvfsboot", cfg, sizeof(cfg)) || cfg[0] == 0) {
+		return;
+	}
+	a8a.temp_limit = 80;
+	(void)PE_parse_boot_argn("a8dvfs", &a8a.allow, sizeof(a8a.allow));
+	(void)PE_parse_boot_argn("a8dvfstemp", &a8a.temp_limit, sizeof(a8a.temp_limit));
+	if (a8a.allow == 0) {
+		printf("A8 DVFS boot: a8dvfsboot set but a8dvfs is off; ignored\n");
+		return;
+	}
+	if (!a8a_parse_boot_rates(cfg)) {
+		printf("A8 DVFS boot: a8dvfsboot=\"%s\" parsed to nothing\n", cfg);
+		return;
+	}
+	a8a.boot_cfg = true;
+	mountroot_post_hook = a8a_boot_hook;
+	printf("A8 DVFS boot: will ask");
+	for (uint32_t d = 0; d < A8A_DOMAINS; d++) {
+		if (a8a.boot_want[d] != 0) {
+			printf(" %s=%u", a8a_dom_name[d], a8a.boot_want[d]);
+		}
+	}
+	printf(" kHz after root mounts\n");
 }
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, a8a_startup);
 
