+/* ---- a8dvfsboot parse and PMCCNTR measure (0193) ---- */
+#define A8A_FVP_PATH            "/private/var/root/a8-acpm-fvp.fw"
+#define A8A_CPU_LITTLE          0               /* A53 */
+#define A8A_CPU_BIG             6               /* A73; logical CPUs 6-7 */
+#define A8A_MEASURE_MS          10u
