+/* SPI: a 4-byte pattern; one repeated byte goes to the library's fill, anything else is written
+ * by the processor once the GPU work recorded before it has finished (in order, like the rest) */
+- (void)fillBuffer:(id)buffer range:(NSRange)range pattern4:(uint32_t)pattern
+{
+	if ((pattern & 0xffu) * 0x01010101u == pattern) {
+		[self fillBuffer:buffer range:range value:(uint8_t)pattern];
+		return;
+	}
+	[self record:^BOOL(char *why, size_t n) {
+		uint8_t *p = (uint8_t *)[buffer contents];
+
+		if (p == NULL) {
+			snprintf(why, n, "fillBuffer:range:pattern4: on a buffer with no processor address");
+			return NO;
+		}
+		if (mesa.finish != NULL && mesa.finish([[_commandBuffer device] mesaDevice], why, n) != 0) {
+			return NO;
+		}
+		for (NSUInteger i = 0; i < range.length; i++) {
+			p[range.location + i] = (uint8_t)(pattern >> (8 * (i & 3)));
+		}
+		return YES;
+	} note:"fill pattern4"];
+}
+/* SPI: the option bits (e.g. a format reinterpretation) are not ours to honour; the copy is */
+- (void)copyFromTexture:(id)source sourceSlice:(NSUInteger)sourceSlice
+	    sourceLevel:(NSUInteger)sourceLevel sourceOrigin:(MTLOrigin)sourceOrigin
+	     sourceSize:(MTLSize)sourceSize toTexture:(id)destination
+       destinationSlice:(NSUInteger)destinationSlice destinationLevel:(NSUInteger)destinationLevel
+      destinationOrigin:(MTLOrigin)destinationOrigin options:(NSUInteger)options
+{
+	if (options != 0) {
+		RW_ONCE('W', "ENC", "blit: copyFromTexture options %#lx ignored\n", (unsigned long)options);
+	}
+	[self copyFromTexture:source sourceSlice:sourceSlice sourceLevel:sourceLevel
+		 sourceOrigin:sourceOrigin sourceSize:sourceSize toTexture:destination
+	     destinationSlice:destinationSlice destinationLevel:destinationLevel
+	    destinationOrigin:destinationOrigin];
+}
+/* SPI fills of a texture region: one pixel's bytes repeated over the region, written through
+ * the library in order with the rest of the command buffer */
+- (void)fillTexture:(id)texture level:(NSUInteger)level slice:(NSUInteger)slice
+	     region:(MTLRegion)region bytes:(const void *)bytes length:(NSUInteger)length
+{
+	size_t row, total;
+	uint8_t *fill;
+
+	if (mesa.texture_write == NULL || bytes == NULL || length == 0 || length > 16 ||
+	    region.size.width == 0 || region.size.height == 0) {
+		RW_ONCE('W', "ENC", "blit: fillTexture with a %lu-byte pixel refused\n", (unsigned long)length);
+		return;
+	}
+	row = region.size.width * length;
+	total = row * region.size.height * MAX(region.size.depth, (NSUInteger)1);
+	fill = malloc(total);
+	if (fill == NULL) {
+		return;
+	}
+	for (size_t at = 0; at < total; at += length) {
+		memcpy(fill + at, bytes, length);
+	}
+	[self record:^BOOL(char *why, size_t n) {
+		const unsigned origin[3] = { (unsigned)region.origin.x, (unsigned)region.origin.y,
+					     (unsigned)region.origin.z };
+		const unsigned size[3] = { (unsigned)region.size.width, (unsigned)region.size.height,
+					   (unsigned)MAX(region.size.depth, (NSUInteger)1) };
+		BOOL ok = mesa.texture_write([texture mesaTexture], (unsigned)level, (unsigned)slice, origin,
+		    size, fill, row, why, n) == 0;
+
+		free(fill);
+		return ok;
+	} note:"fill texture"];
+}
+/* the colour fills: the pixel made from the colour for the formats Apple's GL-on-Metal and
+ * CoreImage clear with; others are refused by name */
+- (void)fillTexture:(id)texture level:(NSUInteger)level slice:(NSUInteger)slice
+	     region:(MTLRegion)region color:(MTLClearColor)color pixelFormat:(MTLPixelFormat)format
+{
+	uint8_t px[16];
+	NSUInteger len = 0;
+	double c[4] = { color.red, color.green, color.blue, color.alpha };
+#define RW_UN8(v) ((uint8_t)lround(fmin(fmax((v), 0.0), 1.0) * 255.0))
+
+	switch (format) {
+	case MTLPixelFormatR8Unorm:
+		px[0] = RW_UN8(c[0]); len = 1; break;
+	case MTLPixelFormatRG8Unorm:
+		px[0] = RW_UN8(c[0]); px[1] = RW_UN8(c[1]); len = 2; break;
+	case MTLPixelFormatRGBA8Unorm:
+	case MTLPixelFormatRGBA8Unorm_sRGB:
+		for (int i = 0; i < 4; i++) px[i] = RW_UN8(c[i]);
+		len = 4; break;
+	case MTLPixelFormatBGRA8Unorm:
+	case MTLPixelFormatBGRA8Unorm_sRGB:
+		px[0] = RW_UN8(c[2]); px[1] = RW_UN8(c[1]); px[2] = RW_UN8(c[0]); px[3] = RW_UN8(c[3]);
+		len = 4; break;
+	case MTLPixelFormatR32Float: {
+		float f = (float)c[0]; memcpy(px, &f, 4); len = 4; break;
+	}
+	case MTLPixelFormatRGBA32Float:
+		for (int i = 0; i < 4; i++) { float f = (float)c[i]; memcpy(px + 4 * i, &f, 4); }
+		len = 16; break;
+	case MTLPixelFormatRGBA16Float:
+		for (int i = 0; i < 4; i++) { __fp16 h = (__fp16)c[i]; memcpy(px + 2 * i, &h, 2); }
+		len = 8; break;
+	default:
+		RW_ONCE('W', "ENC", "blit: fillTexture with a colour into pixel format %lu refused\n",
+		    (unsigned long)format);
+		return;
+	}
+#undef RW_UN8
+	[self fillTexture:texture level:level slice:slice region:region bytes:px length:len];
+}
+- (void)fillTexture:(id)texture level:(NSUInteger)level slice:(NSUInteger)slice
+	     region:(MTLRegion)region color:(MTLClearColor)color
+{
+	[self fillTexture:texture level:level slice:slice region:region color:color
+	      pixelFormat:[texture pixelFormat]];
+}
